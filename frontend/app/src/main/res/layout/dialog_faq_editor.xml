<?xml version="1.0" encoding="utf-8"?>
<!-- Editor cho nội dung hướng dẫn (FR-A09). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/ds_space_8">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutFaqTitle"
            style="@style/Widget.EventApp.Ds.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hc_cat_faq_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFaqTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLength="100"
                android:maxLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutFaqContent"
            style="@style/Widget.EventApp.Ds.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:hint="@string/hc_cat_faq_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFaqContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLength="2000"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hc_cat_faq_visible"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchFaqVisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFaqFormError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
            android:textColor="@color/ds_danger"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
