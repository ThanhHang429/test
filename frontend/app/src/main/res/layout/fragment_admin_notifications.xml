<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/admin_gutter"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/admin_gutter">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.14"
                android:text="@string/admin_noti_kicker"
                android:textColor="@color/admin_accent_dark"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_noti_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.Display" />

                <TextView
                    android:id="@+id/btnNotiReadAll"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_admin_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/admin_noti_read_all"
                    android:textColor="@color/admin_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/admin_noti_sub"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.Body" />

            <TextView
                android:id="@+id/tvNotiUnread"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/admin_accent_dark"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingStart="@dimen/admin_gutter"
            android:paddingEnd="@dimen/admin_gutter"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipNotiAll"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_noti_filter_all" />

                <TextView
                    android:id="@+id/chipNotiMod"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_noti_filter_mod" />

                <TextView
                    android:id="@+id/chipNotiFin"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_noti_filter_fin" />

                <TextView
                    android:id="@+id/chipNotiSys"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_noti_filter_sys" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/listNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvNotiEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:text="@string/admin_noti_empty"
            android:textColor="@color/admin_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
