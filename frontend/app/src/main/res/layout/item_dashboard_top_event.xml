<?xml version="1.0" encoding="utf-8"?>
<!-- Top sự kiện O03: hạng, tên, doanh thu đã xác minh, số đăng ký, thanh tỷ trọng. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="@dimen/ds_space_8"
    android:paddingBottom="@dimen/ds_space_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDashTopRank"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.LabelSmall"
            android:textColor="@color/ds_primary"
            tools:text="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDashTopTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                tools:text="Đêm nhạc Indie Sài Gòn 2026" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.eventapp.app.ui.common.view.PriceTextView
                    android:id="@+id/tvDashTopRevenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    tools:text="72.000.000 đ" />

                <TextView
                    android:id="@+id/tvDashTopRegistrations"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_8"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    tools:text="412 đăng ký" />
            </LinearLayout>
        </LinearLayout>

        <com.eventapp.app.ui.common.view.StatusChip
            android:id="@+id/chipDashTopLifecycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            tools:text="Đang mở bán" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressDashTop"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="@dimen/ds_space_8"
        android:max="100"
        app:indicatorColor="@color/ds_primary"
        app:trackColor="@color/ds_outline"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />
</LinearLayout>
