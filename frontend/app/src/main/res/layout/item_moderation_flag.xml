<?xml version="1.0" encoding="utf-8"?>
<!-- FR-A07: một cờ nội dung trong hàng đợi kiểm duyệt. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.EventApp.Ds.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivFlagIcon"
                android:layout_width="@dimen/ds_icon_40"
                android:layout_height="@dimen/ds_icon_40"
                android:background="@drawable/bg_ds_avatar"
                android:contentDescription="@null"
                android:padding="@dimen/ds_space_8"
                android:src="@drawable/ic_ds_flag"
                app:tint="@color/ds_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFlagTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    tools:text="Đêm nhạc Indie Sài Gòn 2026" />

                <TextView
                    android:id="@+id/tvFlagMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    tools:text="Sự kiện • 12 phút trước" />
            </LinearLayout>

            <com.eventapp.app.ui.common.view.StatusChip
                android:id="@+id/chipFlagSeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_8"
                tools:text="Cao" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.eventapp.app.ui.common.view.StatusChip
                android:id="@+id/chipFlagSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="AI" />

            <TextView
                android:id="@+id/tvFlagConfidence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_8"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                tools:text="Độ tin cậy 96%" />

            <com.eventapp.app.ui.common.view.StatusChip
                android:id="@+id/chipFlagStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="Đã xác nhận"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFlagNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_6"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.eventapp.app.ui.common.view.StatusChip
                android:id="@+id/chipFlagUnchecked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hc_mod_unchecked" />

            <com.eventapp.app.ui.common.view.StatusChip
                android:id="@+id/chipFlagChanged"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_6"
                android:text="@string/hc_mod_changed" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFlagEvidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:background="@drawable/bg_ds_error_soft"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_12"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvFlagReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                tools:text="Nội dung chứa số điện thoại và dấu hiệu mua bán vé ngoài hệ thống." />

            <TextView
                android:id="@+id/tvFlagEvidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:fontFamily="monospace"
                android:textColor="@color/ds_danger_dark"
                android:textSize="12sp"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="Bằng chứng: “liên hệ Zalo 0909 123 456”"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFlagActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlagRescan"
                style="@style/Widget.EventApp.Ds.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingEnd="@dimen/ds_space_8"
                android:text="@string/hc_mod_rescan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlagDismiss"
                style="@style/Widget.EventApp.Ds.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_8"
                android:minWidth="0dp"
                android:paddingStart="@dimen/ds_space_12"
                android:paddingEnd="@dimen/ds_space_12"
                android:text="@string/hc_mod_dismiss" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlagConfirm"
                style="@style/Widget.EventApp.Ds.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_8"
                app:backgroundTint="@color/ds_admin_risk"
                android:minWidth="0dp"
                android:paddingStart="@dimen/ds_space_12"
                android:paddingEnd="@dimen/ds_space_12"
                android:text="@string/hc_mod_confirm" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
