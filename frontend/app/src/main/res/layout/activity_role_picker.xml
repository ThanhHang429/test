<?xml version="1.0" encoding="utf-8"?>
<!-- Chọn khu vực kiểm thử thay cho đăng nhập, chỉ dùng ở bản debug. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rolePickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_32"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_32">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/ds_icon_40"
                    android:layout_height="@dimen/ds_icon_40"
                    android:background="@drawable/bg_ds_brand_tile"
                    android:contentDescription="@null"
                    android:padding="@dimen/ds_space_8"
                    android:src="@drawable/ic_ds_event"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_12"
                    android:letterSpacing="0.06"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H1" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_24"
                android:text="@string/hc_mode_title"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:text="@string/hc_mode_subtitle"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModeUser"
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_24"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_16">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_avatar">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_24"
                            android:layout_height="@dimen/ds_icon_24"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_users"
                            app:tint="@color/ds_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_mode_user"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_mode_user_desc"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_chevron_right"
                        app:tint="@color/ds_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModeOrganizer"
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_16">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_avatar">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_24"
                            android:layout_height="@dimen/ds_icon_24"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_event"
                            app:tint="@color/ds_organizer" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_mode_organizer"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_mode_organizer_desc"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_chevron_right"
                        app:tint="@color/ds_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModeAdmin"
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="76dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_16">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_avatar">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_24"
                            android:layout_height="@dimen/ds_icon_24"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_lock"
                            app:tint="@color/ds_admin_risk" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_mode_admin"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_mode_admin_desc"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_chevron_right"
                        app:tint="@color/ds_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_24"
                android:gravity="center"
                android:text="@string/hc_mode_footer"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
