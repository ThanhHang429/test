<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_top_bar_height"
            android:background="@color/ds_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_space_12">

            <ImageButton
                android:id="@+id/btnReviewsBack"
                android:layout_width="@dimen/ds_touch_target"
                android:layout_height="@dimen/ds_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/hc_reviews_back"
                android:padding="@dimen/ds_space_12"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ds_back"
                app:tint="@color/ds_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_4"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReviewsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_reviews_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                <TextView
                    android:id="@+id/tvReviewsSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_reviews_write_note"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewsWriteTop"
                style="@style/Widget.EventApp.Ds.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/hc_reviews_write" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshReviews"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollReviews"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_content_margin">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.EventApp.Ds.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/ds_space_16">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:minWidth="98dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvReviewsAverage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/ds_text"
                                    android:textSize="44sp"
                                    android:textStyle="bold"
                                    tools:text="4.6" />

                                <com.eventapp.app.ui.common.view.StarRatingView
                                    android:id="@+id/ratingReviewsSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    android:id="@+id/tvReviewsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_4"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                    tools:text="128 đánh giá" />
                            </LinearLayout>

                            <com.eventapp.app.ui.common.view.RatingDistributionView
                                android:id="@+id/ratingReviewsDistribution"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_16"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvReviewsMineNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:text="@string/hc_reviews_my_status"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupReviewsSort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true"
                            app:chipSpacingHorizontal="@dimen/ds_space_8">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipReviewsNewest"
                                style="@style/Widget.EventApp.Ds.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:checked="true"
                                android:text="@string/hc_reviews_sort_newest" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipReviewsHigh"
                                style="@style/Widget.EventApp.Ds.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/hc_reviews_sort_rating_high" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipReviewsLow"
                                style="@style/Widget.EventApp.Ds.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/hc_reviews_sort_rating_low" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvReviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReviewsLoadMore"
                        style="@style/Widget.EventApp.Ds.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:text="@string/hc_reviews_load_more"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReviewsWrite"
                        style="@style/Widget.EventApp.Ds.Button.Cta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:text="@string/hc_reviews_write_cta" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:gravity="center"
                        android:text="@string/hc_reviews_write_note"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.eventapp.app.ui.common.view.SkeletonLayout
        android:id="@+id/skeletonReviews"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ds_top_bar_height"
        android:layout_margin="@dimen/ds_content_margin" />

    <com.eventapp.app.ui.common.view.EmptyStateView
        android:id="@+id/emptyReviews"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ds_top_bar_height"
        android:background="@color/ds_bg"
        android:visibility="gone" />

    <com.eventapp.app.ui.common.view.ErrorStateView
        android:id="@+id/errorReviews"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ds_top_bar_height"
        android:background="@color/ds_bg"
        android:visibility="gone" />
</FrameLayout>
