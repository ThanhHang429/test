<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/user_gutter"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/user_gutter">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/user_text_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/user_discovery_headline"
                android:textAppearance="@style/TextAppearance.EventApp.User.Display" />

            <TextView
                android:id="@+id/tvSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.EventApp.User.Sub" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/user_gutter"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="@dimen/user_gutter"
            android:background="@drawable/bg_user_search"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineProvider="background"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_search"
                android:tint="@color/user_text_dim" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSearch"
                style="@style/Widget.EventApp.User.Search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/user_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btnFilter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_user_btn_primary"
                android:contentDescription="@string/user_cd_filter"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_user_tune"
                android:tint="@color/white" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/user_gutter"
                android:paddingEnd="@dimen/user_gutter">

                <TextView
                    android:id="@+id/chipAll"
                    style="@style/Widget.EventApp.User.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/user_cat_all" />

                <TextView
                    android:id="@+id/chipMusic"
                    style="@style/Widget.EventApp.User.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/user_cat_music" />

                <TextView
                    android:id="@+id/chipTech"
                    style="@style/Widget.EventApp.User.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/user_cat_tech" />

                <TextView
                    android:id="@+id/chipBusiness"
                    style="@style/Widget.EventApp.User.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/user_cat_business" />

                <TextView
                    android:id="@+id/chipArt"
                    style="@style/Widget.EventApp.User.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/user_cat_art" />

                <TextView
                    android:id="@+id/chipFree"
                    style="@style/Widget.EventApp.User.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/user_cat_free" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/featuredSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/user_gutter"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/user_gutter"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/user_section_featured"
                        android:textAppearance="@style/TextAppearance.EventApp.User.Headline"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/user_section_featured_sub"
                        android:textAppearance="@style/TextAppearance.EventApp.User.Caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSeeAllFeatured"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="2dp"
                    android:text="@string/user_see_all"
                    android:textColor="@color/user_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeatured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/user_gutter"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/upcomingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/user_gutter"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="@dimen/user_gutter"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/user_section_upcoming"
                        android:textAppearance="@style/TextAppearance.EventApp.User.Headline"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvResultCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.EventApp.User.Caption" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/user_gutter"
                android:paddingEnd="@dimen/user_gutter" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/user_gutter"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/user_gutter"
            android:background="@drawable/bg_user_card_20"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_user_icon_soft_circle">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_user_search"
                    android:tint="@color/user_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/user_search_empty_title"
                android:textAppearance="@style/TextAppearance.EventApp.User.CardTitle"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/user_search_empty_body"
                android:textAppearance="@style/TextAppearance.EventApp.User.Caption" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_user_btn_secondary"
                android:fontFamily="@font/plus_jakarta_sans"
                android:minHeight="40dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:text="@string/user_reset_filter"
                android:textAllCaps="false"
                android:textColor="@color/user_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/user_session_secure"
            android:textAppearance="@style/TextAppearance.EventApp.User.Micro" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
