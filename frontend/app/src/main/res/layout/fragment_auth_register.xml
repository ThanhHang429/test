<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_24"
        android:paddingTop="@dimen/ds_space_12"
        android:paddingEnd="@dimen/ds_space_24"
        android:paddingBottom="@dimen/ds_space_32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_touch_target"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRegisterBack"
                android:layout_width="@dimen/ds_touch_target"
                android:layout_height="@dimen/ds_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_cd_back"
                android:padding="@dimen/ds_space_12"
                android:src="@drawable/ic_ds_back"
                app:tint="@color/ds_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_4"
                android:text="@string/auth_register_topbar"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_20"
            android:text="@string/auth_register_title"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_6"
            android:text="@string/auth_register_subtitle"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
            android:textColor="@color/ds_text_muted" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EventApp.Ds.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_20"
            app:cardCornerRadius="@dimen/ds_radius_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_16">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRegisterName"
                    style="@style/Widget.EventApp.Ds.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_full_name"
                    app:startIconDrawable="@drawable/ic_ds_person"
                    app:startIconTint="@color/ds_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRegisterName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textColor="@color/ds_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRegisterEmail"
                    style="@style/Widget.EventApp.Ds.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:hint="@string/auth_email"
                    app:startIconDrawable="@drawable/ic_ds_mail"
                    app:startIconTint="@color/ds_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRegisterEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/ds_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRegisterPhone"
                    style="@style/Widget.EventApp.Ds.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:hint="@string/auth_phone"
                    app:startIconDrawable="@drawable/ic_ds_phone"
                    app:startIconTint="@color/ds_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRegisterPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="phone"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:textColor="@color/ds_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRegisterPassword"
                    style="@style/Widget.EventApp.Ds.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:hint="@string/auth_password"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/auth_password_hint"
                    app:startIconDrawable="@drawable/ic_ds_lock"
                    app:startIconTint="@color/ds_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRegisterPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/ds_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutRegisterConfirm"
                    style="@style/Widget.EventApp.Ds.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:hint="@string/auth_confirm_password"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_ds_lock"
                    app:startIconTint="@color/ds_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRegisterConfirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/ds_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/checkRegisterTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:buttonTint="@color/ds_primary"
                    android:paddingTop="@dimen/ds_space_4"
                    android:paddingBottom="@dimen/ds_space_4"
                    android:text="@string/auth_terms"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                    android:textColor="@color/ds_text_muted" />

                <TextView
                    android:id="@+id/tvRegisterTermsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_error_terms"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_danger"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegisterSubmit"
                    style="@style/Widget.EventApp.Ds.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:text="@string/auth_register_submit" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_20"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_have_account"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                android:textColor="@color/ds_text_muted" />

            <TextView
                android:id="@+id/btnLoginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_4"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/ds_space_4"
                android:text="@string/auth_login_link"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                android:textColor="@color/ds_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_16"
            android:gravity="center"
            android:text="@string/auth_demo_banner"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
