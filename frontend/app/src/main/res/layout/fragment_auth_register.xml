<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/auth_screen_pad"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/auth_screen_pad"
        android:paddingBottom="24dp">

        <include
            android:id="@+id/topBar"
            layout="@layout/view_auth_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_top_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/stepBar1"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_step_active" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <View
                android:id="@+id/stepBar2"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_step_inactive" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auth_register_title"
            android:textAppearance="@style/TextAppearance.EventApp.Auth.Title" />

        <TextView
            android:id="@+id/tvStepSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_step_personal"
            android:textAppearance="@style/TextAppearance.EventApp.Auth.Subtitle" />

        <!-- Bước 1: thông tin cá nhân -->
        <LinearLayout
            android:id="@+id/groupStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_input_height">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etName"
                    style="@style/Widget.EventApp.Auth.Input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="name"
                    android:hint="@string/auth_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />

                <ImageView
                    android:layout_width="@dimen/auth_icon_sm"
                    android:layout_height="@dimen/auth_icon_sm"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_auth_person"
                    android:tint="@color/auth_text_dim" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/auth_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_input_height"
                android:layout_marginTop="12dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etEmail"
                    style="@style/Widget.EventApp.Auth.Input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="emailAddress"
                    android:hint="@string/auth_email_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

                <ImageView
                    android:layout_width="@dimen/auth_icon_sm"
                    android:layout_height="@dimen/auth_icon_sm"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_auth_mail"
                    android:tint="@color/auth_text_dim" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/auth_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_input_height"
                android:layout_marginTop="12dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etPhone"
                    style="@style/Widget.EventApp.Auth.Input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="phone"
                    android:hint="@string/auth_phone_hint"
                    android:imeOptions="actionDone"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:maxLines="1" />

                <ImageView
                    android:layout_width="@dimen/auth_icon_sm"
                    android:layout_height="@dimen/auth_icon_sm"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_auth_phone"
                    android:tint="@color/auth_text_dim" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPhoneError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/auth_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNext"
                style="@style/Widget.EventApp.Auth.Cta"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_cta_height"
                android:layout_marginTop="24dp"
                android:drawableEnd="@drawable/ic_auth_arrow_right"
                android:drawablePadding="10dp"
                android:drawableTint="@color/white"
                android:text="@string/auth_continue" />
        </LinearLayout>

        <!-- Bước 2: bảo mật -->
        <LinearLayout
            android:id="@+id/groupStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_input_height">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etPassword"
                    style="@style/Widget.EventApp.Auth.Input.Password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="newPassword"
                    android:hint="@string/auth_password_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <ImageView
                    android:layout_width="@dimen/auth_icon_sm"
                    android:layout_height="@dimen/auth_icon_sm"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_auth_lock"
                    android:tint="@color/auth_text_dim" />

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_cd_toggle_password"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_auth_eye"
                    android:tint="@color/auth_text_dim" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/strength1"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_auth_step_inactive" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <View
                    android:id="@+id/strength2"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_auth_step_inactive" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <View
                    android:id="@+id/strength3"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_auth_step_inactive" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/auth_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_input_height"
                android:layout_marginTop="12dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etConfirm"
                    style="@style/Widget.EventApp.Auth.Input.Password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="newPassword"
                    android:hint="@string/auth_confirm_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <ImageView
                    android:layout_width="@dimen/auth_icon_sm"
                    android:layout_height="@dimen/auth_icon_sm"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_auth_lock"
                    android:tint="@color/auth_text_dim" />

                <ImageButton
                    android:id="@+id/btnToggleConfirm"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_cd_toggle_password"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_auth_eye"
                    android:tint="@color/auth_text_dim" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvConfirmError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/auth_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:minWidth="0dp"
                android:minHeight="@dimen/auth_touch"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/auth_terms"
                android:textColor="@color/auth_text_muted"
                android:textSize="12sp"
                app:buttonTint="@color/auth_checkbox_tint" />

            <TextView
                android:id="@+id/tvTermsError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/auth_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCreate"
                style="@style/Widget.EventApp.Auth.Cta"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_cta_height"
                android:layout_marginTop="20dp"
                android:drawableEnd="@drawable/ic_auth_arrow_right"
                android:drawablePadding="10dp"
                android:drawableTint="@color/white"
                android:text="@string/auth_register_action" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_have_account"
                android:textAppearance="@style/TextAppearance.EventApp.Auth.Caption"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:text="@string/auth_login_link"
                android:textAppearance="@style/TextAppearance.EventApp.Auth.Link" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
