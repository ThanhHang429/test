<?xml version="1.0" encoding="utf-8"?>
<!-- FR-A14: chi tiết đánh giá bị báo cáo, mở bằng bottom sheet. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ds_surface"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/ds_space_24">

        <View
            android:layout_width="@dimen/ds_sheet_handle_width"
            android:layout_height="@dimen/ds_sheet_handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ds_space_8"
            android:background="@drawable/bg_ds_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_12"
            android:paddingEnd="@dimen/ds_space_8">

            <TextView
                android:id="@+id/tvA14Avatar"
                android:layout_width="@dimen/ds_avatar_md"
                android:layout_height="@dimen/ds_avatar_md"
                android:background="@drawable/bg_ds_avatar"
                android:gravity="center"
                android:textColor="@color/ds_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="TP" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvA14Author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                    tools:text="Tấn Phát" />

                <TextView
                    android:id="@+id/tvA14AuthorCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    tools:text="Mã tài khoản: USR-4821" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnA14Close"
                android:layout_width="@dimen/ds_touch_target"
                android:layout_height="@dimen/ds_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/hc_close"
                android:padding="@dimen/ds_space_12"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ds_close"
                app:tint="@color/ds_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_content_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.eventapp.app.ui.common.view.StatusChip
                    android:id="@+id/chipA14Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Chờ kiểm duyệt" />

                <com.eventapp.app.ui.common.view.StatusChip
                    android:id="@+id/chipA14Source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_4"
                    tools:text="REPORTED" />

                <com.eventapp.app.ui.common.view.StatusChip
                    android:id="@+id/chipA14Severity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_4"
                    tools:text="Cao" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvA14Event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                android:textColor="@color/ds_primary"
                tools:text="Đêm nhạc Indie Sài Gòn 2026" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.eventapp.app.ui.common.view.StarRatingView
                    android:id="@+id/ratingA14Stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvA14Date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_8"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    tools:text="30/10/2026 09:20" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16"
                android:text="@string/hc_mod_a14_content"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_6"
                android:background="@drawable/bg_ds_card_soft"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_12">

                <TextView
                    android:id="@+id/tvA14Content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                    tools:text="Bán vé lại giá rẻ, liên hệ Zalo 0909 123 456 để nhận mã." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutA14Flag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:background="@drawable/bg_ds_error_soft"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_12"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvA14FlagTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textColor="@color/ds_danger_dark"
                    tools:text="Cờ kiểm duyệt • Mức HIGH" />

                <TextView
                    android:id="@+id/tvA14FlagReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                    tools:text="Nội dung chứa số điện thoại và dấu hiệu mua bán vé ngoài hệ thống." />

                <TextView
                    android:id="@+id/tvA14Evidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:fontFamily="monospace"
                    android:textColor="@color/ds_text_muted"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:visibility="gone"
                    tools:text="Bằng chứng: “liên hệ Zalo 0909 123 456”"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvA14Scores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:visibility="gone"
                    tools:text="Spam 92% • Toxicity 12%"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnA14RequestEdit"
                    style="@style/Widget.EventApp.Ds.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/ds_space_12"
                    android:paddingEnd="@dimen/ds_space_12"
                    android:text="@string/hc_mod_a14_request_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnA14Keep"
                    style="@style/Widget.EventApp.Ds.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_8"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/ds_space_12"
                    android:paddingEnd="@dimen/ds_space_12"
                    android:text="@string/hc_mod_a14_keep" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnA14Hide"
                    style="@style/Widget.EventApp.Ds.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_8"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/ds_space_12"
                    android:paddingEnd="@dimen/ds_space_12"
                    android:text="@string/hc_mod_a14_hide"
                    app:backgroundTint="@color/ds_admin_risk" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
