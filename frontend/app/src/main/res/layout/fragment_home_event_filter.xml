<?xml version="1.0" encoding="utf-8"?>
<!-- Bộ lọc sự kiện dạng bottom sheet toàn màn hình | FR-U04 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ds_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="@dimen/ds_sheet_handle_width"
        android:layout_height="@dimen/ds_sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/ds_space_8"
        android:background="@drawable/bg_ds_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_content_margin"
        android:paddingTop="@dimen/ds_space_8"
        android:paddingEnd="@dimen/ds_space_8"
        android:paddingBottom="@dimen/ds_space_4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_filter_title"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_filter_subtitle"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnFilterClose"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hc_filter_close"
            android:padding="@dimen/ds_space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ds_close"
            app:tint="@color/ds_text" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ds_outline" />

    <!-- Scrollable criteria -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_16"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_16">

            <!-- Categories -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_filter_categories"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:text="@string/hc_filter_categories_hint"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilterCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                app:chipSpacingHorizontal="@dimen/ds_space_8"
                app:chipSpacingVertical="@dimen/ds_space_4"
                app:singleLine="false"
                app:singleSelection="false" />

            <!-- Time -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_24"
                android:text="@string/hc_filter_time"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilterTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                app:chipSpacingHorizontal="@dimen/ds_space_8"
                app:chipSpacingVertical="@dimen/ds_space_4"
                app:selectionRequired="true"
                app:singleLine="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterTimeAny"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/hc_filter_time_any" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterTimeToday"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_time_today" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterTimeWeek"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_time_week" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterTimeMonth"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_time_month" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterTimeCustom"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_time_custom" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:id="@+id/layoutFilterCustomDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterDateFrom"
                        style="@style/Widget.EventApp.Ds.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hc_filter_date_from"
                        android:textAllCaps="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterDateTo"
                        style="@style/Widget.EventApp.Ds.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_8"
                        android:layout_weight="1"
                        android:text="@string/hc_filter_date_to"
                        android:textAllCaps="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFilterDateSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_text_muted"
                    tools:text="01/11/2026 – 30/11/2026" />
            </LinearLayout>

            <!-- City -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_24"
                android:text="@string/hc_filter_city"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFilterCity"
                style="@style/Widget.EventApp.Ds.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:hint="@string/hc_filter_city_hint"
                app:endIconMode="dropdown_menu"
                app:endIconTint="@color/ds_text_muted">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actFilterCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Format -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_24"
                android:text="@string/hc_filter_format"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilterFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                app:chipSpacingHorizontal="@dimen/ds_space_8"
                app:chipSpacingVertical="@dimen/ds_space_4"
                app:selectionRequired="true"
                app:singleLine="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterFormatAny"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/hc_filter_format_any" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterFormatOnsite"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_format_onsite" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterFormatOnline"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_format_online" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Price -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_24"
                android:text="@string/hc_filter_price"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilterPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                app:chipSpacingHorizontal="@dimen/ds_space_8"
                app:chipSpacingVertical="@dimen/ds_space_4"
                app:selectionRequired="true"
                app:singleLine="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterPriceAny"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/hc_filter_price_any" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterPriceFree"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_price_free" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterPricePaid"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_price_paid" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvFilterPriceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                android:textColor="@color/ds_text_muted"
                tools:text="0 đ – 5.000.000 đ" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/sliderFilterPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:stepSize="50000"
                android:valueFrom="0"
                android:valueTo="5000000"
                app:haloColor="@color/ds_primary_soft"
                app:labelBehavior="gone"
                app:thumbColor="@color/ds_primary"
                app:trackColorActive="@color/ds_primary"
                app:trackColorInactive="@color/ds_outline" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchFilterAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16"
                android:text="@string/hc_filter_available"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                app:thumbTint="@color/ds_switch_thumb"
                app:trackTint="@color/ds_switch_track" />

            <!-- Sort -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_24"
                android:text="@string/hc_filter_sort"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilterSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                app:chipSpacingHorizontal="@dimen/ds_space_8"
                app:chipSpacingVertical="@dimen/ds_space_4"
                app:selectionRequired="true"
                app:singleLine="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterSortStart"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/hc_filter_sort_start" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterSortNewest"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_sort_newest" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterSortPriceAsc"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_sort_price_asc" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterSortPriceDesc"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_sort_price_desc" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterSortPopular"
                    style="@style/Widget.EventApp.Ds.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/hc_filter_sort_popular" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ds_outline" />

    <!-- Sticky actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ds_content_margin">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterReset"
            style="@style/Widget.EventApp.Ds.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hc_filter_reset"
            android:textAllCaps="false" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterApply"
            style="@style/Widget.EventApp.Ds.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="160dp"
            android:text="@string/hc_filter_apply"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
