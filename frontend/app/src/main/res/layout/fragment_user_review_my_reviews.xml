<?xml version="1.0" encoding="utf-8"?>
<!-- FR-U20: "Đánh giá của tôi" - toàn bộ đánh giá người dùng đã viết, lọc theo trạng thái. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_content_margin">

        <ImageButton
            android:id="@+id/btnMyReviewsBack"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hc_myreviews_back"
            android:padding="@dimen/ds_space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ds_back"
            app:tint="@color/ds_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_myreviews_title"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <TextView
                android:id="@+id/tvMyReviewsCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                tools:text="5 đánh giá · 3 đang hiển thị" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ds_content_margin"
        android:paddingEnd="@dimen/ds_content_margin"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMyReviews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_4"
            app:chipSpacingHorizontal="@dimen/ds_space_8"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMyReviewsAll"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hc_myreviews_filter_all"
                android:checked="true"
                tools:text="Tất cả (5)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMyReviewsVisible"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hc_myreviews_filter_visible"
                tools:text="Đang hiển thị (3)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMyReviewsHeld"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hc_myreviews_filter_held"
                tools:text="Chờ kiểm duyệt (1)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMyReviewsHidden"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hc_myreviews_filter_hidden"
                tools:text="Đã bị ẩn (1)" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvMyReviewsNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_content_margin"
        android:layout_marginTop="@dimen/ds_space_8"
        android:layout_marginEnd="@dimen/ds_content_margin"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
        android:visibility="gone"
        tools:text="Đánh giá bị ẩn không hiển thị công khai và không sửa được."
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMyReviews"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_8"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_24" />

        <com.eventapp.app.ui.common.view.EmptyStateView
            android:id="@+id/emptyMyReviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.eventapp.app.ui.common.view.SkeletonLayout
            android:id="@+id/skeletonMyReviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_8"
            android:paddingEnd="@dimen/ds_content_margin"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_skeleton_height"
                android:layout_marginBottom="@dimen/ds_space_12"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_skeleton_height"
                android:layout_marginBottom="@dimen/ds_space_12"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_skeleton_height"
                android:layout_marginBottom="@dimen/ds_space_12"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_skeleton_height"
                android:background="@drawable/bg_ds_skeleton" />
        </com.eventapp.app.ui.common.view.SkeletonLayout>

        <com.eventapp.app.ui.common.view.ErrorStateView
            android:id="@+id/errorMyReviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
