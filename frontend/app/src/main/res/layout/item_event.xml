<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.EventApp.Ds.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_card_gap"
    android:clickable="true"
    android:focusable="true"
    app:cardPreventCornerOverlap="true"
    app:rippleColor="@color/ds_primary_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/ds_space_12">

        <FrameLayout
            android:layout_width="@dimen/ds_event_thumb"
            android:layout_height="@dimen/ds_event_thumb"
            android:background="@drawable/bg_ds_card_soft">

            <ImageView
                android:id="@+id/ivEventCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_ds_event"
                app:tint="@color/ds_white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.eventapp.app.ui.common.view.StatusChip
                    android:id="@+id/chipEventStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:text="Sắp hết vé"
                    tools:visibility="visible" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnEventFavorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hc_event_favorite_add"
                    android:padding="@dimen/ds_space_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_heart"
                    app:tint="@color/ds_text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                tools:text="Đêm nhạc Indie Sài Gòn 2026" />

            <TextView
                android:id="@+id/tvEventTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                tools:text="25/10/2026 • 19:30" />

            <TextView
                android:id="@+id/tvEventLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                tools:text="Nhà hát Hòa Bình, TP. Hồ Chí Minh" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.eventapp.app.ui.common.view.PriceTextView
                    android:id="@+id/tvEventPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Từ 350.000 đ" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/ivEventRatingStar"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_star_filled" />

                <TextView
                    android:id="@+id/tvEventRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_2"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    tools:text="4.8" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
