<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/ivDsErrorIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_ds_error"
        app:tint="@color/ds_danger"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/tvDsErrorTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_12"
        android:gravity="center"
        android:text="@string/hc_error_title"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

    <TextView
        android:id="@+id/tvDsErrorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_4"
        android:gravity="center"
        android:text="@string/hc_error_default"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
        android:textColor="@color/ds_text_muted" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDsErrorRetry"
        style="@style/Widget.EventApp.Ds.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_16"
        android:text="@string/hc_retry" />
</merge>
