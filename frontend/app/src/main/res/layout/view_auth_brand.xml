<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="@dimen/ds_icon_40"
        android:layout_height="@dimen/ds_icon_40"
        android:background="@drawable/bg_ds_brand_tile">

        <ImageView
            android:layout_width="@dimen/ds_icon_24"
            android:layout_height="@dimen/ds_icon_24"
            android:layout_gravity="center"
            android:contentDescription="@string/auth_cd_brand_logo"
            android:src="@drawable/ic_ds_event"
            app:tint="@color/ds_white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="@string/auth_brand_name"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:text="@string/auth_brand_tagline"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
    </LinearLayout>
</LinearLayout>
