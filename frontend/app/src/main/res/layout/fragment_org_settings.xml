<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/org_gutter"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/org_gutter">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/org_settings_title"
                android:textAppearance="@style/TextAppearance.EventApp.Org.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/org_settings_sub"
                android:textAppearance="@style/TextAppearance.EventApp.Org.Caption" />
        </LinearLayout>

        <!-- Hồ sơ tổ chức -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EventApp.Org.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/org_gutter"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/org_gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_org_logo_tile">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_org_logo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:maxLines="1"
                            android:text="@string/org_org_name"
                            android:textColor="@color/org_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:maxLines="1"
                            android:text="@string/org_org_type"
                            android:textColor="@color/org_text_dim"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_org_pill_primary"
                                android:drawableStart="@drawable/ic_org_check_circle"
                                android:drawablePadding="4dp"
                                android:drawableTint="@color/org_primary_dark"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="@string/org_verified"
                                android:textColor="@color/org_primary_dark"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_org_pill_neutral"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="@string/org_tier"
                                android:textColor="@color/org_neutral_text"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnEditProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_org_btn_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/org_edit"
                        android:textColor="@color/org_primary_dark"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/org_divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_auth_mail"
                    android:drawablePadding="7dp"
                    android:drawableTint="@color/org_text_dim"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/org_org_email"
                    android:textColor="@color/org_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nhóm: Tổ chức -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/org_gutter"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/org_gutter"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.08"
            android:text="@string/org_group_org"
            android:textColor="@color/org_text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EventApp.Org.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/org_gutter"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/org_gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowProfile"
                    layout="@layout/view_org_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="59dp"
                    android:background="@color/org_divider" />

                <include
                    android:id="@+id/rowLegal"
                    layout="@layout/view_org_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="59dp"
                    android:background="@color/org_divider" />

                <include
                    android:id="@+id/rowBank"
                    layout="@layout/view_org_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nhóm: Vận hành -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/org_gutter"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/org_gutter"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.08"
            android:text="@string/org_group_ops"
            android:textColor="@color/org_text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EventApp.Org.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/org_gutter"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/org_gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowNotify"
                    layout="@layout/view_org_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="59dp"
                    android:background="@color/org_divider" />

                <include
                    android:id="@+id/rowTeam"
                    layout="@layout/view_org_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="59dp"
                    android:background="@color/org_divider" />

                <include
                    android:id="@+id/rowDevices"
                    layout="@layout/view_org_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nhóm: Hệ thống -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/org_gutter"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/org_gutter"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.08"
            android:text="@string/org_group_system"
            android:textColor="@color/org_text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EventApp.Org.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/org_gutter"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/org_gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/row2fa"
                    layout="@layout/view_org_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="59dp"
                    android:background="@color/org_divider" />

                <include
                    android:id="@+id/rowLanguage"
                    layout="@layout/view_org_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="59dp"
                    android:background="@color/org_divider" />

                <include
                    android:id="@+id/rowHelp"
                    layout="@layout/view_org_setting_row"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btnOrgLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/org_gutter"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/org_gutter"
            android:background="@drawable/bg_org_btn_danger"
            android:drawableStart="@drawable/ic_user_logout"
            android:drawablePadding="7dp"
            android:drawableTint="@color/org_danger_text"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:text="@string/org_logout"
            android:textColor="@color/org_danger_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:text="@string/org_version"
            android:textColor="@color/org_text_dim"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
