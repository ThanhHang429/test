<?xml version="1.0" encoding="utf-8"?>
<!-- Tổng quan khu quản trị: báo cáo điều hành, KPI, xu hướng GMV và lối vào các màn của module.
     Màu sắc bám palette màn admin của Stitch: surface #FAF8FF, primary #3525CD,
     surface-container #EAEDFF, error-container #FFDAD6. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_content_margin"
        android:paddingEnd="@dimen/ds_content_margin">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_host_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_8"
            android:paddingTop="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_space_8"
            android:paddingBottom="@dimen/ds_space_4">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ds_lock"
                app:tint="@color/ds_on_secondary_container" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_4"
                android:letterSpacing="0.08"
                android:text="@string/hc_adm_badge"
                android:textColor="@color/ds_on_secondary_container"
                android:textSize="10sp"
                android:textStyle="bold"
                app:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/hc_adminhub_title"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_ds_avatar">

            <ImageView
                android:layout_width="@dimen/ds_icon_20"
                android:layout_height="@dimen/ds_icon_20"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile"
                app:tint="@color/ds_primary" />
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_24">

            <!-- Ngữ cảnh báo cáo + cảnh báo rủi ro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="@string/hc_adm_report_label"
                        android:textColor="@color/ds_text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAdminToday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.LabelSmall"
                            tools:text="Hôm nay: 31/10/2026" />

                        <View
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginStart="@dimen/ds_space_6"
                            android:background="@drawable/bg_ds_status_dot"
                            android:backgroundTint="@color/ds_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_4"
                            android:text="@string/hc_adm_live"
                            android:textColor="@color/ds_secondary"
                            android:textSize="11sp"
                            app:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAdminAlerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ds_pill_alert"
                    android:drawablePadding="@dimen/ds_space_4"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/ds_space_8"
                    android:paddingTop="@dimen/ds_space_4"
                    android:paddingEnd="@dimen/ds_space_8"
                    android:paddingBottom="@dimen/ds_space_4"
                    android:textColor="@color/ds_danger_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/plus_jakarta_sans"
                    app:drawableStartCompat="@drawable/ic_ds_flag"
                    app:drawableTint="@color/ds_danger"
                    tools:text="3 cảnh báo rủi ro" />
            </LinearLayout>

            <!-- Bộ lọc khoảng thời gian -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:background="@drawable/bg_segment_track"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_4">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdminRangeToday"
                    style="@style/Widget.EventApp.Ds.Chip.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/hc_adm_range_today" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdminRangeWeek"
                    style="@style/Widget.EventApp.Ds.Chip.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_2"
                    android:layout_weight="1"
                    android:text="@string/hc_adm_range_week" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdminRangeMonth"
                    style="@style/Widget.EventApp.Ds.Chip.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_2"
                    android:layout_weight="1"
                    android:text="@string/hc_adm_range_month" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdminRangeYear"
                    style="@style/Widget.EventApp.Ds.Chip.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_2"
                    android:layout_weight="1"
                    android:text="@string/hc_adm_range_year" />
            </LinearLayout>

            <!-- KPI 2x2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.eventapp.app.ui.common.view.KpiTileView
                    android:id="@+id/tileAdminGmv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.eventapp.app.ui.common.view.KpiTileView
                    android:id="@+id/tileAdminTickets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_12"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.eventapp.app.ui.common.view.KpiTileView
                    android:id="@+id/tileAdminEvents"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.eventapp.app.ui.common.view.KpiTileView
                    android:id="@+id/tileAdminOrgs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_12"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Xu hướng GMV -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_adm_chart_title"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                    <com.eventapp.app.ui.common.view.SimpleBarChartView
                        android:id="@+id/chartAdminGmv"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="@dimen/ds_space_12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAdminChartCaption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                            tools:text="Cao điểm T7: 3,2 tỷ" />

                        <TextView
                            android:id="@+id/tvAdminUpdated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_8"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                            tools:text="Cập nhật lúc 18:37" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.eventapp.app.ui.common.view.SectionHeaderView
                android:id="@+id/headerAdminHubModeration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_20" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminHubFlags"
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_16">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_avatar">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_24"
                            android:layout_height="@dimen/ds_icon_24"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_flag"
                            app:tint="@color/ds_danger" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_adminhub_flags"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_adminhub_flags_desc"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAdminFlagsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ds_pill_alert"
                        android:paddingStart="@dimen/ds_space_8"
                        android:paddingTop="@dimen/ds_space_2"
                        android:paddingEnd="@dimen/ds_space_8"
                        android:paddingBottom="@dimen/ds_space_2"
                        android:textColor="@color/ds_danger_dark"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans"
                        tools:text="14" />

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:layout_marginStart="@dimen/ds_space_8"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_chevron_right"
                        app:tint="@color/ds_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminHubReviews"
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_16">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_avatar">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_24"
                            android:layout_height="@dimen/ds_icon_24"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_star_filled"
                            app:tint="@color/ds_warning" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_adminhub_reviews"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_adminhub_reviews_desc"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAdminReviewsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ds_pill_warning"
                        android:paddingStart="@dimen/ds_space_8"
                        android:paddingTop="@dimen/ds_space_2"
                        android:paddingEnd="@dimen/ds_space_8"
                        android:paddingBottom="@dimen/ds_space_2"
                        android:textColor="@color/ds_warning_dark"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/plus_jakarta_sans"
                        tools:text="8" />

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:layout_marginStart="@dimen/ds_space_8"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_chevron_right"
                        app:tint="@color/ds_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.eventapp.app.ui.common.view.SectionHeaderView
                android:id="@+id/headerAdminHubConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_20" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminHubCategories"
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_16">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_avatar">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_24"
                            android:layout_height="@dimen/ds_icon_24"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_filter"
                            app:tint="@color/ds_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_adminhub_categories"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_adminhub_categories_desc"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_chevron_right"
                        app:tint="@color/ds_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminHubIntegrations"
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_16">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_avatar">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_24"
                            android:layout_height="@dimen/ds_icon_24"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_chart"
                            app:tint="@color/ds_organizer" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_adminhub_integrations"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_adminhub_integrations_desc"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_chevron_right"
                        app:tint="@color/ds_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_24"
                android:text="@string/hc_adminhub_footer"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
