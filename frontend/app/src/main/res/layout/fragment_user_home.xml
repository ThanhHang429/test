<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header thương hiệu: tự ẩn khi cuộn xuống, hiện lại khi cuộn lên -->
        <LinearLayout
            android:id="@+id/layoutHomeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_12"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_8">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_ds_brand_tile">

                <ImageView
                    android:layout_width="@dimen/ds_icon_20"
                    android:layout_height="@dimen/ds_icon_20"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_event"
                    app:tint="@color/ds_white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/hc_brand_name"
                    android:textColor="@color/ds_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/hc_brand_tagline"
                    android:textAllCaps="true"
                    android:textColor="@color/ds_outline"
                    android:textSize="9sp"
                    app:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHomeLocation"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_ds_search"
                android:clickable="true"
                android:contentDescription="@string/hc_home_location_change"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingEnd="@dimen/ds_space_8">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_location"
                    app:tint="@color/ds_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/hc_home_location"
                    android:textColor="@color/ds_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="@dimen/ds_space_2">

                <ImageButton
                    android:id="@+id/btnHomeFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hc_home_favorites"
                    android:padding="@dimen/ds_space_6"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_heart"
                    app:tint="@color/ds_text" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/ds_space_2">

                <ImageButton
                    android:id="@+id/btnHomeNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hc_home_notifications"
                    android:padding="@dimen/ds_space_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_notifications"
                    app:tint="@color/ds_text" />

                <View
                    android:id="@+id/viewHomeNotificationDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/ds_space_6"
                    android:layout_marginEnd="@dimen/ds_space_6"
                    android:background="@drawable/bg_ds_badge_count" />
            </FrameLayout>
        </LinearLayout>

        <!-- Search bar: luôn hiển thị, thu nhỏ khi cuộn -->
        <LinearLayout
            android:id="@+id/layoutHomeSearchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_8">

            <LinearLayout
                android:id="@+id/layoutHomeSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_search"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_12"
                android:paddingEnd="@dimen/ds_space_8">

                <ImageView
                    android:layout_width="@dimen/ds_icon_20"
                    android:layout_height="@dimen/ds_icon_20"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_search"
                    app:tint="@color/ds_outline" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_8"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/hc_home_search_hint"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                    android:textColor="@color/ds_outline" />

                <ImageButton
                    android:id="@+id/btnHomeSearchVoice"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hc_home_search_voice"
                    android:padding="@dimen/ds_space_6"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_mic"
                    app:tint="@color/ds_outline" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/layoutHomeFilter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/ds_space_8">

                <ImageButton
                    android:id="@+id/btnHomeFilter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ds_filter_box"
                    android:contentDescription="@string/hc_list_filter"
                    android:padding="@dimen/ds_space_12"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_filter"
                    app:tint="@color/ds_primary" />

                <TextView
                    android:id="@+id/tvHomeFilterCount"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_ds_badge_count"
                    android:gravity="center"
                    android:textColor="@color/ds_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:fontFamily="@font/plus_jakarta_sans"
                    tools:text="2"
                    tools:visibility="visible" />
            </FrameLayout>
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshHome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/ds_space_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Danh mục: hàng icon tròn, mỗi danh mục một màu -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingTop="@dimen/ds_space_4"
                        android:paddingEnd="@dimen/ds_content_margin"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutHomeCategories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <!-- Bộ lọc nhanh -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingEnd="@dimen/ds_content_margin"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupHomeQuick"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="@dimen/ds_space_8"
                            app:selectionRequired="false"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHomeQuickAll"
                                style="@style/Widget.EventApp.Ds.Chip.Quick"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:checked="true"
                                android:text="@string/hc_home_quick_all" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHomeQuickToday"
                                style="@style/Widget.EventApp.Ds.Chip.Quick"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/hc_home_quick_today" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHomeQuickWeekend"
                                style="@style/Widget.EventApp.Ds.Chip.Quick"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/hc_home_quick_weekend" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHomeQuickFree"
                                style="@style/Widget.EventApp.Ds.Chip.Quick"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/hc_home_quick_free" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHomeQuickNear"
                                style="@style/Widget.EventApp.Ds.Chip.Quick"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/hc_home_quick_near" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Băng chuyền sự kiện nổi bật -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHomeHero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />

                    <!-- Gợi ý cho bạn: chỉ tiêu đề + danh sách card, không bọc card ngoài -->
                    <LinearLayout
                        android:id="@+id/layoutHomeAiSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_24"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingEnd="@dimen/ds_content_margin">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_ds_avatar">

                                <ImageView
                                    android:layout_width="@dimen/ds_icon_16"
                                    android:layout_height="@dimen/ds_icon_16"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_ds_ai_sparkle"
                                    app:tint="@color/ds_primary" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_8"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvHomeAiHeader"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hc_home_ai_header"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H2"
                                    android:textSize="17sp" />

                                <TextView
                                    android:id="@+id/tvHomeAiSubheader"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hc_home_ai_subheader"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btnHomeAiRefresh"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackground"
                                android:drawablePadding="@dimen/ds_space_2"
                                android:gravity="center_vertical"
                                android:paddingStart="@dimen/ds_space_4"
                                android:paddingEnd="@dimen/ds_space_4"
                                android:text="@string/hc_refresh"
                                android:textColor="@color/ds_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/ic_ds_refresh"
                                app:drawableTint="@color/ds_primary"
                                app:fontFamily="@font/plus_jakarta_sans" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHomeAiCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                android:textColor="@color/ds_primary"
                                android:textStyle="bold"
                                tools:text="6 sự kiện phù hợp" />

                            <TextView
                                android:id="@+id/btnHomeAiSeeAll"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:paddingStart="@dimen/ds_space_4"
                                android:paddingEnd="@dimen/ds_space_4"
                                android:text="@string/hc_home_see_all"
                                android:textColor="@color/ds_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:fontFamily="@font/plus_jakarta_sans" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvHomeAi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never" />
                    </LinearLayout>

                    <!-- Thịnh hành tuần này -->
                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerHomeTrending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_24"
                        android:layout_marginEnd="@dimen/ds_content_margin" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHomeTrending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingEnd="@dimen/ds_content_margin" />

                    <!-- Danh sách mặc định "sắp diễn ra" theo FR-U04 -->
                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerHomeUpcoming"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_24"
                        android:layout_marginEnd="@dimen/ds_content_margin" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHomeUpcoming"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingEnd="@dimen/ds_content_margin" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.eventapp.app.ui.common.view.SkeletonLayout
        android:id="@+id/skeletonHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg"
        android:orientation="vertical"
        android:padding="@dimen/ds_content_margin"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="140dp"
            android:layout_height="20dp"
            android:layout_marginBottom="@dimen/ds_space_12"
            android:background="@drawable/bg_ds_skeleton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="@dimen/ds_space_16"
            android:background="@drawable/bg_ds_skeleton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="@dimen/ds_space_24"
            android:background="@drawable/bg_ds_skeleton" />

        <View
            android:layout_width="180dp"
            android:layout_height="20dp"
            android:layout_marginBottom="@dimen/ds_space_12"
            android:background="@drawable/bg_ds_skeleton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/bg_ds_skeleton" />
    </com.eventapp.app.ui.common.view.SkeletonLayout>

    <com.eventapp.app.ui.common.view.EmptyStateView
        android:id="@+id/emptyHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="gone" />

    <com.eventapp.app.ui.common.view.ErrorStateView
        android:id="@+id/errorHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="gone" />
</FrameLayout>
