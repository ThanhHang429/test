<?xml version="1.0" encoding="utf-8"?>
<!-- Host khu vực người dùng kèm bottom navigation dạng thanh nổi | FR-U03.
     NavHost phủ toàn màn hình và thanh điều hướng nằm overlay lên trên.
     Cấu trúc z-order (từ dưới lên):
       1. nav_host_fragment  — nội dung chính, paddingBottom xử lý ở từng fragment
       2. nav_gradient       — gradient ds_bg→transparent, cao 28dp, che khe hở dưới nav bar
       3. nav_bar_container  — card nổi trắng đục, margin 16dp hai bên, bo 28dp -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/host_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Nội dung chính: phủ toàn màn hình, fragment tự thêm paddingBottom = ds_nav_bottom_padding -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_user"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lớp gradient che khe hở giữa nav bar và đáy màn hình.
         Elevation 0 → nằm dưới nav_bar_container (elevation 12dp).
         Chiều cao 28dp, sát đáy màn hình. -->
    <View
        android:id="@+id/nav_gradient"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_nav_gradient"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Thanh điều hướng nổi: overlay, không chiếm chỗ của nội dung.
         margin 24dp mỗi bên → thanh gọn hơn, không kéo sát hai mép màn hình.
         marginBottom được cộng thêm inset thanh gesture trong UserHostActivity.
         Elevation 12dp → ở trên gradient, bóng đổ từ bg_nav_bar layer-list. -->
    <FrameLayout
        android:id="@+id/nav_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_24"
        android:layout_marginEnd="@dimen/ds_space_24"
        android:layout_marginBottom="@dimen/ds_space_12"
        android:background="@drawable/bg_nav_bar"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingTop="@dimen/ds_space_2"
            android:paddingBottom="@dimen/ds_space_2"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/Widget.EventApp.NavIndicator"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/ds_nav_icon_tint"
            app:itemMinHeight="@dimen/ds_nav_bar_height"
            app:itemPaddingTop="@dimen/ds_space_4"
            app:itemPaddingBottom="@dimen/ds_space_2"
            app:itemRippleColor="@color/ds_primary_soft"
            app:itemTextAppearanceActive="@style/TextAppearance.EventApp.NavLabel.Active"
            app:itemTextAppearanceInactive="@style/TextAppearance.EventApp.NavLabel"
            app:itemTextColor="@color/ds_nav_text_tint"
            app:labelVisibilityMode="labeled"
            app:paddingBottomSystemWindowInsets="false"
            app:menu="@menu/menu_user_bottom" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
