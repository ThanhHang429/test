<?xml version="1.0" encoding="utf-8"?>
<!-- Host khu vực người dùng kèm bottom navigation dạng thanh nổi | FR-U03.
     NavHost phủ toàn màn hình và thanh điều hướng nằm overlay lên trên, nên vùng dưới
     thanh (safe area / gesture bar) vẫn nhìn xuyên thấy nội dung đang cuộn. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/host_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_user"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Thanh điều hướng nổi: overlay, không chiếm chỗ của nội dung.
         marginBottom được cộng thêm inset của thanh gesture trong UserHostActivity. -->
    <FrameLayout
        android:id="@+id/nav_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_12"
        android:layout_marginEnd="@dimen/ds_space_12"
        android:layout_marginBottom="@dimen/ds_space_4"
        android:background="@drawable/bg_nav_bar"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingTop="@dimen/ds_space_2"
            android:paddingBottom="@dimen/ds_space_2"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/Widget.EventApp.NavIndicator"
            app:itemIconTint="@color/ds_nav_icon_tint"
            app:itemRippleColor="@color/ds_primary_soft"
            app:itemTextAppearanceActive="@style/TextAppearance.EventApp.NavLabel.Active"
            app:itemTextAppearanceInactive="@style/TextAppearance.EventApp.NavLabel"
            app:itemTextColor="@color/ds_nav_text_tint"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_user_bottom" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
