<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/layoutDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="104dp">

                <!-- Toolbar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ds_top_bar_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ds_space_4"
                    android:paddingEnd="@dimen/ds_space_4">

                    <ImageButton
                        android:id="@+id/btnDetailBack"
                        android:layout_width="@dimen/ds_touch_target"
                        android:layout_height="@dimen/ds_touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/hc_detail_back"
                        android:padding="@dimen/ds_space_12"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_ds_back"
                        app:tint="@color/ds_text" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_4"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/hc_detail_title"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                    <ImageButton
                        android:id="@+id/btnDetailShare"
                        android:layout_width="@dimen/ds_touch_target"
                        android:layout_height="@dimen/ds_touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/hc_detail_share"
                        android:padding="@dimen/ds_space_12"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_ds_share"
                        app:tint="@color/ds_text" />

                    <ImageButton
                        android:id="@+id/btnDetailFavorite"
                        android:layout_width="@dimen/ds_touch_target"
                        android:layout_height="@dimen/ds_touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/hc_detail_save"
                        android:padding="@dimen/ds_space_12"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_ds_heart"
                        app:tint="@color/ds_text" />
                </LinearLayout>

                <com.eventapp.app.ui.common.view.OfflineBanner
                    android:id="@+id/bannerDetailOffline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginEnd="@dimen/ds_content_margin"
                    android:layout_marginBottom="@dimen/ds_space_8"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/cardDetailPartialError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginEnd="@dimen/ds_content_margin"
                    android:layout_marginBottom="@dimen/ds_space_8"
                    android:background="@drawable/bg_ds_error_soft"
                    android:padding="@dimen/ds_space_12"
                    android:text="@string/hc_detail_partial_error"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                    android:textColor="@color/ds_danger_dark"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/cardDetailCancelled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginEnd="@dimen/ds_content_margin"
                    android:layout_marginBottom="@dimen/ds_space_8"
                    android:background="@drawable/bg_ds_error_soft"
                    android:padding="@dimen/ds_space_12"
                    android:text="@string/hc_detail_cancelled_banner"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textColor="@color/ds_danger_dark"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/cardDetailCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginEnd="@dimen/ds_content_margin"
                    android:layout_marginBottom="@dimen/ds_space_8"
                    android:background="@drawable/bg_ds_info_soft"
                    android:padding="@dimen/ds_space_12"
                    android:text="@string/hc_detail_completed_banner"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                    android:textColor="@color/ds_info_dark"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Hero -->
                <FrameLayout
                    android:id="@+id/layoutDetailHero"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginEnd="@dimen/ds_content_margin"
                    android:background="@drawable/bg_ds_card_soft">

                    <ImageView
                        android:id="@+id/ivDetailCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_ds_event"
                        app:tint="@color/ds_white" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="@dimen/ds_space_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDetailHeroCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ds_tag"
                            android:paddingStart="@dimen/ds_space_8"
                            android:paddingTop="@dimen/ds_space_2"
                            android:paddingEnd="@dimen/ds_space_8"
                            android:paddingBottom="@dimen/ds_space_2"
                            android:textColor="@color/ds_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="Công nghệ" />

                        <com.eventapp.app.ui.common.view.StatusChip
                            android:id="@+id/chipDetailHeroStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_4"
                            android:visibility="gone"
                            tools:text="Hết vé"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailGalleryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="@dimen/ds_space_12"
                        android:background="@drawable/bg_ds_chip"
                        android:paddingStart="@dimen/ds_space_8"
                        android:paddingTop="@dimen/ds_space_2"
                        android:paddingEnd="@dimen/ds_space_8"
                        android:paddingBottom="@dimen/ds_space_2"
                        android:textColor="@color/ds_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="+3 ảnh" />
                </FrameLayout>

                <!-- Main title card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:layout_marginEnd="@dimen/ds_content_margin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_16">

                        <com.eventapp.app.ui.common.view.AiBadge
                            android:id="@+id/aiBadgeDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/ds_space_8"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvDetailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H1"
                            tools:text="Vietnam AI &amp; Tech Summit 2026" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.eventapp.app.ui.common.view.StarRatingView
                                android:id="@+id/ratingDetailStars"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/tvDetailRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_6"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                                android:textColor="@color/ds_warning_dark"
                                tools:text="4.8 (128)" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_12"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_clock"
                                app:tint="@color/ds_primary" />

                            <TextView
                                android:id="@+id/tvDetailTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_8"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                                tools:text="25/10/2026 • 19:30 – 22:00" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_location"
                                app:tint="@color/ds_primary" />

                            <TextView
                                android:id="@+id/tvDetailLocation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_8"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                                tools:text="Nhà hát Hòa Bình, TP. Hồ Chí Minh" />
                        </LinearLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupDetailTags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_12"
                            app:chipSpacingHorizontal="@dimen/ds_space_6"
                            app:chipSpacingVertical="@dimen/ds_space_4" />

                        <TextView
                            android:id="@+id/tvDetailAsOf"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                            tools:text="Cập nhật lúc 09:42" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tabs -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:layout_marginEnd="@dimen/ds_content_margin"
                    android:background="@color/ds_surface"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/ds_primary"
                    app:tabIndicatorFullWidth="false"
                    app:tabMode="fixed"
                    app:tabRippleColor="@color/ds_primary_soft"
                    app:tabSelectedTextColor="@color/ds_primary"
                    app:tabTextColor="@color/ds_text_muted">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_detail_tab_overview" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_detail_tab_tickets" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_detail_tab_reviews" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_detail_tab_policy" />
                </com.google.android.material.tabs.TabLayout>

                <!-- Overview -->
                <LinearLayout
                    android:id="@+id/sectionDetailOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ds_content_margin"
                    android:paddingTop="@dimen/ds_space_16"
                    android:paddingEnd="@dimen/ds_content_margin">

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerDetailAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:lineSpacingExtra="3dp"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyL"
                        android:textColor="@color/ds_text_muted"
                        tools:text="Mô tả sự kiện..." />

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerDetailGallery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_24" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDetailGallery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.EventApp.Ds.Card.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_20">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/ds_space_16">

                            <FrameLayout
                                android:layout_width="@dimen/ds_avatar_lg"
                                android:layout_height="@dimen/ds_avatar_lg"
                                android:background="@drawable/bg_ds_avatar">

                                <ImageView
                                    android:id="@+id/ivDetailOrganizerLogo"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_ds_users"
                                    app:tint="@color/ds_primary" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_12"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDetailOrganizerName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                                    tools:text="Tech Horizon" />

                                <TextView
                                    android:id="@+id/tvDetailOrganizerMeta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_2"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                    tools:text="Đã xác minh • 24 sự kiện đã tổ chức" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_2"
                                    android:text="@string/hc_detail_contact_hidden"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                    android:textColor="@color/ds_text_muted" />
                            </LinearLayout>

                            <com.eventapp.app.ui.common.view.StatusChip
                                android:id="@+id/chipDetailOrganizerVerified"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Đã xác minh" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Tickets -->
                <LinearLayout
                    android:id="@+id/sectionDetailTickets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ds_content_margin"
                    android:paddingTop="@dimen/ds_space_16"
                    android:paddingEnd="@dimen/ds_content_margin"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerDetailTickets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDetailTickets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <LinearLayout
                        android:id="@+id/layoutDetailTicketError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:background="@drawable/bg_ds_error_soft"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/ds_space_12"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_detail_ticket_error"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                            android:textColor="@color/ds_danger_dark" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetailTicketRetry"
                            style="@style/Widget.EventApp.Ds.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_detail_retry" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailTicketNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:text="@string/hc_detail_ticket_note"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                </LinearLayout>

                <!-- Reviews -->
                <LinearLayout
                    android:id="@+id/sectionDetailReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ds_content_margin"
                    android:paddingTop="@dimen/ds_space_16"
                    android:paddingEnd="@dimen/ds_content_margin"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerDetailReviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.EventApp.Ds.Card.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/ds_space_16">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:minWidth="88dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDetailRatingBig"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/ds_text"
                                    android:textSize="40sp"
                                    android:textStyle="bold"
                                    tools:text="4.8" />

                                <com.eventapp.app.ui.common.view.StarRatingView
                                    android:id="@+id/ratingDetailSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    android:id="@+id/tvDetailReviewCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_4"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                    tools:text="128 đánh giá" />
                            </LinearLayout>

                            <com.eventapp.app.ui.common.view.RatingDistributionView
                                android:id="@+id/ratingDistributionDetail"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_16"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDetailReviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <TextView
                        android:id="@+id/tvDetailReviewEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:gravity="center"
                        android:text="@string/hc_detail_review_none"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                        android:textColor="@color/ds_text_muted"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/layoutDetailReviewError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:background="@drawable/bg_ds_error_soft"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/ds_space_12"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_detail_review_error"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                            android:textColor="@color/ds_danger_dark" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetailReviewRetry"
                            style="@style/Widget.EventApp.Ds.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_detail_retry" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailWriteReview"
                        style="@style/Widget.EventApp.Ds.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:text="@string/hc_detail_write_review"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailSeeReviews"
                        style="@style/Widget.EventApp.Ds.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_detail_review_see_all" />
                </LinearLayout>

                <!-- Policy -->
                <LinearLayout
                    android:id="@+id/sectionDetailPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ds_content_margin"
                    android:paddingTop="@dimen/ds_space_16"
                    android:paddingEnd="@dimen/ds_content_margin"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_detail_policy_tab_note"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerDetailConditions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_16" />

                    <TextView
                        android:id="@+id/tvDetailConditions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:lineSpacingExtra="3dp"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                        tools:text="Điều kiện tham gia..." />

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerDetailCancelPolicy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_20" />

                    <TextView
                        android:id="@+id/tvDetailCancelPolicy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:lineSpacingExtra="3dp"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                        tools:text="Chính sách hủy..." />

                    <LinearLayout
                        android:id="@+id/layoutDetailOnline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_20"
                        android:background="@drawable/bg_ds_info_soft"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_12"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvDetailOnlineTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_detail_online_link"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            android:textColor="@color/ds_info_dark" />

                        <TextView
                            android:id="@+id/tvDetailOnlineHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_detail_online_link_locked"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDetailOnlineJoin"
                            style="@style/Widget.EventApp.Ds.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:text="@string/hc_detail_online_link"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_16"
                        android:text="@string/hc_detail_timezone_note"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:text="@string/hc_detail_cancel_policy_note"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ds_space_24" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Loading / error / unavailable overlays -->
    <com.eventapp.app.ui.common.view.SkeletonLayout
        android:id="@+id/skeletonDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/ds_content_margin" />

    <com.eventapp.app.ui.common.view.ErrorStateView
        android:id="@+id/errorDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg"
        android:visibility="gone" />

    <com.eventapp.app.ui.common.view.EmptyStateView
        android:id="@+id/emptyDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_bg"
        android:visibility="gone" />

    <!-- Sticky action bar -->
    <LinearLayout
        android:id="@+id/layoutDetailBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_ds_bottom_bar"
        android:elevation="@dimen/ds_elevation_sheet"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_content_margin"
        android:paddingTop="@dimen/ds_space_12"
        android:paddingEnd="@dimen/ds_content_margin"
        android:paddingBottom="@dimen/ds_space_12">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailBottomPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Price"
                tools:text="Từ 350.000 đ" />

            <TextView
                android:id="@+id/tvDetailBottomStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                tools:text="Đang mở bán" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailPrimary"
            style="@style/Widget.EventApp.Ds.Button.Cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="150dp"
            tools:text="Mua vé" />
    </LinearLayout>
</FrameLayout>
