<?xml version="1.0" encoding="utf-8"?>
<!-- Một dịch vụ ngoài trong FR-A20: chấm trạng thái, tên, số liệu phụ, nhãn trạng thái. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ds_space_16"
    android:paddingTop="@dimen/ds_space_8"
    android:paddingEnd="@dimen/ds_space_16"
    android:paddingBottom="@dimen/ds_space_8">

    <View
        android:id="@+id/viewServiceDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="@dimen/ds_space_12"
        android:background="@drawable/bg_ds_status_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvServiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
            tools:text="AI Gateway" />

        <TextView
            android:id="@+id/tvServiceMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
            tools:text="2% lỗi · p95 640 ms · 412 yêu cầu" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvServiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_8"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
        tools:text="Ổn định" />
</LinearLayout>
