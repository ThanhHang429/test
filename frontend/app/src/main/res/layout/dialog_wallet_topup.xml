<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Thanh kéo BottomSheet -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:text="Nạp tiền vào Ví ETicket"
        android:textColor="@color/user_text"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:text="Chọn mức nạp hoặc tự nhập số tiền cần nạp"
        android:textColor="@color/user_text_muted"
        android:textSize="12sp" />

    <!-- Các mốc tiền nhanh -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:text="Mức nạp nhanh"
        android:textColor="@color/user_text"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip100k"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_user_chip"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:gravity="center"
            android:text="100.000đ"
            android:textColor="@color/user_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chip200k"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_user_chip"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:gravity="center"
            android:text="200.000đ"
            android:textColor="@color/user_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chip500k"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_user_chip"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:gravity="center"
            android:text="500.000đ"
            android:textColor="@color/user_text"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Ô nhập số tiền tùy chọn -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:text="Hoặc nhập số tiền khác (VNĐ)"
        android:textColor="@color/user_text"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etAmount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_auth_input"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:hint="500.000"
        android:inputType="number"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/user_primary"
        android:textSize="16sp" />

    <!-- Chọn phương thức nạp -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:text="Phương thức thanh toán nạp tiền"
        android:textColor="@color/user_text"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgPaymentMethod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbVietQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Chuyển khoản VietQR (ACB)"
            android:textColor="@color/user_text"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Thẻ quốc tế (Visa / Mastercard)"
            android:textColor="@color/user_text"
            android:textSize="14sp" />
    </RadioGroup>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- Nút Xác nhận Nạp tiền -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitTopup"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/user_primary"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="Xác nhận nạp tiền"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:cornerRadius="12dp" />

</LinearLayout>
