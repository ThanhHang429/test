<?xml version="1.0" encoding="utf-8"?>
<!-- FR-A07 bỏ qua cờ + FR-A14 ẩn/giữ/yêu cầu sửa: mã lý do và ghi chú bắt buộc. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/ds_space_24"
    android:paddingTop="@dimen/ds_space_8"
    android:paddingEnd="@dimen/ds_space_24">

    <LinearLayout
        android:id="@+id/layoutReasonCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hc_mod_reason_code"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupReasonCodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_6"
            app:chipSpacingHorizontal="@dimen/ds_space_6"
            app:selectionRequired="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReasonSpam"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="SPAM"
                android:text="@string/hc_a14_reason_spam" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReasonOffensive"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="OFFENSIVE"
                android:text="@string/hc_a14_reason_offensive" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReasonPersonalData"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="PERSONAL_DATA"
                android:text="@string/hc_a14_reason_personal_data" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReasonFake"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="FAKE_REVIEW"
                android:text="@string/hc_a14_reason_fake" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReasonOffTopic"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="OFF_TOPIC"
                android:text="@string/hc_a14_reason_off_topic" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipReasonOther"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="OTHER"
                android:text="@string/hc_a14_reason_other" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutReasonNote"
        style="@style/Widget.EventApp.Ds.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_12"
        android:hint="@string/hc_mod_note_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReasonNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="300"
            android:maxLines="5"
            android:minLines="3"
            android:paddingTop="@dimen/ds_space_12"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvReasonError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_8"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
        android:textColor="@color/ds_danger_dark"
        android:visibility="gone"
        tools:text="Chọn mã lý do"
        tools:visibility="visible" />
</LinearLayout>
