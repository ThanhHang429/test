<?xml version="1.0" encoding="utf-8"?>
<!-- FR-U12 OrderStatus: kết quả đơn hàng, vé điện tử và dòng thời gian xử lý. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollStatus"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutStatusContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/ds_space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_top_bar_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_4"
                android:paddingEnd="@dimen/ds_content_margin">

                <ImageButton
                    android:id="@+id/btnStatusBack"
                    android:layout_width="@dimen/ds_touch_target"
                    android:layout_height="@dimen/ds_touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hc_order_back"
                    android:padding="@dimen/ds_space_12"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_back"
                    app:tint="@color/ds_text" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_4"
                    android:layout_weight="1"
                    android:text="@string/hc_status_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:background="@drawable/bg_ds_step_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_4">

                <TextView
                    android:id="@+id/tvOrderStep1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/hc_order_step_1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOrderStep2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/hc_order_step_2"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOrderStep3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/hc_order_step_3"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusHero"
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_16"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_20">

                    <FrameLayout
                        android:id="@+id/frameStatusHeroIcon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_ds_circle_success">

                        <ImageView
                            android:id="@+id/ivStatusHeroIcon"
                            android:layout_width="@dimen/ds_icon_32"
                            android:layout_height="@dimen/ds_icon_32"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_check_circle"
                            app:tint="@color/ds_success_dark" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatusHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.H1"
                        android:textSize="22sp"
                        tools:text="Thanh toán thành công" />

                    <TextView
                        android:id="@+id/tvStatusHeroMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_6"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                        android:textColor="@color/ds_text_muted"
                        tools:text="Vé đã được phát hành và sẵn sàng trong mục Vé của tôi." />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStatusOrderCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ds_code_pill"
                            android:paddingStart="@dimen/ds_space_12"
                            android:paddingTop="@dimen/ds_space_4"
                            android:paddingEnd="@dimen/ds_space_12"
                            android:paddingBottom="@dimen/ds_space_4"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            android:textColor="@color/ds_primary"
                            tools:text="ORD-261031-482" />

                        <com.eventapp.app.ui.common.view.StatusChip
                            android:id="@+id/chipStatusHero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_8" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusTicket"
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_12"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/ds_avatar_md"
                            android:layout_height="@dimen/ds_avatar_md"
                            android:background="@drawable/bg_ds_circle_primary">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_ticket"
                                app:tint="@color/ds_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_12"
                            android:layout_weight="1"
                            android:text="@string/hc_status_ticket_label"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusTicketEvent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                        tools:text="Vietnam Tech Summit 2026" />

                    <TextView
                        android:id="@+id/tvStatusTicketMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        tools:text="08:30 • 31/10/2026 • Trung tâm Hội nghị Quốc gia, Hà Nội" />

                    <TextView
                        android:id="@+id/tvStatusTicketName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_primary"
                        tools:text="Vé Standard • x2" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginBottom="@dimen/ds_space_16"
                        android:background="@drawable/bg_ds_dashed_line" />

                    <FrameLayout
                        android:layout_width="224dp"
                        android:layout_height="224dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_ds_qr_frame"
                        android:padding="@dimen/ds_space_12">

                        <com.eventapp.app.ui.common.view.DemoQrView
                            android:id="@+id/qrStatus"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatusTicketCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:background="@drawable/bg_ds_code_pill"
                        android:letterSpacing="0.08"
                        android:paddingStart="@dimen/ds_space_12"
                        android:paddingTop="@dimen/ds_space_4"
                        android:paddingEnd="@dimen/ds_space_12"
                        android:paddingBottom="@dimen/ds_space_4"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_text"
                        tools:text="ETK-PASS-482917" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:gravity="center"
                        android:text="@string/hc_status_checkin_note"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.eventapp.app.ui.common.view.SectionHeaderView
                android:id="@+id/headerStatusTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_section_gap"
                android:layout_marginEnd="@dimen/ds_content_margin"
                tools:title="Trạng thái đơn hàng" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_8"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:id="@+id/layoutStatusTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ds_space_16"
                    android:paddingTop="@dimen/ds_space_16"
                    android:paddingEnd="@dimen/ds_space_16" />
            </com.google.android.material.card.MaterialCardView>

            <com.eventapp.app.ui.common.view.SectionHeaderView
                android:id="@+id/headerStatusInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_section_gap"
                android:layout_marginEnd="@dimen/ds_content_margin"
                tools:title="Thông tin đơn hàng" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_8"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_status_order_code"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                            android:textColor="@color/ds_text_muted" />

                        <TextView
                            android:id="@+id/tvStatusInfoCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.04"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            tools:text="ORD-261031-482" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_status_order_created"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                            android:textColor="@color/ds_text_muted" />

                        <TextView
                            android:id="@+id/tvStatusInfoCreated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            tools:text="21:22, 31/10/2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_status_order_method"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                            android:textColor="@color/ds_text_muted" />

                        <TextView
                            android:id="@+id/tvStatusInfoMethod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            tools:text="Chuyển khoản VietQR" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginBottom="@dimen/ds_space_12"
                        android:background="@color/ds_outline_variant" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_status_order_recipient"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                        android:textColor="@color/ds_text_muted" />

                    <TextView
                        android:id="@+id/tvStatusInfoRecipient"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        tools:text="Nguyễn Minh Anh\nminhanh@eticket.demo • 0909 123 456" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginBottom="@dimen/ds_space_12"
                        android:background="@color/ds_outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_status_order_total"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <com.eventapp.app.ui.common.view.PriceTextView
                            android:id="@+id/tvStatusInfoTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            tools:text="350.000 đ" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvStatusHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_16"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:gravity="center"
                android:text="@string/hc_status_help"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.eventapp.app.ui.common.view.EmptyStateView
        android:id="@+id/emptyStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutStatusBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_ds_bottom_bar"
        android:elevation="@dimen/ds_elevation_sheet"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_content_margin"
        android:paddingTop="@dimen/ds_space_12"
        android:paddingEnd="@dimen/ds_content_margin"
        android:paddingBottom="@dimen/ds_space_4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusPrimary"
            style="@style/Widget.EventApp.Ds.Button.Cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hc_status_view_tickets" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatusSecondary"
            style="@style/Widget.EventApp.Ds.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hc_status_home_action" />
    </LinearLayout>
</FrameLayout>
