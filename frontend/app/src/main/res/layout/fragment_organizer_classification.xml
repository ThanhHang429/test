<?xml version="1.0" encoding="utf-8"?>
<!-- FR-O09: danh mục chính/phụ + nhãn phụ của một sự kiện. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_8"
        android:paddingTop="@dimen/ds_space_8"
        android:paddingEnd="@dimen/ds_space_8">

        <ImageButton
            android:id="@+id/btnClassificationBack"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/org_classification_title"
            android:src="@drawable/ic_ds_back"
            app:tint="@color/ds_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/org_classification_title"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

        <View
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="1dp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressClassification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/ds_organizer"
        tools:visibility="visible" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_8"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/org_classification_subtitle"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                android:textColor="@color/ds_text_muted" />

            <TextView
                android:id="@+id/tvClassificationError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_16"
                android:background="@drawable/bg_ds_error_soft"
                android:padding="@dimen/ds_space_16"
                android:text="@string/org_classification_error"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                android:textColor="@color/ds_danger_dark"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClassificationRetry"
                style="@style/Widget.EventApp.Ds.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:text="@string/org_tools_retry"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layoutClassificationForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvClassificationReReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:background="@drawable/bg_ds_warning_soft"
                    android:padding="@dimen/ds_space_12"
                    android:text="@string/org_classification_requires_review"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_warning_dark"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Primary -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_20"
                    android:text="@string/org_classification_primary"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:text="@string/org_classification_primary_hint"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupClassificationPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    app:chipSpacingHorizontal="@dimen/ds_space_6"
                    app:chipSpacingVertical="@dimen/ds_space_4"
                    app:selectionRequired="true"
                    app:singleLine="false"
                    app:singleSelection="true" />

                <!-- Secondary -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_20"
                    android:text="@string/org_classification_secondary"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:text="@string/org_classification_secondary_hint"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupClassificationSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    app:chipSpacingHorizontal="@dimen/ds_space_6"
                    app:chipSpacingVertical="@dimen/ds_space_4"
                    app:singleLine="false" />

                <!-- Tags -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_20"
                    android:text="@string/org_classification_tags"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:text="@string/org_classification_tags_hint"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupClassificationTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    app:chipSpacingHorizontal="@dimen/ds_space_6"
                    app:chipSpacingVertical="@dimen/ds_space_4"
                    app:singleLine="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilClassificationTag"
                        style="@style/Widget.EventApp.Ds.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/org_classification_tag_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etClassificationTag"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textCapWords"
                            android:maxLength="30"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClassificationAddTag"
                        style="@style/Widget.EventApp.Ds.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_8"
                        android:backgroundTint="@color/ds_organizer"
                        android:text="@string/org_classification_tag_add" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:text="@string/org_classification_suggestions"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupClassificationSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    app:chipSpacingHorizontal="@dimen/ds_space_6"
                    app:chipSpacingVertical="@dimen/ds_space_4"
                    app:singleLine="false" />

                <TextView
                    android:id="@+id/tvClassificationLocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:background="@drawable/bg_ds_card_soft"
                    android:padding="@dimen/ds_space_12"
                    android:text="@string/org_classification_locked"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClassificationSave"
                    style="@style/Widget.EventApp.Ds.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_24"
                    android:backgroundTint="@color/ds_organizer"
                    android:text="@string/org_classification_save"
                    app:icon="@drawable/ic_ds_check_circle"
                    app:iconTint="@color/ds_white" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
