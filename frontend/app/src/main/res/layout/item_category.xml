<?xml version="1.0" encoding="utf-8"?>
<!-- Dòng danh mục trong cây 2 cấp (FR-A09). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ds_content_margin"
    android:layout_marginEnd="@dimen/ds_content_margin"
    android:layout_marginBottom="@dimen/ds_space_8"
    android:background="@drawable/bg_ds_list_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivCategoryDrag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/hc_cat_drag"
        android:padding="@dimen/ds_space_8"
        android:src="@drawable/ic_ds_drag"
        app:tint="@color/ds_outline" />

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_ds_avatar">

        <ImageView
            android:id="@+id/ivCategoryIcon"
            android:layout_width="@dimen/ds_icon_20"
            android:layout_height="@dimen/ds_icon_20"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

        <TextView
            android:id="@+id/tvCategorySlug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCategoryUsage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_4"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

    <com.eventapp.app.ui.common.view.StatusChip
        android:id="@+id/chipCategoryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_8" />

    <ImageButton
        android:id="@+id/btnCategoryEdit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/hc_cat_edit"
        android:padding="@dimen/ds_space_8"
        android:src="@drawable/ic_ds_edit"
        app:tint="@color/ds_text_muted" />
</LinearLayout>
