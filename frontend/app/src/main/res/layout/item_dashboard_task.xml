<?xml version="1.0" encoding="utf-8"?>
<!-- Dòng "Việc cần xử lý" của O03: icon mức khẩn, tiêu đề, mô tả, dẫn sang màn tương ứng. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.EventApp.Ds.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_space_8"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ds_space_12">

        <ImageView
            android:id="@+id/ivDashTaskIcon"
            android:layout_width="@dimen/ds_icon_24"
            android:layout_height="@dimen/ds_icon_24"
            android:contentDescription="@null"
            android:src="@drawable/ic_ds_clock"
            app:tint="@color/ds_warning_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDashTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                tools:text="Đêm nhạc Indie Sài Gòn 2026" />

            <TextView
                android:id="@+id/tvDashTaskSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                tools:text="Bắt đầu sau 2 ngày • 128/200 vé đã bán" />

            <com.eventapp.app.ui.common.view.StatusChip
                android:id="@+id/chipDashTaskUrgency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_6"
                tools:text="Khẩn" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/ds_icon_20"
            android:layout_height="@dimen/ds_icon_20"
            android:layout_marginStart="@dimen/ds_space_8"
            android:contentDescription="@null"
            android:src="@drawable/ic_ds_chevron_right"
            app:tint="@color/ds_text_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
