<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình Danh sách sự kiện: tìm kiếm, lọc và phân trang | FR-U04 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_4"
            android:paddingTop="@dimen/ds_space_8"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_8">

            <ImageButton
                android:id="@+id/btnListBack"
                android:layout_width="@dimen/ds_touch_target"
                android:layout_height="@dimen/ds_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/hc_list_back"
                android:padding="@dimen/ds_space_12"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ds_back"
                app:tint="@color/ds_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_4"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_list_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_list_subtitle"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Search + filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_8">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilListSearch"
                style="@style/Widget.EventApp.Ds.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hc_list_search_hint"
                app:endIconMode="clear_text"
                app:endIconTint="@color/ds_text_muted"
                app:startIconDrawable="@drawable/ic_ds_search"
                app:startIconTint="@color/ds_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etListSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLength="100"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:layout_width="@dimen/ds_touch_target"
                android:layout_height="@dimen/ds_touch_target"
                android:layout_marginStart="@dimen/ds_space_8">

                <ImageButton
                    android:id="@+id/btnListFilter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hc_list_filter"
                    android:padding="@dimen/ds_space_12"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_filter"
                    app:tint="@color/ds_primary" />

                <TextView
                    android:id="@+id/tvListFilterBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/ds_space_6"
                    android:layout_marginEnd="@dimen/ds_space_4"
                    android:background="@drawable/bg_ds_badge_count"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/ds_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="3" />
            </FrameLayout>
        </LinearLayout>

        <!-- Result count + sort -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_8"
            android:paddingEnd="@dimen/ds_space_8"
            android:paddingBottom="@dimen/ds_space_4">

            <TextView
                android:id="@+id/tvListResultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                android:textColor="@color/ds_text"
                tools:text="12 sự kiện" />

            <TextView
                android:id="@+id/btnListClearFilters"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ds_touch_target"
                android:layout_marginStart="@dimen/ds_space_4"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingEnd="@dimen/ds_space_8"
                android:text="@string/hc_list_clear_filters"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                android:textColor="@color/ds_primary"
                android:visibility="gone"
                tools:visibility="visible" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/btnListSort"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ds_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/hc_list_sort"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingEnd="@dimen/ds_space_4">

                <ImageView
                    android:layout_width="@dimen/ds_icon_20"
                    android:layout_height="@dimen/ds_icon_20"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_sort"
                    app:tint="@color/ds_text_muted" />

                <TextView
                    android:id="@+id/tvListSort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_4"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_text"
                    tools:text="Sắp xếp: Sắp diễn ra" />
            </LinearLayout>
        </LinearLayout>

        <!-- Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshList"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEventList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/ds_content_margin"
                    android:paddingTop="@dimen/ds_space_4"
                    android:paddingEnd="@dimen/ds_content_margin"
                    android:paddingBottom="@dimen/ds_space_24"
                    tools:listitem="@layout/item_event" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- Search history -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/layoutListHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ds_bg"
                android:fillViewport="true"
                android:visibility="gone"
                tools:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_content_margin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_list_history_title"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:id="@+id/btnListHistoryClear"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/ds_touch_target"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/ds_space_8"
                            android:paddingEnd="@dimen/ds_space_8"
                            android:text="@string/hc_list_history_clear"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            android:textColor="@color/ds_primary" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupListHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        app:chipSpacingHorizontal="@dimen/ds_space_8"
                        app:chipSpacingVertical="@dimen/ds_space_4"
                        app:singleLine="false"
                        app:singleSelection="false" />

                    <TextView
                        android:id="@+id/tvListHistoryEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_16"
                        android:text="@string/hc_list_history_empty"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                        android:textColor="@color/ds_text_muted"
                        android:visibility="gone"
                        tools:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Skeleton -->
            <com.eventapp.app.ui.common.view.SkeletonLayout
                android:id="@+id/skeletonList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ds_bg"
                android:orientation="vertical"
                android:padding="@dimen/ds_content_margin"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="@dimen/ds_space_12"
                    android:background="@drawable/bg_ds_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="@dimen/ds_space_12"
                    android:background="@drawable/bg_ds_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_ds_skeleton" />
            </com.eventapp.app.ui.common.view.SkeletonLayout>

            <com.eventapp.app.ui.common.view.EmptyStateView
                android:id="@+id/emptyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:visibility="gone" />

            <com.eventapp.app.ui.common.view.ErrorStateView
                android:id="@+id/errorList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
