<?xml version="1.0" encoding="utf-8"?>
<!-- FR-U11 PaymentQr: giữ chỗ, quét VietQR và xác nhận thanh toán demo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPayment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutPaymentContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/ds_space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_top_bar_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_4"
                android:paddingEnd="@dimen/ds_content_margin">

                <ImageButton
                    android:id="@+id/btnPaymentBack"
                    android:layout_width="@dimen/ds_touch_target"
                    android:layout_height="@dimen/ds_touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hc_order_back"
                    android:padding="@dimen/ds_space_12"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_back"
                    app:tint="@color/ds_text" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_4"
                    android:layout_weight="1"
                    android:text="@string/hc_pay_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:background="@drawable/bg_ds_step_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_4">

                <TextView
                    android:id="@+id/tvOrderStep1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/hc_order_step_1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOrderStep2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/hc_order_step_2"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOrderStep3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/hc_order_step_3"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPaymentHold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_16"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:background="@drawable/bg_ds_warning_soft"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/framePaymentHoldIcon"
                        android:layout_width="@dimen/ds_avatar_md"
                        android:layout_height="@dimen/ds_avatar_md"
                        android:background="@drawable/bg_ds_circle_warning">

                        <ImageView
                            android:id="@+id/ivPaymentHoldIcon"
                            android:layout_width="@dimen/ds_icon_20"
                            android:layout_height="@dimen/ds_icon_20"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_clock"
                            app:tint="@color/ds_warning_dark" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPaymentHoldTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_pay_hold_title"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:id="@+id/tvPaymentHoldMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_pay_hold_message"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPaymentCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_8"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:minWidth="60dp"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.H2"
                        android:textColor="@color/ds_warning_dark"
                        tools:text="09:42" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPaymentRetry"
                    style="@style/Widget.EventApp.Ds.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:text="@string/hc_pay_retry"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_12"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_pay_payment_title"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <com.eventapp.app.ui.common.view.StatusChip
                            android:id="@+id/chipPaymentStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPaymentOrderSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        tools:text="Đơn ORD-261031-482 • Giữ chỗ" />

                    <TextView
                        android:id="@+id/tvPaymentTicketLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        tools:text="Vé Standard • x2" />

                    <FrameLayout
                        android:layout_width="248dp"
                        android:layout_height="248dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/ds_space_16"
                        android:background="@drawable/bg_ds_qr_frame"
                        android:padding="@dimen/ds_space_12">

                        <com.eventapp.app.ui.common.view.DemoQrView
                            android:id="@+id/qrPayment"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:gravity="center"
                        android:text="@string/hc_pay_payment_instruction"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                    <LinearLayout
                        android:id="@+id/layoutPaymentListening"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/ds_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_8"
                            android:text="@string/hc_pay_listening"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            android:textColor="@color/ds_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_6"
                            android:text="@string/hc_pay_auto"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_12"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_pay_transfer_info"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_pay_bank"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                            <TextView
                                android:id="@+id/tvPaymentBank"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_2"
                                android:text="@string/hc_pay_bank_value"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginBottom="@dimen/ds_space_12"
                        android:background="@color/ds_outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_pay_account"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                            <TextView
                                android:id="@+id/tvPaymentAccount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_2"
                                android:letterSpacing="0.08"
                                android:text="@string/hc_pay_account_value"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnCopyPaymentAccount"
                            android:layout_width="@dimen/ds_touch_target"
                            android:layout_height="@dimen/ds_touch_target"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/hc_pay_copy_account"
                            android:padding="@dimen/ds_space_12"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_ds_copy"
                            app:tint="@color/ds_primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginBottom="@dimen/ds_space_12"
                        android:background="@color/ds_outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_pay_holder"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                            <TextView
                                android:id="@+id/tvPaymentHolder"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_2"
                                android:text="@string/hc_pay_holder_value"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginBottom="@dimen/ds_space_12"
                        android:background="@color/ds_outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_pay_amount"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                            <com.eventapp.app.ui.common.view.PriceTextView
                                android:id="@+id/tvPaymentAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_2"
                                android:textSize="18sp"
                                tools:text="350.000 đ" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnCopyPaymentAmount"
                            android:layout_width="@dimen/ds_touch_target"
                            android:layout_height="@dimen/ds_touch_target"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/hc_pay_copy_amount"
                            android:padding="@dimen/ds_space_12"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_ds_copy"
                            app:tint="@color/ds_primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginBottom="@dimen/ds_space_12"
                        android:background="@color/ds_outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_pay_content"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                            <TextView
                                android:id="@+id/tvPaymentContent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_4"
                                android:background="@drawable/bg_ds_code_pill"
                                android:paddingStart="@dimen/ds_space_12"
                                android:paddingTop="@dimen/ds_space_4"
                                android:paddingEnd="@dimen/ds_space_12"
                                android:paddingBottom="@dimen/ds_space_4"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                                android:textColor="@color/ds_primary"
                                tools:text="ETK ORD-261031-482" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnCopyPaymentContent"
                            android:layout_width="@dimen/ds_touch_target"
                            android:layout_height="@dimen/ds_touch_target"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/hc_pay_copy_content"
                            android:padding="@dimen/ds_space_12"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_ds_copy"
                            app:tint="@color/ds_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_12"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:background="@drawable/bg_ds_info_soft"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_12">

                <ImageView
                    android:layout_width="@dimen/ds_icon_20"
                    android:layout_height="@dimen/ds_icon_20"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_info"
                    app:tint="@color/ds_info_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_pay_note_title"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_info_dark" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:text="@string/hc_pay_note_message"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.eventapp.app.ui.common.view.EmptyStateView
        android:id="@+id/emptyPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutPaymentBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_ds_bottom_bar"
        android:elevation="@dimen/ds_elevation_sheet"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_content_margin"
        android:paddingTop="@dimen/ds_space_12"
        android:paddingEnd="@dimen/ds_content_margin"
        android:paddingBottom="@dimen/ds_space_4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPaymentConfirm"
            style="@style/Widget.EventApp.Ds.Button.Cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hc_pay_confirm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPaymentCancel"
            style="@style/Widget.EventApp.Ds.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hc_pay_cancel"
            android:textColor="@color/ds_danger" />
    </LinearLayout>
</FrameLayout>
