<?xml version="1.0" encoding="utf-8"?>
<!-- O03 Dashboard Organizer: chu kỳ, khối tài chính, tình trạng sự kiện, KPI, việc cần xử lý, top sự kiện. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_content_margin"
        android:paddingTop="@dimen/ds_space_12"
        android:paddingEnd="@dimen/ds_space_8"
        android:paddingBottom="@dimen/ds_space_8">

        <ImageView
            android:layout_width="@dimen/ds_avatar_md"
            android:layout_height="@dimen/ds_avatar_md"
            android:background="@drawable/bg_ds_avatar"
            android:contentDescription="@string/hc_odash_avatar"
            android:padding="@dimen/ds_space_8"
            android:src="@drawable/ic_profile"
            app:tint="@color/ds_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDashboardGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hc_odash_title"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_odash_subtitle"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDashNotifications"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hc_odash_notifications"
            android:padding="@dimen/ds_space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ds_notifications"
            app:tint="@color/ds_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollDashboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/ds_space_24">

                    <TextView
                        android:id="@+id/bannerDashboardSuspended"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:background="@drawable/bg_ds_error_soft"
                        android:padding="@dimen/ds_space_12"
                        android:text="@string/hc_odash_suspended"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        android:textColor="@color/ds_danger_dark"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.eventapp.app.ui.common.view.OfflineBanner
                        android:id="@+id/offlineDashboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_16"
                            android:layout_height="@dimen/ds_icon_16"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_clock"
                            app:tint="@color/ds_text_muted" />

                        <TextView
                            android:id="@+id/tvDashboardUpdatedAt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_4"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                            tools:text="Cập nhật lúc 09:12" />

                        <com.eventapp.app.ui.common.view.StatusChip
                            android:id="@+id/chipDashboardReadOnly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_odash_read_only"
                            android:visibility="gone" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupDashboardRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/ds_content_margin"
                            android:paddingEnd="@dimen/ds_content_margin"
                            app:chipSpacingHorizontal="@dimen/ds_space_8"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipDashRange7"
                                style="@style/Widget.EventApp.Ds.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_odash_range_7" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipDashRange30"
                                style="@style/Widget.EventApp.Ds.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/hc_odash_range_30" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipDashRangeCustom"
                                style="@style/Widget.EventApp.Ds.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_odash_range_custom" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <LinearLayout
                        android:id="@+id/layoutDashCustomRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDashRangeFrom"
                            style="@style/Widget.EventApp.Ds.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_odash_range_from_any" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDashRangeTo"
                            style="@style/Widget.EventApp.Ds.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_8"
                            android:layout_weight="1"
                            android:text="@string/hc_odash_range_to_any" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.EventApp.Ds.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginEnd="@dimen/ds_content_margin">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/ds_space_16">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/hc_odash_finance_title"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

                                <com.eventapp.app.ui.common.view.StatusChip
                                    android:id="@+id/chipDashFinanceChange"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone"
                                    tools:text="+18% so với kỳ trước" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutDashFinanceBody"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDashFinanceValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_6"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Display"
                                    android:textColor="@color/ds_success_dark"
                                    android:textSize="30sp"
                                    tools:text="186.450.000 đ" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/ds_stroke"
                                    android:layout_marginTop="@dimen/ds_space_12"
                                    android:background="@color/ds_outline" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_12"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/hc_odash_finance_pending"
                                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                                        <TextView
                                            android:id="@+id/tvDashPending"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/ds_space_2"
                                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                                            android:textColor="@color/ds_warning_dark"
                                            tools:text="24.700.000 đ" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/hc_odash_finance_refunded"
                                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                                        <TextView
                                            android:id="@+id/tvDashRefunded"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/ds_space_2"
                                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                                            tools:text="6.750.000 đ" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/hc_odash_finance_fee"
                                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                                        <TextView
                                            android:id="@+id/tvDashFee"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/ds_space_2"
                                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                                            tools:text="6.525.750 đ" />
                                    </LinearLayout>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvDashFinanceNet"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_8"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                                    android:textColor="@color/ds_success_dark"
                                    tools:text="Thực nhận 173.174.250 đ" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_6"
                                    android:text="@string/hc_odash_finance_pending_note"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutDashFinanceError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_8"
                                android:orientation="vertical"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hc_odash_finance_error"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                                    android:textColor="@color/ds_danger_dark" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_2"
                                    android:text="@string/hc_odash_finance_error_note"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDashFinanceRetry"
                                    style="@style/Widget.EventApp.Ds.Button.Outlined"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_8"
                                    android:text="@string/hc_retry" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerDashStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:layout_marginEnd="@dimen/ds_space_12" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.EventApp.Ds.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:layout_marginEnd="@dimen/ds_content_margin">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/ds_space_16">

                            <TextView
                                android:id="@+id/tvDashReviewGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_odash_status_review_group"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.LabelSmall" />

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_6"
                                android:scrollbars="none">

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/chipGroupDashReview"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:chipSpacingHorizontal="@dimen/ds_space_6"
                                    app:singleLine="true" />
                            </HorizontalScrollView>

                            <TextView
                                android:id="@+id/tvDashLifeGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_12"
                                android:text="@string/hc_odash_status_life_group"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.LabelSmall" />

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_6"
                                android:scrollbars="none">

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/chipGroupDashLife"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:chipSpacingHorizontal="@dimen/ds_space_6"
                                    app:singleLine="true" />
                            </HorizontalScrollView>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:orientation="horizontal">

                        <com.eventapp.app.ui.common.view.KpiTileView
                            android:id="@+id/tileDashRegistrations"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <com.eventapp.app.ui.common.view.KpiTileView
                            android:id="@+id/tileDashTickets"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_card_gap"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:orientation="horizontal">

                        <com.eventapp.app.ui.common.view.KpiTileView
                            android:id="@+id/tileDashCheckin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <com.eventapp.app.ui.common.view.KpiTileView
                            android:id="@+id/tileDashRating"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_card_gap"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerDashTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_16"
                        android:layout_marginEnd="@dimen/ds_space_12" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDashTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingEnd="@dimen/ds_content_margin" />

                    <TextView
                        android:id="@+id/tvDashTasksEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:text="@string/hc_odash_tasks_empty"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        android:visibility="gone" />

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerDashTopEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_16"
                        android:layout_marginEnd="@dimen/ds_space_12" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDashTopEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingEnd="@dimen/ds_content_margin" />

                    <TextView
                        android:id="@+id/tvDashTopEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:text="@string/hc_empty_default"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDashAiInsight"
                        style="@style/Widget.EventApp.Ds.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:text="@string/hc_odash_ai_action"
                        app:icon="@drawable/ic_ds_ai_sparkle"
                        app:iconTint="@color/ds_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_16"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:text="@string/hc_odash_footer"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.eventapp.app.ui.common.view.SkeletonLayout
            android:id="@+id/skeletonDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:padding="@dimen/ds_content_margin"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="@dimen/ds_space_12"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="@dimen/ds_space_12"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginBottom="@dimen/ds_space_12"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_skeleton_height"
                android:layout_marginEnd="@dimen/ds_space_48"
                android:background="@drawable/bg_ds_skeleton" />
        </com.eventapp.app.ui.common.view.SkeletonLayout>

        <com.eventapp.app.ui.common.view.EmptyStateView
            android:id="@+id/emptyDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.eventapp.app.ui.common.view.ErrorStateView
            android:id="@+id/errorDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
