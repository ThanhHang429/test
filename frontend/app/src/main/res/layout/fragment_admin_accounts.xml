<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/admin_gutter"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/admin_gutter">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.14"
                android:text="@string/admin_acc_kicker"
                android:textColor="@color/admin_accent_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/admin_acc_title"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/admin_acc_sub"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.Body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:background="@drawable/bg_admin_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabUsers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_admin_segment_active"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:text="@string/admin_acc_tab_users"
                android:textColor="@color/admin_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabOrgs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:text="@string/admin_acc_tab_orgs"
                android:textColor="@color/admin_text_muted"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:background="@drawable/bg_admin_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_search"
                android:tint="@color/admin_text_dim" />

            <EditText
                android:id="@+id/etAccountSearch"
                style="@style/Widget.EventApp.Admin.Search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/admin_acc_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingStart="@dimen/admin_gutter"
            android:paddingEnd="@dimen/admin_gutter"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAccAll"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_acc_filter_all" />

                <TextView
                    android:id="@+id/chipAccActive"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_acc_filter_active" />

                <TextView
                    android:id="@+id/chipAccFlagged"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_acc_filter_flagged" />

                <TextView
                    android:id="@+id/chipAccLocked"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_acc_filter_locked" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvAccountCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/admin_text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/listAccounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
