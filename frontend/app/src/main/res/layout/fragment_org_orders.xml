<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/org_gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/org_gutter">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/org_orders_title"
            android:textAppearance="@style/TextAppearance.EventApp.Org.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/org_orders_sub"
            android:textAppearance="@style/TextAppearance.EventApp.Org.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_org_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_search"
                android:tint="@color/org_text_dim" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSearchOrder"
                style="@style/Widget.EventApp.Org.Search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/org_search_orders"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btnFilterOrder"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_org_btn_primary"
                android:contentDescription="@string/org_cd_filter"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_user_tune"
                android:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/org_gutter"
        android:paddingEnd="@dimen/org_gutter"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipOrderAll"
                style="@style/Widget.EventApp.Org.FilterChip"
                android:text="@string/org_order_all" />

            <TextView
                android:id="@+id/chipOrderPaid"
                style="@style/Widget.EventApp.Org.FilterChip"
                android:text="@string/org_order_paid" />

            <TextView
                android:id="@+id/chipOrderPending"
                style="@style/Widget.EventApp.Org.FilterChip"
                android:text="@string/org_order_pending" />

            <TextView
                android:id="@+id/chipOrderRefund"
                style="@style/Widget.EventApp.Org.FilterChip"
                android:text="@string/org_order_refund" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/org_gutter"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/org_gutter"
        android:background="@drawable/bg_org_card_soft"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:fontFeatureSettings="tnum"
                android:text="1.720"
                android:textColor="@color/org_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/org_order_total"
                android:textColor="@color/org_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:background="@color/org_border" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:fontFeatureSettings="tnum"
                android:text="1.462"
                android:textColor="@color/org_success_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/org_order_paid_count"
                android:textColor="@color/org_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:background="@color/org_border" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:fontFeatureSettings="tnum"
                android:text="18"
                android:textColor="@color/org_warning_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/org_order_pending_count"
                android:textColor="@color/org_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:background="@color/org_border" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:fontFeatureSettings="tnum"
                android:text="03"
                android:textColor="@color/org_danger_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/org_order_refund_count"
                android:textColor="@color/org_text_dim"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/org_gutter"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/org_gutter"
            android:paddingBottom="20dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvOrdersEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/org_events_empty"
            android:textAppearance="@style/TextAppearance.EventApp.Org.Body"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
