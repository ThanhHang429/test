<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_user_card_16"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTypeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.EventApp.User.CardTitle"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPopular"
            style="@style/Widget.EventApp.User.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_user_badge_primary"
            android:text="@string/user_popular"
            android:textColor="@color/user_primary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textAppearance="@style/TextAppearance.EventApp.User.Price"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.EventApp.User.Caption"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.EventApp.User.Micro" />

        <ImageButton
            android:id="@+id/btnMinus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_user_stepper"
            android:contentDescription="@string/user_quantity"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_user_minus"
            android:tint="@color/user_primary" />

        <TextView
            android:id="@+id/tvQty"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/user_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnPlus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_user_stepper"
            android:contentDescription="@string/user_quantity"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_user_plus"
            android:tint="@color/user_primary" />
    </LinearLayout>
</LinearLayout>
