<?xml version="1.0" encoding="utf-8"?>
<!-- U03: Sở thích. Chip danh mục (tối đa 10), hình thức, mức giá + ngân sách, thành phố (3), ngày. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_space_8">

        <ImageButton
            android:id="@+id/btnPrefBack"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hc_pref_back"
            android:padding="@dimen/ds_space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ds_back"
            app:tint="@color/ds_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_weight="1"
            android:text="@string/hc_pref_title"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrefSkip"
            style="@style/Widget.EventApp.Ds.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="@string/hc_pref_skip" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollPreferences"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/ds_space_24">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.Ds.Card.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:layout_marginEnd="@dimen/ds_content_margin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_16">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_ai_sparkle"
                                app:tint="@color/ds_secondary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_6"
                                android:layout_weight="1"
                                android:text="@string/hc_pref_intro_title"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:text="@string/hc_pref_intro_message"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.eventapp.app.ui.common.view.SectionHeaderView
                    android:id="@+id/headerPrefCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:layout_marginEnd="@dimen/ds_space_12" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPrefCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:paddingStart="@dimen/ds_content_margin"
                    android:paddingEnd="@dimen/ds_content_margin"
                    app:chipSpacingHorizontal="@dimen/ds_space_8"
                    app:chipSpacingVertical="@dimen/ds_space_4" />

                <TextView
                    android:id="@+id/tvPrefHiddenNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:layout_marginEnd="@dimen/ds_content_margin"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_warning_dark"
                    android:visibility="gone"
                    tools:text="Danh mục đã ẩn: Nghệ thuật"
                    tools:visibility="visible" />

                <com.eventapp.app.ui.common.view.SectionHeaderView
                    android:id="@+id/headerPrefFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:layout_marginEnd="@dimen/ds_space_12" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPrefFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:paddingStart="@dimen/ds_content_margin"
                    android:paddingEnd="@dimen/ds_content_margin"
                    app:chipSpacingHorizontal="@dimen/ds_space_8"
                    app:selectionRequired="true"
                    app:singleLine="false"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPrefFormatAny"
                        style="@style/Widget.EventApp.Ds.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/hc_pref_format_any" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPrefFormatOnsite"
                        style="@style/Widget.EventApp.Ds.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_pref_format_onsite" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPrefFormatOnline"
                        style="@style/Widget.EventApp.Ds.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_pref_format_online" />
                </com.google.android.material.chip.ChipGroup>

                <com.eventapp.app.ui.common.view.SectionHeaderView
                    android:id="@+id/headerPrefPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:layout_marginEnd="@dimen/ds_space_12" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPrefPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:paddingStart="@dimen/ds_content_margin"
                    android:paddingEnd="@dimen/ds_content_margin"
                    app:chipSpacingHorizontal="@dimen/ds_space_8"
                    app:selectionRequired="true"
                    app:singleLine="false"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPrefPriceAny"
                        style="@style/Widget.EventApp.Ds.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/hc_pref_price_any" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPrefPriceFree"
                        style="@style/Widget.EventApp.Ds.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_pref_price_free" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPrefPricePaid"
                        style="@style/Widget.EventApp.Ds.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_pref_price_paid" />
                </com.google.android.material.chip.ChipGroup>

                <com.eventapp.app.ui.common.view.BudgetInputView
                    android:id="@+id/budgetPref"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:layout_marginEnd="@dimen/ds_content_margin" />

                <com.eventapp.app.ui.common.view.SectionHeaderView
                    android:id="@+id/headerPrefCities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:layout_marginEnd="@dimen/ds_space_12" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPrefCities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:paddingStart="@dimen/ds_content_margin"
                    android:paddingEnd="@dimen/ds_content_margin"
                    app:chipSpacingHorizontal="@dimen/ds_space_8"
                    app:chipSpacingVertical="@dimen/ds_space_4" />

                <com.eventapp.app.ui.common.view.SectionHeaderView
                    android:id="@+id/headerPrefDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:layout_marginEnd="@dimen/ds_space_12" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPrefDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:paddingStart="@dimen/ds_content_margin"
                    android:paddingEnd="@dimen/ds_content_margin"
                    app:chipSpacingHorizontal="@dimen/ds_space_8">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPrefWeekday"
                        style="@style/Widget.EventApp.Ds.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/hc_pref_day_weekday" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPrefWeekend"
                        style="@style/Widget.EventApp.Ds.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/hc_pref_day_weekend" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:layout_marginEnd="@dimen/ds_content_margin"
                    android:text="@string/hc_pref_footer"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.eventapp.app.ui.common.view.SkeletonLayout
            android:id="@+id/skeletonPreferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:padding="@dimen/ds_content_margin"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginBottom="@dimen/ds_space_16"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_skeleton_height"
                android:layout_marginBottom="@dimen/ds_space_8"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_skeleton_height"
                android:layout_marginEnd="@dimen/ds_space_40"
                android:background="@drawable/bg_ds_skeleton" />
        </com.eventapp.app.ui.common.view.SkeletonLayout>

        <com.eventapp.app.ui.common.view.ErrorStateView
            android:id="@+id/errorPreferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ds_bottom_bar"
        android:orientation="vertical">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressPrefSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/ds_primary"
            app:trackThickness="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/ds_space_12">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrefReset"
                style="@style/Widget.EventApp.Ds.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hc_pref_reset" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrefSave"
                style="@style/Widget.EventApp.Ds.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="148dp"
                android:text="@string/hc_pref_save" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
