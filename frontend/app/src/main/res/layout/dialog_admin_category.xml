<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_cat_add"
            android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/admin_cat_field_name"
            android:textAppearance="@style/TextAppearance.EventApp.Admin.Label" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etName"
            style="@style/Widget.EventApp.Admin.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/admin_cat_field_name_hint"
            android:inputType="text"
            android:maxLength="120" />

        <TextView
            android:id="@+id/labelCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/admin_cat_field_code"
            android:textAppearance="@style/TextAppearance.EventApp.Admin.Label" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etCode"
            style="@style/Widget.EventApp.Admin.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/admin_cat_field_code_hint"
            android:inputType="textCapCharacters"
            android:maxLength="40" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/admin_cat_field_slug"
            android:textAppearance="@style/TextAppearance.EventApp.Admin.Label" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etSlug"
            style="@style/Widget.EventApp.Admin.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/admin_cat_field_slug_hint"
            android:inputType="text"
            android:maxLength="120" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/admin_cat_field_desc"
            android:textAppearance="@style/TextAppearance.EventApp.Admin.Label" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etDescription"
            style="@style/Widget.EventApp.Admin.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="top|start"
            android:hint="@string/admin_cat_field_desc_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minLines="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/admin_cat_field_parent"
            android:textAppearance="@style/TextAppearance.EventApp.Admin.Label" />

        <Spinner
            android:id="@+id/spParent"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/admin_cat_field_order"
            android:textAppearance="@style/TextAppearance.EventApp.Admin.Label" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etSortOrder"
            style="@style/Widget.EventApp.Admin.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/admin_cat_field_order_hint"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/admin_danger_text"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
