<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/ivDsSectionIcon"
        android:layout_width="@dimen/ds_icon_24"
        android:layout_height="@dimen/ds_icon_24"
        android:layout_marginEnd="@dimen/ds_space_8"
        android:contentDescription="@null"
        android:visibility="gone"
        app:tint="@color/ds_primary"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDsSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

        <TextView
            android:id="@+id/tvDsSectionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutDsSectionAction"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ds_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_8"
        android:paddingEnd="@dimen/ds_space_4"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDsSectionAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
            android:textColor="@color/ds_primary" />

        <ImageView
            android:id="@+id/ivDsSectionChevron"
            android:layout_width="@dimen/ds_icon_20"
            android:layout_height="@dimen/ds_icon_20"
            android:layout_marginStart="@dimen/ds_space_2"
            android:contentDescription="@null"
            android:src="@drawable/ic_ds_chevron_right"
            app:tint="@color/ds_text_muted"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
</merge>
