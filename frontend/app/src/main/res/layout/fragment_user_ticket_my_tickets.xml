<?xml version="1.0" encoding="utf-8"?>
<!-- Vé của tôi: gộp FR-U14 (vé đã mua) và FR-U18 (lịch sự kiện) thành 2 tab con. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_12"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_4">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hc_tickets_title"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H1"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTicketsMyReviews"
                style="@style/Widget.EventApp.Ds.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/hc_myreviews_entry" />

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <ImageButton
                    android:id="@+id/btnTicketsNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hc_home_notifications"
                    android:padding="@dimen/ds_space_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_notifications"
                    app:tint="@color/ds_text" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabTickets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_content_margin"
            android:layout_marginTop="@dimen/ds_space_8"
            android:layout_marginEnd="@dimen/ds_content_margin"
            android:background="@color/ds_bg"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/bg_ds_tab_indicator"
            app:tabIndicatorColor="@color/ds_primary"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabRippleColor="@color/ds_primary_soft"
            app:tabSelectedTextColor="@color/ds_primary"
            app:tabTextAppearance="@style/TextAppearance.EventApp.Ds.Label"
            app:tabTextColor="@color/ds_text_muted" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTickets"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_24" />
    </LinearLayout>

    <com.eventapp.app.ui.common.view.EmptyStateView
        android:id="@+id/emptyTickets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="gone" />
</FrameLayout>
