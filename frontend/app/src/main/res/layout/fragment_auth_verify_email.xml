<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_24"
        android:paddingTop="@dimen/ds_space_12"
        android:paddingEnd="@dimen/ds_space_24"
        android:paddingBottom="@dimen/ds_space_32">

        <ImageButton
            android:id="@+id/btnVerifyBack"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/auth_cd_back"
            android:padding="@dimen/ds_space_12"
            android:src="@drawable/ic_ds_back"
            app:tint="@color/ds_text" />

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/ds_space_24"
            android:background="@drawable/bg_ds_avatar">

            <ImageView
                android:layout_width="@dimen/ds_icon_32"
                android:layout_height="@dimen/ds_icon_32"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_ds_mail"
                app:tint="@color/ds_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_20"
            android:text="@string/auth_verify_title"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H1" />

        <TextView
            android:id="@+id/tvVerifySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_6"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
            android:textColor="@color/ds_text_muted"
            tools:text="Nhập mã 6 số đã gửi tới\nuser@eticket.demo" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EventApp.Ds.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_24"
            app:cardCornerRadius="@dimen/ds_radius_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_16">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutVerifyCode"
                    style="@style/Widget.EventApp.Ds.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_verify_code">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputVerifyCode"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:textColor="@color/ds_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:background="@drawable/bg_ds_info_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_12">

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_info"
                        app:tint="@color/ds_info_dark" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_8"
                        android:layout_weight="1"
                        android:text="@string/auth_verify_hint"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        android:textColor="@color/ds_info_dark" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerify"
                    style="@style/Widget.EventApp.Ds.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:text="@string/auth_verify_action" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerifyResend"
                    style="@style/Widget.EventApp.Ds.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:text="@string/auth_resend" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btnVerifyBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_20"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="@dimen/ds_space_12"
            android:text="@string/auth_back_to_login"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
            android:textColor="@color/ds_primary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
