<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_org_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_org_circle_button"
            android:contentDescription="@string/org_cd_back"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_auth_back"
            android:tint="@color/org_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="@string/org_event_detail_title"
            android:textColor="@color/org_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnShareEvent"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_org_circle_button"
            android:contentDescription="@string/org_cd_share"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_user_share"
            android:tint="@color/org_text" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Hero -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="182dp"
                android:layout_marginStart="@dimen/org_gutter"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/org_gutter"
                android:background="@drawable/bg_org_detail_hero"
                android:elevation="2dp"
                android:outlineProvider="background">

                <View
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-80dp"
                    android:layout_marginEnd="-60dp"
                    android:background="@drawable/bg_org_glow" />

                <TextView
                    android:id="@+id/tvDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_org_badge_glass"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="0.08"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_org_pill_success"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/org_success_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:maxLines="2"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:drawableStart="@drawable/ic_user_calendar"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/org_text_on_dark_muted"
                        android:ellipsize="end"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:maxLines="1"
                        android:textColor="@color/org_text_on_dark_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDetailLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_user_pin"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/org_text_on_dark_muted"
                        android:ellipsize="end"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:maxLines="1"
                        android:textColor="@color/org_text_on_dark_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 3 chỉ số -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Org.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/org_gutter"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/org_gutter">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatSold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/org_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="Vé đã bán"
                            android:textColor="@color/org_text_dim"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/org_border" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/org_primary_dark"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="@string/org_revenue_label"
                            android:textColor="@color/org_text_dim"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/org_border" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatCheckin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/org_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="@string/org_checkin_count"
                            android:textColor="@color/org_text_dim"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tổng quan -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/org_gutter"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="@dimen/org_gutter"
                android:text="@string/org_event_overview"
                android:textAppearance="@style/TextAppearance.EventApp.Org.Title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Org.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/org_gutter"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/org_gutter">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="@string/org_review_status"
                            android:textColor="@color/org_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvReviewStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_org_pill_success"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:paddingStart="9dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/org_success_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="@string/org_lifecycle_status"
                            android:textColor="@color/org_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvLifecycleStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_org_pill_primary"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:paddingStart="9dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/org_primary_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="13dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/org_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="@string/org_capacity"
                            android:textColor="@color/org_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCapacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/org_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:indicatorColor="@color/org_primary"
                        app:trackColor="@color/org_surface_mint"
                        app:trackCornerRadius="3dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hạng vé -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/org_gutter"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="@dimen/org_gutter"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/org_ticket_types"
                        android:textAppearance="@style/TextAppearance.EventApp.Org.Title" />

                    <TextView
                        android:id="@+id/tvTicketTypesSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/org_ticket_types_sub"
                        android:textAppearance="@style/TextAppearance.EventApp.Org.Caption" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Org.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/org_gutter"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/org_gutter">

                <LinearLayout
                    android:id="@+id/ticketTypeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Hành động -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Org.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/org_gutter"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/org_gutter">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/btnBroadcast"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_org_btn_secondary"
                        android:drawableStart="@drawable/ic_user_bell"
                        android:drawablePadding="7dp"
                        android:drawableTint="@color/org_primary_dark"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="center"
                        android:text="@string/org_send_broadcast"
                        android:textColor="@color/org_primary_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCancelEvent"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_org_btn_danger"
                        android:drawableStart="@drawable/ic_ds_warning"
                        android:drawablePadding="7dp"
                        android:drawableTint="@color/org_danger_text"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="center"
                        android:text="@string/org_cancel_event"
                        android:textColor="@color/org_danger_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom action -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/org_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/org_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/org_gutter"
        android:paddingEnd="@dimen/org_gutter">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageTickets"
            style="@style/Widget.EventApp.Org.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/org_control_height"
            android:drawableStart="@drawable/ic_user_ticket"
            android:drawablePadding="8dp"
            android:drawableTint="@color/white"
            android:text="@string/org_manage_tickets" />
    </LinearLayout>
</LinearLayout>
