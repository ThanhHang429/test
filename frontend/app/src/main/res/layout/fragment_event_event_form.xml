<?xml version="1.0" encoding="utf-8"?>
<!-- EventForm: khung form sự kiện, tích hợp O09 | FR-O04,FR-O05,FR-O08,FR-O09 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_4"
            android:paddingTop="@dimen/ds_space_8"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_8">

            <ImageButton
                android:id="@+id/btnEventFormBack"
                android:layout_width="@dimen/ds_touch_target"
                android:layout_height="@dimen/ds_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/hc_o09_back"
                android:padding="@dimen/ds_space_12"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ds_back"
                app:tint="@color/ds_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_4"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEventFormTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_o09_create_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_o09_form_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Form body -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_content_margin">

                <!-- Reserved for the event-info fields owned by the event module -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEventFormPlaceholder"
                    style="@style/Widget.EventApp.Ds.Card.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/ds_surface_alt">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_16">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_o09_form_title"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_o09_form_subtitle"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:text="@string/hc_o09_form_note"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                            android:textColor="@color/ds_text_muted" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- O06: khối mô tả -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEventDescription"
                    style="@style/Widget.EventApp.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_16">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_aidesc_form_title"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_aidesc_form_subtitle"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEventFormTitle"
                            style="@style/Widget.EventApp.Ds.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_12"
                            android:hint="@string/hc_aidesc_title_hint"
                            app:counterEnabled="true"
                            app:counterMaxLength="120">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEventFormTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapSentences"
                                android:maxLength="120" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_12"
                            android:text="@string/hc_aidesc_format"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupEventFormat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_6"
                            app:chipSpacingHorizontal="@dimen/ds_space_6"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipEventFormatOnsite"
                                style="@style/Widget.EventApp.Ds.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/hc_aidesc_format_onsite" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipEventFormatOnline"
                                style="@style/Widget.EventApp.Ds.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_aidesc_format_online" />
                        </com.google.android.material.chip.ChipGroup>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_12"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/hc_aidesc_keypoints"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

                            <TextView
                                android:id="@+id/tvEventFormKeyPointCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_aidesc_keypoints_count_format"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                tools:text="0/10" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_6"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilEventFormKeyPoint"
                                style="@style/Widget.EventApp.Ds.TextInputLayout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/hc_aidesc_keypoints_hint">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etEventFormKeyPoint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapSentences|textMultiLine"
                                    android:maxLength="200" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEventFormAddKeyPoint"
                                style="@style/Widget.EventApp.Ds.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_8"
                                android:text="@string/hc_aidesc_keypoints_add" />
                        </LinearLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupEventKeyPoints"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_6"
                            app:chipSpacingHorizontal="@dimen/ds_space_6"
                            app:chipSpacingVertical="@dimen/ds_space_6" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:text="@string/hc_aidesc_keypoint_suggestions"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupEventKeyPointSuggest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            app:chipSpacingHorizontal="@dimen/ds_space_6"
                            app:chipSpacingVertical="@dimen/ds_space_6" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEventFormDescription"
                            style="@style/Widget.EventApp.Ds.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_12"
                            android:hint="@string/hc_aidesc_description_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEventFormDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top"
                                android:inputType="textCapSentences|textMultiLine"
                                android:minLines="4" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:id="@+id/rowEventFormAiLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_6"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_16"
                                android:layout_height="@dimen/ds_icon_16"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_ai_sparkle"
                                app:tint="@color/ds_primary" />

                            <TextView
                                android:id="@+id/tvEventFormAiLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_4"
                                android:layout_weight="1"
                                android:text="@string/hc_aidesc_ai_label"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                android:textColor="@color/ds_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEventFormAi"
                                style="@style/Widget.EventApp.Ds.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_aidesc_open"
                                app:icon="@drawable/ic_ds_ai_sparkle"
                                app:iconTint="@color/ds_primary" />

                            <TextView
                                android:id="@+id/tvEventFormAiReason"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_8"
                                android:layout_weight="1"
                                android:maxLines="3"
                                android:text="@string/hc_aidesc_gate_ready"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                android:textColor="@color/ds_text_muted" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- O09 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_16">

                    <com.eventapp.app.ui.common.view.ClassificationSectionView
                        android:id="@+id/classificationSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/ds_space_16" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:text="@string/hc_o09_save_hint"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_text_muted" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Sticky save -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_surface"
            android:orientation="vertical"
            android:padding="@dimen/ds_content_margin">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressEventFormSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_8"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/ds_primary"
                app:trackColor="@color/ds_primary_soft"
                tools:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEventFormSave"
                style="@style/Widget.EventApp.Ds.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_o09_save"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
