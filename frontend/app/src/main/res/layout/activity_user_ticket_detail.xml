<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ticketRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/user_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_user_icon_circle"
                android:contentDescription="@string/user_cd_back"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_auth_back"
                android:tint="@color/user_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/user_ticket_detail"
                android:textColor="@color/user_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_user_icon_circle"
                android:contentDescription="@string/user_cd_share"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_user_share"
                android:tint="@color/user_text" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="4dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_user_card_20"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:outlineProvider="background"
                    android:padding="8dp">

                    <FrameLayout
                        android:id="@+id/cover"
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/ivIcon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:alpha="0.9"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:tint="@color/white" />

                        <TextView
                            android:id="@+id/tvStatus"
                            style="@style/Widget.EventApp.User.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="10dp" />

                        <TextView
                            android:id="@+id/tvDate"
                            style="@style/Widget.EventApp.User.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_user_pill_glass"
                            android:textColor="@color/white" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.EventApp.User.CardTitle"
                            android:textSize="17sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_user_pin"
                                android:tint="@color/user_text_dim" />

                            <TextView
                                android:id="@+id/tvVenue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textAppearance="@style/TextAppearance.EventApp.User.Caption" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_user_dashed" />

                        <com.eventapp.app.ui.common.view.DemoQrView
                            android:id="@+id/qrCode"
                            android:layout_width="212dp"
                            android:layout_height="212dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="18dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="10dp"
                            android:text="@string/user_ticket_code"
                            android:textAppearance="@style/TextAppearance.EventApp.User.Micro" />

                        <TextView
                            android:id="@+id/tvCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="0.12"
                            android:textColor="@color/user_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRefresh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.EventApp.User.Micro" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_user_soft_card"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="1dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_user_shield"
                                android:tint="@color/user_primary" />

                            <TextView
                                android:id="@+id/tvNote"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="@string/user_ticket_scan_note"
                                android:textAppearance="@style/TextAppearance.EventApp.User.Caption"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_user_card_20"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/user_ticket_type"
                            android:textAppearance="@style/TextAppearance.EventApp.User.Caption" />

                        <TextView
                            android:id="@+id/tvType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/user_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/user_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/user_ticket_quantity"
                            android:textAppearance="@style/TextAppearance.EventApp.User.Caption" />

                        <TextView
                            android:id="@+id/tvQuantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="@color/user_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/user_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/user_ticket_time"
                            android:textAppearance="@style/TextAppearance.EventApp.User.Caption" />

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.6"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:gravity="end"
                            android:textColor="@color/user_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/user_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/user_ticket_venue"
                            android:textAppearance="@style/TextAppearance.EventApp.User.Caption" />

                        <TextView
                            android:id="@+id/tvFullVenue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.6"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:gravity="end"
                            android:textColor="@color/user_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCalendar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_user_btn_secondary"
                        android:drawableStart="@drawable/ic_user_calendar"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/user_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="center"
                        android:maxHeight="50dp"
                        android:minHeight="50dp"
                        android:stateListAnimator="@null"
                        android:text="@string/user_add_calendar"
                        android:textAllCaps="false"
                        android:textColor="@color/user_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnShareEvent"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_user_btn_secondary"
                        android:drawableStart="@drawable/ic_user_share"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/user_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="center"
                        android:maxHeight="50dp"
                        android:minHeight="50dp"
                        android:stateListAnimator="@null"
                        android:text="@string/user_share_ticket"
                        android:textAllCaps="false"
                        android:textColor="@color/user_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
