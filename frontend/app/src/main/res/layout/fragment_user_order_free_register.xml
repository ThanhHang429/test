<?xml version="1.0" encoding="utf-8"?>
<!-- FR-U09 FreeRegister: đăng ký vé miễn phí và nhận vé điện tử ngay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollFreeRegister"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutFreeRegisterContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/ds_space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_top_bar_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_4"
                android:paddingEnd="@dimen/ds_content_margin">

                <ImageButton
                    android:id="@+id/btnFreeRegisterBack"
                    android:layout_width="@dimen/ds_touch_target"
                    android:layout_height="@dimen/ds_touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hc_order_back"
                    android:padding="@dimen/ds_space_12"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_back"
                    app:tint="@color/ds_text" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_4"
                    android:layout_weight="1"
                    android:text="@string/hc_freereg_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:background="@drawable/bg_ds_step_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_4">

                <TextView
                    android:id="@+id/tvOrderStep1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/hc_order_step_1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOrderStep2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/hc_order_step_2"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOrderStep3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/hc_order_step_3"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_16"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:background="@drawable/bg_ds_ai_hero"
                android:orientation="horizontal"
                android:padding="@dimen/ds_space_20">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_ds_circle_primary">

                    <ImageView
                        android:layout_width="@dimen/ds_icon_32"
                        android:layout_height="@dimen/ds_icon_32"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_ticket"
                        app:tint="@color/ds_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_freereg_hero_title"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.H2"
                        android:textColor="@color/ds_white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_6"
                        android:alpha="0.88"
                        android:text="@string/hc_freereg_hero_message"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                        android:textColor="@color/ds_white" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_16"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="56dp"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_ds_date_tile"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvFreeRegisterDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.H2"
                                android:textColor="@color/ds_primary"
                                tools:text="31" />

                            <TextView
                                android:id="@+id/tvFreeRegisterMonth"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.LabelSmall"
                                android:textColor="@color/ds_primary"
                                tools:text="THG 10" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvFreeRegisterEventTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                                tools:text="Ngày hội Công nghệ mở 2026" />

                            <TextView
                                android:id="@+id/tvFreeRegisterEventVenue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_4"
                                android:drawableStart="@drawable/ic_ds_location"
                                android:drawablePadding="@dimen/ds_space_4"
                                android:drawableTint="@color/ds_outline"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                android:textSize="11sp"
                                tools:text="Trung tâm Hội nghị Quốc gia • Hà Nội" />

                            <TextView
                                android:id="@+id/tvFreeRegisterEventDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_2"
                                android:drawableStart="@drawable/ic_ds_clock"
                                android:drawablePadding="@dimen/ds_space_4"
                                android:drawableTint="@color/ds_outline"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                android:textSize="11sp"
                                tools:text="08:30 • 31/10/2026" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_16"
                        android:layout_marginBottom="@dimen/ds_space_12"
                        android:background="@color/ds_outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/hc_freereg_ticket_name"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_2"
                                android:text="@string/hc_freereg_ticket_note"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                        </LinearLayout>

                        <com.eventapp.app.ui.common.view.StatusChip
                            android:id="@+id/chipFreeRegisterTicket"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_12"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_16">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_freereg_quantity"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:id="@+id/tvFreeRegisterQuantityHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                            tools:text="Mỗi tài khoản được đăng ký tối đa 2 vé." />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnFreeRegisterMinus"
                            android:layout_width="@dimen/ds_touch_target"
                            android:layout_height="@dimen/ds_touch_target"
                            android:background="@drawable/bg_ds_quantity_button"
                            android:contentDescription="@string/hc_checkout_decrease"
                            android:padding="@dimen/ds_space_12"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_ds_minus"
                            app:tint="@color/ds_text" />

                        <TextView
                            android:id="@+id/tvFreeRegisterQuantity"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                            tools:text="1" />

                        <ImageButton
                            android:id="@+id/btnFreeRegisterPlus"
                            android:layout_width="@dimen/ds_touch_target"
                            android:layout_height="@dimen/ds_touch_target"
                            android:background="@drawable/bg_ds_quantity_button"
                            android:contentDescription="@string/hc_checkout_increase"
                            android:padding="@dimen/ds_space_12"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_ds_add"
                            app:tint="@color/ds_text" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.eventapp.app.ui.common.view.SectionHeaderView
                android:id="@+id/headerFreeRegisterAttendee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_section_gap"
                android:layout_marginEnd="@dimen/ds_content_margin"
                tools:title="Thông tin người tham dự" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_8"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutFreeRegisterName"
                        style="@style/Widget.EventApp.Ds.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hc_checkout_name"
                        app:startIconDrawable="@drawable/ic_ds_person"
                        app:startIconTint="@color/ds_text_muted">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputFreeRegisterName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="name"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:textColor="@color/ds_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutFreeRegisterEmail"
                        style="@style/Widget.EventApp.Ds.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:hint="@string/hc_checkout_email"
                        app:startIconDrawable="@drawable/ic_ds_mail"
                        app:startIconTint="@color/ds_text_muted">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputFreeRegisterEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="@color/ds_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutFreeRegisterPhone"
                        style="@style/Widget.EventApp.Ds.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:hint="@string/hc_checkout_phone"
                        app:startIconDrawable="@drawable/ic_ds_phone"
                        app:startIconTint="@color/ds_text_muted">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputFreeRegisterPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="phone"
                            android:imeOptions="actionDone"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:textColor="@color/ds_text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.eventapp.app.ui.common.view.SectionHeaderView
                android:id="@+id/headerFreeRegisterSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_section_gap"
                android:layout_marginEnd="@dimen/ds_content_margin"
                tools:title="Xác nhận đăng ký" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_8"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFreeRegisterSummaryLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                            android:textColor="@color/ds_text_muted"
                            tools:text="1 vé miễn phí" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_freereg_free"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            android:textColor="@color/ds_success_dark" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginBottom="@dimen/ds_space_12"
                        android:background="@color/ds_outline_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_freereg_total"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_freereg_free"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H2"
                            android:textColor="@color/ds_success_dark" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_12"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_12">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkFreeRegisterTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/ds_primary"
                        android:minHeight="@dimen/ds_touch_target"
                        android:text="@string/hc_freereg_terms"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />

                    <TextView
                        android:id="@+id/tvFreeRegisterTermsError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:text="@string/hc_freereg_terms_required"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        android:textColor="@color/ds_danger"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.eventapp.app.ui.common.view.EmptyStateView
        android:id="@+id/emptyFreeRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutFreeRegisterBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_ds_bottom_bar"
        android:elevation="@dimen/ds_elevation_sheet"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_content_margin"
        android:paddingTop="@dimen/ds_space_12"
        android:paddingEnd="@dimen/ds_content_margin"
        android:paddingBottom="@dimen/ds_space_12">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_freereg_total"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_freereg_free"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                android:textColor="@color/ds_success_dark" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFreeRegisterConfirm"
            style="@style/Widget.EventApp.Ds.Button.Cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:minWidth="168dp"
            android:text="@string/hc_freereg_action" />
    </LinearLayout>
</FrameLayout>
