<?xml version="1.0" encoding="utf-8"?>
<!-- O06 AI viết mô tả: điều kiện (giọng/độ dài/số phương án), tab phương án, preview, cảnh báo hậu kiểm. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_space_16">

        <ImageButton
            android:id="@+id/btnAiDescBack"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hc_aidesc_back"
            android:padding="@dimen/ds_space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ds_back"
            app:tint="@color/ds_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_aidesc_title"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <TextView
                android:id="@+id/tvAiDescSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_aidesc_timeout_note"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/ds_space_24">

            <!-- Điều kiện -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Ds.Card.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_8"
                android:layout_marginEnd="@dimen/ds_content_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_aidesc_conditions"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:text="@string/hc_aidesc_conditions_hint"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:text="@string/hc_aidesc_tone"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAiTone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_6"
                        app:chipSpacingHorizontal="@dimen/ds_space_6"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAiToneProfessional"
                            style="@style/Widget.EventApp.Organizer.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/hc_aidesc_tone_professional" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAiToneFriendly"
                            style="@style/Widget.EventApp.Organizer.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_aidesc_tone_friendly" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAiToneFormal"
                            style="@style/Widget.EventApp.Organizer.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_aidesc_tone_formal" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:text="@string/hc_aidesc_length"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAiLength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_6"
                        app:chipSpacingHorizontal="@dimen/ds_space_6"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAiLengthShort"
                            style="@style/Widget.EventApp.Organizer.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_aidesc_length_short" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAiLengthMedium"
                            style="@style/Widget.EventApp.Organizer.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/hc_aidesc_length_medium" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAiLengthLong"
                            style="@style/Widget.EventApp.Organizer.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_aidesc_length_long" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:text="@string/hc_aidesc_variants"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupAiVariants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_6"
                        app:chipSpacingHorizontal="@dimen/ds_space_6"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAiVariant1"
                            style="@style/Widget.EventApp.Organizer.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/hc_aidesc_variant_1" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAiVariant2"
                            style="@style/Widget.EventApp.Organizer.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_aidesc_variant_2" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAiVariant3"
                            style="@style/Widget.EventApp.Organizer.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_aidesc_variant_3" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Trạng thái yêu cầu -->
            <LinearLayout
                android:id="@+id/layoutAiDescStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_12"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAiDescStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hc_aidesc_status_idle"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    tools:text="Đang tạo mô tả…" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressAiDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_4"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/ds_organizer"
                app:trackColor="@color/ds_organizer_soft"
                tools:visibility="visible" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabsAiDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@color/ds_surface"
                android:visibility="gone"
                app:tabGravity="center"
                app:tabMode="fixed"
                tools:visibility="visible" />

            <!-- Xem trước -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiDescPreview"
                style="@style/Widget.EventApp.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_8"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.eventapp.app.ui.common.view.AiBadge
                            android:id="@+id/badgeAiDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_8"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/hc_aidesc_preview_label"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.LabelSmall" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAiDescPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                        android:textIsSelectable="true"
                        tools:text="Sự kiện được tổ chức theo hình thức trực tiếp…" />

                    <TextView
                        android:id="@+id/tvAiDescSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        tools:text="Tóm tắt: …" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:text="@string/hc_aidesc_disclaimer"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        android:textColor="@color/ds_text_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cảnh báo hậu kiểm -->
            <LinearLayout
                android:id="@+id/cardAiDescWarnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_8"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:background="@drawable/bg_ds_error_soft"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_12"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_aidesc_warnings_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textColor="@color/ds_danger_dark" />

                <LinearLayout
                    android:id="@+id/layoutAiDescWarnings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Thông tin còn thiếu -->
            <LinearLayout
                android:id="@+id/cardAiDescMissing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_8"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:background="@drawable/bg_ds_warning_soft"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_12"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_aidesc_missing_card_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textColor="@color/ds_warning_dark" />

                <LinearLayout
                    android:id="@+id/layoutAiDescMissing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Lỗi / từ chối / hết quota -->
            <LinearLayout
                android:id="@+id/cardAiDescError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_8"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:background="@drawable/bg_ds_error_soft"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_12"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvAiDescErrorTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textColor="@color/ds_danger_dark"
                    tools:text="Không tạo được mô tả" />

                <TextView
                    android:id="@+id/tvAiDescErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_danger_dark"
                    tools:text="Không tạo được mô tả, bạn vẫn có thể nhập tay." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiDescRetry"
                    style="@style/Widget.EventApp.Organizer.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:text="@string/hc_aidesc_error_retry"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAiDescEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_content_margin"
                android:layout_marginTop="@dimen/ds_space_16"
                android:layout_marginEnd="@dimen/ds_content_margin"
                android:gravity="center"
                android:text="@string/hc_aidesc_empty"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                android:textColor="@color/ds_text_muted"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Hành động: đang tạo thì vùng dưới chuyển thành Hủy + tiến trình -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_content_margin"
        android:paddingTop="@dimen/ds_space_12"
        android:paddingEnd="@dimen/ds_content_margin"
        android:paddingBottom="@dimen/ds_space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAiDescUndo"
                style="@style/Widget.EventApp.Organizer.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/hc_aidesc_undo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAiDescRegenerate"
                style="@style/Widget.EventApp.Organizer.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_8"
                android:layout_weight="1"
                android:text="@string/hc_aidesc_generate" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAiDescUse"
            style="@style/Widget.EventApp.Organizer.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:enabled="false"
            android:text="@string/hc_aidesc_use" />
    </LinearLayout>
</LinearLayout>