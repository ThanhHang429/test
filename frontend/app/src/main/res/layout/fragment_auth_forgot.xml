<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/auth_screen_pad"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/auth_screen_pad"
        android:paddingBottom="24dp">

        <include
            android:id="@+id/topBar"
            layout="@layout/view_auth_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_top_bar" />

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="36dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_auth_glow_green" />

            <ImageView
                android:layout_width="@dimen/auth_logo_tile"
                android:layout_height="@dimen/auth_logo_tile"
                android:layout_gravity="center"
                android:background="@drawable/bg_auth_hero_circle"
                android:contentDescription="@string/auth_cd_logo"
                android:padding="20dp"
                android:src="@drawable/ic_auth_key"
                android:tint="@color/auth_mint" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/auth_forgot_title"
            android:textAppearance="@style/TextAppearance.EventApp.Auth.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/auth_forgot_subtitle"
            android:textAppearance="@style/TextAppearance.EventApp.Auth.Subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_auth_glass"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_input_height">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etEmail"
                    style="@style/Widget.EventApp.Auth.Input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="emailAddress"
                    android:hint="@string/auth_email_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

                <ImageView
                    android:layout_width="@dimen/auth_icon_sm"
                    android:layout_height="@dimen/auth_icon_sm"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_auth_mail"
                    android:tint="@color/auth_text_dim" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/auth_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSend"
                style="@style/Widget.EventApp.Auth.Cta"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_cta_height"
                android:layout_marginTop="16dp"
                android:drawableEnd="@drawable/ic_auth_arrow_right"
                android:drawablePadding="10dp"
                android:drawableTint="@color/white"
                android:text="@string/auth_send_code" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBackLogin"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/ic_auth_back"
            android:drawablePadding="6dp"
            android:drawableTint="@color/auth_mint"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/auth_back_login"
            android:textAppearance="@style/TextAppearance.EventApp.Auth.Link" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
