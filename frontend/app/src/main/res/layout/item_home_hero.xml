<?xml version="1.0" encoding="utf-8"?>
<!-- Card hero (băng chuyền đầu trang Khám phá) theo thiết kế Stitch. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="236dp"
    android:layout_marginStart="@dimen/ds_content_margin"
    android:layout_marginEnd="@dimen/ds_content_margin"
    app:cardBackgroundColor="@color/ds_surface_container_low"
    app:cardCornerRadius="@dimen/ds_radius_16"
    app:cardElevation="@dimen/ds_elevation_card"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivEventCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_scrim" />

        <!-- Hàng trên: badge trạng thái + lưu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_12"
            android:paddingTop="@dimen/ds_space_12"
            android:paddingEnd="@dimen/ds_space_12">

            <com.eventapp.app.ui.common.view.StatusChip
                android:id="@+id/chipEventStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="Sắp hết vé"
                tools:visibility="visible" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnEventFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_hero_icon_circle"
                android:contentDescription="@string/hc_event_favorite_add"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ds_heart"
                app:tint="@color/ds_text" />
        </LinearLayout>

        <!-- Nội dung dưới -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_space_16"
            android:paddingEnd="@dimen/ds_space_16"
            android:paddingBottom="@dimen/ds_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_clock"
                    app:tint="@color/ds_surface_container_high" />

                <TextView
                    android:id="@+id/tvEventTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_6"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_surface_container_high"
                    android:textStyle="bold"
                    tools:text="28/11/2025 • 08:30" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ds_white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:fontFamily="@font/plus_jakarta_sans"
                tools:text="Vietnam AI &amp; Tech Summit 2025" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_location"
                    app:tint="@color/ds_surface_container_high" />

                <TextView
                    android:id="@+id/tvEventLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_6"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_surface_container_high"
                    tools:text="Trung tâm Hội nghị SECC, Quận 7" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_home_hero_price_label"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp"
                        app:fontFamily="@font/plus_jakarta_sans" />

                    <com.eventapp.app.ui.common.view.PriceTextView
                        android:id="@+id/tvEventPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ds_white"
                        android:textSize="18sp"
                        tools:text="Từ 450.000 đ" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_hero_cta"
                    android:gravity="center"
                    android:paddingStart="@dimen/ds_space_16"
                    android:paddingEnd="@dimen/ds_space_16"
                    android:text="@string/hc_home_hero_cta"
                    android:textColor="@color/ds_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
