<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_org_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_org_circle_button"
            android:contentDescription="@string/org_cd_back"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_auth_back"
            android:tint="@color/org_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="@string/org_create_title"
            android:textColor="@color/org_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveDraftTop"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/org_save_draft"
            android:textColor="@color/org_primary_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/org_gutter"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/org_gutter"
            android:paddingBottom="20dp">

            <!-- Bước -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_org_chip_active"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@color/org_border" />

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_org_pill_primary"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/org_primary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@color/org_border" />

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_org_pill_primary"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/org_primary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/org_create_step"
                android:textColor="@color/org_text_dim"
                android:textSize="11sp" />

            <!-- Form -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.Org.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/org_create_name"
                        android:textColor="@color/org_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etEventName"
                        style="@style/Widget.EventApp.Org.Input"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/org_control_height"
                        android:layout_marginTop="6dp"
                        android:hint="@string/org_create_name_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/org_create_category"
                        android:textColor="@color/org_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_org_chip_active"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="Công nghệ"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_org_chip"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="Giáo dục"
                            android:textColor="@color/org_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_org_chip"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="Kinh doanh"
                            android:textColor="@color/org_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/org_create_desc"
                        android:textColor="@color/org_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etEventDesc"
                        style="@style/Widget.EventApp.Org.Input"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:layout_marginTop="6dp"
                        android:gravity="top|start"
                        android:hint="@string/org_create_desc_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:paddingTop="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/org_create_place"
                        android:textColor="@color/org_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etEventPlace"
                        style="@style/Widget.EventApp.Org.Input"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/org_control_height"
                        android:layout_marginTop="6dp"
                        android:hint="@string/org_create_place_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="@string/org_create_time"
                                android:textColor="@color/org_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/etEventTime"
                                style="@style/Widget.EventApp.Org.Input"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/org_control_height"
                                android:layout_marginTop="6dp"
                                android:hint="15/11/2025 · 09:00"
                                android:inputType="text"
                                android:maxLines="1" />
                        </LinearLayout>

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="@string/org_create_capacity"
                                android:textColor="@color/org_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/etEventCapacity"
                                style="@style/Widget.EventApp.Org.Input"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/org_control_height"
                                android:layout_marginTop="6dp"
                                android:hint="2.000"
                                android:inputType="number"
                                android:maxLines="1" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_org_card_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ds_info"
                    android:tint="@color/org_primary_dark" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="Bạn có thể lưu nháp và hoàn thiện hạng vé ở bước sau."
                    android:textColor="@color/org_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/org_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/org_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/org_gutter"
        android:paddingEnd="@dimen/org_gutter">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/Widget.EventApp.Org.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/org_control_height"
            android:drawableEnd="@drawable/ic_auth_arrow_right"
            android:drawablePadding="8dp"
            android:drawableTint="@color/white"
            android:text="@string/org_continue" />
    </LinearLayout>
</LinearLayout>
