<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/admin_gutter"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/admin_gutter">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="0.14"
                    android:text="@string/admin_bc_kicker"
                    android:textColor="@color/admin_accent_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/admin_bc_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.Display" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/admin_bc_sub"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.Body" />
            </LinearLayout>

            <!-- Đối tượng nhận -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_bc_audience"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAudienceAll"
                        style="@style/Widget.EventApp.Admin.FilterChip"
                        android:text="@string/admin_bc_audience_all" />

                    <TextView
                        android:id="@+id/chipAudienceUser"
                        style="@style/Widget.EventApp.Admin.FilterChip"
                        android:text="@string/admin_bc_audience_user" />

                    <TextView
                        android:id="@+id/chipAudienceOrg"
                        style="@style/Widget.EventApp.Admin.FilterChip"
                        android:text="@string/admin_bc_audience_org" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_admin_stat_cell"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="9dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ds_users"
                        android:tint="@color/admin_accent_dark" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/admin_bc_reach"
                        android:textColor="@color/admin_text_dim"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvBroadcastReach"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/admin_bc_reach_value"
                        android:textColor="@color/admin_text"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Kênh gửi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_bc_channels"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipChannelInApp"
                        style="@style/Widget.EventApp.Admin.FilterChip"
                        android:text="@string/admin_bc_channel_inapp" />

                    <TextView
                        android:id="@+id/chipChannelPush"
                        style="@style/Widget.EventApp.Admin.FilterChip"
                        android:text="@string/admin_bc_channel_push" />

                    <TextView
                        android:id="@+id/chipChannelEmail"
                        style="@style/Widget.EventApp.Admin.FilterChip"
                        android:text="@string/admin_bc_channel_email" />
                </LinearLayout>
            </LinearLayout>

            <!-- Nội dung -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_bc_title_label"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.Label" />

                <EditText
                    android:id="@+id/etBroadcastTitle"
                    style="@style/Widget.EventApp.Admin.Input"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/admin_control_height"
                    android:layout_marginTop="8dp"
                    android:hint="@string/admin_bc_title_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLength="80"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/admin_bc_message"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.Label" />

                <EditText
                    android:id="@+id/etBroadcastMessage"
                    style="@style/Widget.EventApp.Admin.Input"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginTop="8dp"
                    android:gravity="top|start"
                    android:hint="@string/admin_bc_message_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />
            </LinearLayout>

            <!-- Thời gian gửi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_bc_schedule"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipScheduleNow"
                        style="@style/Widget.EventApp.Admin.FilterChip"
                        android:text="@string/admin_bc_now" />

                    <TextView
                        android:id="@+id/chipScheduleLater"
                        style="@style/Widget.EventApp.Admin.FilterChip"
                        android:text="@string/admin_bc_later" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBroadcastSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/admin_bc_schedule_time"
                    android:textColor="@color/admin_text_dim"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Xem trước -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_card_soft"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="0.12"
                    android:text="@string/admin_bc_preview"
                    android:textColor="@color/admin_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_admin_logo_tile">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_user_bell"
                            android:tint="@color/white" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvBroadcastPreviewTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:maxLines="1"
                            android:text="@string/admin_bc_preview_title"
                            android:textColor="@color/admin_text"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBroadcastPreviewBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:maxLines="2"
                            android:text="@string/admin_bc_preview_body"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:fontFamily="@font/be_vietnam_pro"
                android:lineSpacingExtra="2dp"
                android:text="@string/admin_bc_note"
                android:textColor="@color/admin_text_faint"
                android:textSize="12.5sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/broadcastBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_admin_bottom_bar"
        android:orientation="horizontal"
        android:paddingStart="@dimen/admin_gutter"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/admin_gutter"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/btnBroadcastSend"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_admin_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_admin_send"
                android:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/admin_bc_send"
                android:textColor="@color/white"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
