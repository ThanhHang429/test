<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/org_gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/org_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/org_events_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Org.Headline" />

                <TextView
                    android:id="@+id/tvEventsSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/org_events_sub"
                    android:textAppearance="@style/TextAppearance.EventApp.Org.Caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateEvent"
                style="@style/Widget.EventApp.Org.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:drawableStart="@drawable/ic_user_plus"
                android:drawablePadding="6dp"
                android:drawableTint="@color/white"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/org_create_event"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_org_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_search"
                android:tint="@color/org_text_dim" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSearchEvent"
                style="@style/Widget.EventApp.Org.Search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/org_search_events"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btnFilterEvent"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_org_btn_primary"
                android:contentDescription="@string/org_cd_filter"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_user_tune"
                android:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/org_gutter"
        android:paddingEnd="@dimen/org_gutter"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                style="@style/Widget.EventApp.Org.FilterChip"
                android:text="@string/org_filter_all" />

            <TextView
                android:id="@+id/chipOnSale"
                style="@style/Widget.EventApp.Org.FilterChip"
                android:text="@string/org_filter_on_sale" />

            <TextView
                android:id="@+id/chipPending"
                style="@style/Widget.EventApp.Org.FilterChip"
                android:text="@string/org_filter_pending" />

            <TextView
                android:id="@+id/chipDraft"
                style="@style/Widget.EventApp.Org.FilterChip"
                android:text="@string/org_filter_draft" />

            <TextView
                android:id="@+id/chipEnded"
                style="@style/Widget.EventApp.Org.FilterChip"
                android:text="@string/org_filter_ended" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEvents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/org_gutter"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/org_gutter"
            android:paddingBottom="20dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvEventsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/org_events_empty"
            android:textAppearance="@style/TextAppearance.EventApp.Org.Body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/org_primary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
