<?xml version="1.0" encoding="utf-8"?>
<!-- U07: màn Xem tất cả gợi ý. Lỗi/chậm ở đây không được chặn màn hình khám phá. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_space_8">

        <ImageButton
            android:id="@+id/btnRecBack"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hc_rec_back"
            android:padding="@dimen/ds_space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ds_back"
            app:tint="@color/ds_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_weight="1"
            android:text="@string/hc_rec_title"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

        <ImageButton
            android:id="@+id/btnRecRefresh"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hc_rec_refresh"
            android:padding="@dimen/ds_space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ds_refresh"
            app:tint="@color/ds_primary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshRecommend"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollRecommend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/ds_space_24">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.EventApp.Ds.Card.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:layout_marginEnd="@dimen/ds_content_margin">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/ds_space_16">

                            <com.eventapp.app.ui.common.view.AiBadge
                                android:id="@+id/aiBadgeRecommend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/tvRecTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_12"
                                android:text="@string/hc_rec_personalized_title"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

                            <TextView
                                android:id="@+id/tvRecMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_4"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                tools:text="Tạo lúc 10:42 • 5 gợi ý" />

                            <TextView
                                android:id="@+id/tvRecFallback"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_space_8"
                                android:background="@drawable/bg_ds_info_soft"
                                android:padding="@dimen/ds_space_8"
                                android:text="@string/hc_rec_fallback"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                                android:textColor="@color/ds_info_dark"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerRecPrefs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginEnd="@dimen/ds_space_12" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupRecPrefs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingEnd="@dimen/ds_content_margin"
                        app:chipSpacingHorizontal="@dimen/ds_space_8"
                        app:chipSpacingVertical="@dimen/ds_space_4" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecommend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingEnd="@dimen/ds_content_margin" />

                    <TextView
                        android:id="@+id/tvRecFooter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginEnd="@dimen/ds_content_margin"
                        android:gravity="center"
                        android:text="@string/hc_rec_footer"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.eventapp.app.ui.common.view.SkeletonLayout
            android:id="@+id/skeletonRecommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:padding="@dimen/ds_content_margin"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginBottom="@dimen/ds_space_12"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="@dimen/ds_space_12"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_skeleton_height"
                android:background="@drawable/bg_ds_skeleton" />
        </com.eventapp.app.ui.common.view.SkeletonLayout>

        <com.eventapp.app.ui.common.view.EmptyStateView
            android:id="@+id/emptyRecommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.eventapp.app.ui.common.view.ErrorStateView
            android:id="@+id/errorRecommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
