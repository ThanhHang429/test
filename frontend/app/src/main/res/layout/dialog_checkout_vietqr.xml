<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:gravity="center"
            android:text="Chuyển khoản VietQR"
            android:textColor="@color/user_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:text="Mở ứng dụng ngân hàng bất kỳ để quét mã thanh toán"
            android:textColor="@color/user_text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/layoutExpiryBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_user_badge_warning"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/tvExpiryCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Giữ chỗ vé còn: 15:00"
                android:textColor="@color/user_warning_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Mã VietQR"
                android:scaleType="fitCenter" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/btnSaveQr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:padding="8dp"
            android:text="📥 Lưu ảnh mã QR vào máy"
            android:textColor="@color/user_primary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_auth_input"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Ngân hàng:"
                    android:textColor="@color/user_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvBankName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:text="ACB"
                    android:textColor="@color/user_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Chủ tài khoản:"
                    android:textColor="@color/user_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAccountName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:text="CONG TY ETICKET"
                    android:textColor="@color/user_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Số tài khoản:"
                    android:textColor="@color/user_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAccountNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:text="190368688888"
                    android:textColor="@color/user_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnCopyAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_user_badge_primary"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Sao chép"
                    android:textColor="@color/user_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Số tiền:"
                    android:textColor="@color/user_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:textColor="@color/user_primary"
                    android:textSize="14sp"
                    tools:text="300.000 đ" />

                <TextView
                    android:id="@+id/btnCopyAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_user_badge_primary"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Sao chép"
                    android:textColor="@color/user_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Nội dung CK:"
                    android:textColor="@color/user_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTransferCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:textColor="@color/user_text"
                    android:textSize="13sp"
                    tools:text="ETK123456" />

                <TextView
                    android:id="@+id/btnCopyCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_user_badge_primary"
                    android:fontFamily="@font/plus_jakarta_sans_medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Sao chép"
                    android:textColor="@color/user_primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCheckingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_user_badge_success"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="● Đang kết nối Realtime (SSE)..."
                android:textColor="@color/user_success_text"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressConfirming"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tvQrStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Hệ thống sẽ tự động cập nhật ngay khi ngân hàng xác nhận chuyển khoản."
                    android:textColor="@color/user_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualConfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/user_primary"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="Kiểm tra trạng thái ngay"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimulateWebhook"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:text="⚡ Giả lập Webhook ngân hàng (Dev)"
            android:textColor="@color/user_primary"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPayLater"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:text="Thanh toán sau (Lưu vào Đơn chờ)"
            android:textColor="@color/user_text_muted"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/user_border" />

    </LinearLayout>
</ScrollView>