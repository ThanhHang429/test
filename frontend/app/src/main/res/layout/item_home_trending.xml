<?xml version="1.0" encoding="utf-8"?>
<!-- Card dọc lớn cho mục "Thịnh hành tuần này" theo thiết kế Stitch. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ds_space_12"
    app:cardBackgroundColor="@color/ds_surface"
    app:cardCornerRadius="@dimen/ds_radius_16"
    app:cardElevation="0dp"
    app:strokeColor="@color/ds_outline_variant"
    app:strokeWidth="@dimen/ds_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="176dp">

            <ImageView
                android:id="@+id/ivEventCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <com.eventapp.app.ui.common.view.StatusChip
                android:id="@+id/chipEventStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/ds_space_12"
                android:visibility="gone"
                tools:text="Sắp hết vé"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/btnEventFavorite"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/ds_space_12"
                android:background="@drawable/bg_hero_icon_circle"
                android:contentDescription="@string/hc_event_favorite_add"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ds_heart"
                app:tint="@color/ds_text" />

            <TextView
                android:id="@+id/tvEventCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/ds_space_12"
                android:background="@drawable/bg_chip_on_image"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingTop="@dimen/ds_space_2"
                android:paddingEnd="@dimen/ds_space_8"
                android:paddingBottom="@dimen/ds_space_2"
                android:textColor="@color/ds_text"
                android:textSize="11sp"
                android:textStyle="bold"
                app:fontFamily="@font/plus_jakarta_sans"
                tools:text="Âm nhạc" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEventTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_primary"
                    android:textStyle="bold"
                    tools:text="Thứ Bảy, 19:30 • 29/11/2025" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_home_trending_best_seller"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_danger" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                tools:text="Đêm Nhạc Acoustic: Những Bản Tình Ca" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_location"
                    app:tint="@color/ds_text_muted" />

                <TextView
                    android:id="@+id/tvEventLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_4"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    tools:text="Nhà hát Bến Thành, Quận 1, TP. Hồ Chí Minh" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/ds_space_12"
                android:background="@color/ds_outline_variant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_home_hero_price_label"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                        android:textColor="@color/ds_text_muted" />

                    <com.eventapp.app.ui.common.view.PriceTextView
                        android:id="@+id/tvEventPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        tools:text="Từ 299.000 đ" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_ds_pill_primary"
                    android:gravity="center"
                    android:paddingStart="@dimen/ds_space_16"
                    android:paddingEnd="@dimen/ds_space_16"
                    android:text="@string/hc_home_trending_cta"
                    android:textColor="@color/ds_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
