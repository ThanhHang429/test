<?xml version="1.0" encoding="utf-8"?>
<!-- U06: tab Đã lưu. Nhắc nhở, bộ lọc Sắp diễn ra/Đã kết thúc, danh sách + gợi ý mở rộng. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_space_16">

        <ImageButton
            android:id="@+id/btnFavBack"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hc_fav_back"
            android:padding="@dimen/ds_space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ds_back"
            app:tint="@color/ds_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_fav_title"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

            <TextView
                android:id="@+id/tvFavCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                tools:text="3 sự kiện đã lưu" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.EventApp.Ds.Card.Soft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_content_margin"
        android:layout_marginEnd="@dimen/ds_content_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/ds_space_12">

            <ImageView
                android:layout_width="@dimen/ds_icon_24"
                android:layout_height="@dimen/ds_icon_24"
                android:contentDescription="@null"
                android:src="@drawable/ic_ds_notifications"
                app:tint="@color/ds_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_fav_alerts_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:maxLines="2"
                    android:text="@string/hc_fav_alerts_desc"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchFavAlerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_8"
                android:checked="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_12"
        android:clipToPadding="false"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFavFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingEnd="@dimen/ds_content_margin"
            app:chipSpacingHorizontal="@dimen/ds_space_8"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFavAll"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/hc_fav_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFavUpcoming"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hc_fav_filter_upcoming" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFavPast"
                style="@style/Widget.EventApp.Ds.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hc_fav_filter_past" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshFavorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollFavorites"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/ds_space_12"
                    android:paddingBottom="@dimen/ds_space_16">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFavorites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingEnd="@dimen/ds_content_margin" />

                    <com.eventapp.app.ui.common.view.SectionHeaderView
                        android:id="@+id/headerFavSuggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_content_margin"
                        android:layout_marginTop="@dimen/ds_space_12"
                        android:layout_marginEnd="@dimen/ds_space_12" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFavSuggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="@dimen/ds_content_margin"
                        android:paddingEnd="@dimen/ds_content_margin" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.eventapp.app.ui.common.view.SkeletonLayout
            android:id="@+id/skeletonFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:padding="@dimen/ds_content_margin"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_cover_height"
                android:layout_marginBottom="@dimen/ds_space_12"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_skeleton_height"
                android:layout_marginBottom="@dimen/ds_space_8"
                android:background="@drawable/bg_ds_skeleton" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_skeleton_height"
                android:layout_marginEnd="@dimen/ds_space_48"
                android:background="@drawable/bg_ds_skeleton" />
        </com.eventapp.app.ui.common.view.SkeletonLayout>

        <com.eventapp.app.ui.common.view.EmptyStateView
            android:id="@+id/emptyFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.eventapp.app.ui.common.view.ErrorStateView
            android:id="@+id/errorFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
