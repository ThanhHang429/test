<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eventRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_admin_surface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/eventTopBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/admin_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="@dimen/admin_gutter">

        <FrameLayout
            android:id="@+id/btnEventBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_admin_circle_button"
            android:clickable="true"
            android:contentDescription="@string/admin_cd_back"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_auth_back"
                android:tint="@color/admin_text" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="@string/admin_event_title"
            android:textColor="@color/admin_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_pill_neutral"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.06"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:text="#EVT-8842"
            android:textColor="@color/admin_text_muted"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="26dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_hero"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:outlineProvider="background">

                <View
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-70dp"
                    android:layout_marginEnd="-50dp"
                    android:background="@drawable/bg_admin_hero_glow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_admin_pill_glass"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="0.08"
                            android:paddingStart="9dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="4dp"
                            android:text="@string/admin_event_live"
                            android:textColor="#FF8FD9DC"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="Cập nhật 2 phút trước"
                            android:textColor="@color/admin_text_on_dark_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/admin_event_name"
                        android:textColor="@color/admin_text_on_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/admin_event_org"
                        android:textColor="@color/admin_text_on_dark_muted"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_user_clock"
                            android:tint="#FF8FA3BA" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="@string/admin_event_time"
                            android:textColor="@color/admin_text_on_dark_muted"
                            android:textSize="10.5sp" />

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginStart="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_user_pin"
                            android:tint="#FF8FA3BA" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:maxLines="1"
                            android:text="@string/admin_event_place"
                            android:textColor="@color/admin_text_on_dark_muted"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/admin_hero_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="@string/admin_event_sold"
                                android:textColor="@color/admin_text_on_dark"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="@string/admin_event_sold_label"
                                android:textColor="#FF8FA3BA"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="@string/admin_event_revenue"
                                android:textColor="@color/admin_text_on_dark"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="@string/admin_event_revenue_label"
                                android:textColor="#FF8FA3BA"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="@string/admin_event_checkin"
                                android:textColor="@color/admin_text_on_dark"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:text="@string/admin_event_checkin_label"
                                android:textColor="#FF8FA3BA"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Sức chứa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/admin_event_capacity"
                        android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_admin_pill_teal_outline"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="92%"
                        android:textColor="@color/admin_accent_dark"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="92"
                    android:progressDrawable="@drawable/progress_admin" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="1.840 / 2.000 vé"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Còn 160 vé"
                        android:textColor="@color/admin_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Rủi ro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_alert_box"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ds_warning"
                        android:tint="@color/admin_warning" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/admin_event_risk"
                        android:textColor="@color/admin_warning_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginStart="23dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/admin_event_risk_1"
                    android:textColor="@color/admin_warning_text"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="23dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/admin_event_risk_2"
                    android:textColor="@color/admin_warning_text"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Hành động -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hành động kiểm soát"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

                <TextView
                    android:id="@+id/btnPauseSale"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_admin_btn_danger"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:text="@string/admin_event_pause"
                    android:textColor="@color/admin_danger_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSendAlert"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_admin_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:text="@string/admin_event_alert"
                    android:textColor="@color/admin_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="Mọi thao tác đều được ghi vào nhật ký kiểm toán."
                    android:textColor="@color/admin_text_faint"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
