<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ds_space_4"
    android:paddingTop="@dimen/ds_space_8"
    android:paddingEnd="@dimen/ds_space_4"
    android:paddingBottom="@dimen/ds_space_8">

    <FrameLayout
        android:layout_width="@dimen/ds_icon_40"
        android:layout_height="@dimen/ds_icon_40"
        android:background="@drawable/bg_ds_avatar">

        <ImageView
            android:layout_width="@dimen/ds_icon_20"
            android:layout_height="@dimen/ds_icon_20"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_ds_person"
            app:tint="@color/ds_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAccountEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

        <TextView
            android:id="@+id/tvAccountRoles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/ds_icon_20"
        android:layout_height="@dimen/ds_icon_20"
        android:layout_marginStart="@dimen/ds_space_4"
        android:contentDescription="@null"
        android:src="@drawable/ic_ds_chevron_right"
        app:tint="@color/ds_outline" />
</LinearLayout>
