<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/admin_gutter"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/admin_gutter">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.14"
                android:text="GIÁM SÁT TRỰC TIẾP"
                android:textColor="@color/admin_accent_dark"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/admin_events_title"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/admin_events_sub"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.Body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:background="@drawable/bg_admin_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_search"
                android:tint="@color/admin_text_dim" />

            <EditText
                android:id="@+id/etEventSearch"
                style="@style/Widget.EventApp.Admin.Search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/admin_events_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_tune"
                android:tint="@color/admin_text_muted" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:paddingStart="@dimen/admin_gutter"
            android:paddingEnd="@dimen/admin_gutter"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipEventAll"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_events_filter_all" />

                <TextView
                    android:id="@+id/chipEventLive"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_events_filter_live" />

                <TextView
                    android:id="@+id/chipEventFlagged"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_events_filter_flagged" />

                <TextView
                    android:id="@+id/chipEventPaused"
                    style="@style/Widget.EventApp.Admin.FilterChip"
                    android:text="@string/admin_events_filter_paused" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/listEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
