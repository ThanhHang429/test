<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:id="@+id/navPill"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_user_nav_active"
        android:outlineProvider="background" />

    <LinearLayout
        android:id="@+id/navItems"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/tabDiscovery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/user_tab_discovery"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconDiscovery"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_explore"
                android:tint="@color/user_nav_inactive" />

            <TextView
                android:id="@+id/labelDiscovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:singleLine="true"
                android:text="@string/user_tab_discovery"
                android:textAppearance="@style/TextAppearance.EventApp.User.NavLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSaved"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/user_tab_saved"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconSaved"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_bookmark"
                android:tint="@color/user_nav_inactive" />

            <TextView
                android:id="@+id/labelSaved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:singleLine="true"
                android:text="@string/user_tab_saved"
                android:textAppearance="@style/TextAppearance.EventApp.User.NavLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabTickets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/user_tab_tickets"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconTickets"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_ticket"
                android:tint="@color/user_nav_inactive" />

            <TextView
                android:id="@+id/labelTickets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:singleLine="true"
                android:text="@string/user_tab_tickets"
                android:textAppearance="@style/TextAppearance.EventApp.User.NavLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/user_tab_calendar"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconCalendar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_calendar"
                android:tint="@color/user_nav_inactive" />

            <TextView
                android:id="@+id/labelCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:singleLine="true"
                android:text="@string/user_tab_calendar"
                android:textAppearance="@style/TextAppearance.EventApp.User.NavLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/user_tab_account"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconAccount"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user_person"
                android:tint="@color/user_nav_inactive" />

            <TextView
                android:id="@+id/labelAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:singleLine="true"
                android:text="@string/user_tab_account"
                android:textAppearance="@style/TextAppearance.EventApp.User.NavLabel" />
        </LinearLayout>
    </LinearLayout>
</merge>
