<?xml version="1.0" encoding="utf-8"?>
<!-- Một mốc trong dòng thời gian trạng thái đơn hàng. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="@dimen/ds_space_16"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/viewOrderStepDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/ds_space_4"
            android:background="@drawable/bg_ds_status_dot" />

        <View
            android:id="@+id/viewOrderStepConnector"
            android:layout_width="2dp"
            android:layout_height="@dimen/ds_space_24"
            android:layout_marginTop="@dimen/ds_space_4"
            android:background="@color/ds_outline_variant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_12"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="@dimen/ds_space_20">

        <TextView
            android:id="@+id/tvOrderStepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
            tools:text="Đơn hàng được tạo" />

        <TextView
            android:id="@+id/tvOrderStepNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
            tools:text="10:30, 31/10/2026" />
    </LinearLayout>
</LinearLayout>
