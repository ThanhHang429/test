<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/auth_screen_pad"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/auth_screen_pad"
        android:paddingBottom="24dp">

        <include
            android:id="@+id/topBar"
            layout="@layout/view_auth_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_top_bar" />

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_auth_glow_blue" />

            <ImageView
                android:layout_width="@dimen/auth_logo_tile"
                android:layout_height="@dimen/auth_logo_tile"
                android:layout_gravity="center"
                android:background="@drawable/bg_auth_logo_tile"
                android:contentDescription="@string/auth_cd_logo"
                android:padding="16dp"
                android:src="@drawable/ic_auth_logo" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/auth_login_title"
            android:textAppearance="@style/TextAppearance.EventApp.Auth.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/auth_seed_sub"
            android:textAppearance="@style/TextAppearance.EventApp.Auth.Subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_auth_glass"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_auth_shield"
                    android:tint="@color/auth_mint" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/auth_seed_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Auth.Caption"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/auth_seed_hint"
                    android:textColor="@color/auth_text_dim"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/accountList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:indeterminateTint="@color/auth_mint"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/auth_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRetry"
                style="@style/Widget.EventApp.Auth.Social"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_social_height"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="@string/auth_seed_retry"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
