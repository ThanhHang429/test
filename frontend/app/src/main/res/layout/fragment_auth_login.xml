<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_24"
        android:paddingTop="@dimen/ds_space_20"
        android:paddingEnd="@dimen/ds_space_24"
        android:paddingBottom="@dimen/ds_space_32">

        <include layout="@layout/view_auth_brand" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_24"
            android:background="@drawable/bg_ds_ai_hero"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="@string/auth_login_eyebrow"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.LabelSmall"
                android:textColor="@color/ds_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:text="@string/auth_login_title"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H1"
                android:textColor="@color/ds_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_6"
                android:alpha="0.86"
                android:text="@string/auth_login_subtitle"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                android:textColor="@color/ds_white" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EventApp.Ds.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_20"
            app:cardCornerRadius="@dimen/ds_radius_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_account_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:text="@string/auth_account_subtitle"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                <ProgressBar
                    android:id="@+id/progressAccounts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textAccountsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:textColor="@color/ds_admin_risk"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listDevAccounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryAccounts"
                    style="@style/Widget.EventApp.Ds.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:text="@string/auth_account_retry"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_20"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/ds_outline_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_12"
                android:layout_marginEnd="@dimen/ds_space_12"
                android:text="@string/auth_or"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/ds_outline_variant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_20"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auth_demo_title"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ds_pill_primary"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingTop="@dimen/ds_space_2"
                android:paddingEnd="@dimen/ds_space_8"
                android:paddingBottom="@dimen/ds_space_2"
                android:text="@string/auth_demo_badge"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.LabelSmall"
                android:textColor="@color/ds_white" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_4"
            android:text="@string/auth_demo_subtitle"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/groupQuickRoles"
            style="@style/Widget.EventApp.Ds.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            app:cardCornerRadius="@dimen/ds_radius_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowDemoUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/auth_cd_demo_user"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_12">

                    <FrameLayout
                        android:layout_width="@dimen/ds_icon_40"
                        android:layout_height="@dimen/ds_icon_40"
                        android:background="@drawable/bg_ds_avatar">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_20"
                            android:layout_height="@dimen/ds_icon_20"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_users"
                            app:tint="@color/ds_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_demo_user"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/auth_demo_user_desc"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_demo_open"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_primary" />

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:layout_marginStart="@dimen/ds_space_4"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_chevron_right"
                        app:tint="@color/ds_outline" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="64dp"
                    android:background="@color/ds_outline_variant" />

                <LinearLayout
                    android:id="@+id/rowDemoOrganizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/auth_cd_demo_organizer"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_12">

                    <FrameLayout
                        android:layout_width="@dimen/ds_icon_40"
                        android:layout_height="@dimen/ds_icon_40"
                        android:background="@drawable/bg_ds_avatar">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_20"
                            android:layout_height="@dimen/ds_icon_20"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_event"
                            app:tint="@color/ds_organizer" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_demo_organizer"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/auth_demo_organizer_desc"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_demo_open"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_organizer" />

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:layout_marginStart="@dimen/ds_space_4"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_chevron_right"
                        app:tint="@color/ds_outline" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="64dp"
                    android:background="@color/ds_outline_variant" />

                <LinearLayout
                    android:id="@+id/rowDemoAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="@string/auth_cd_demo_admin"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_12">

                    <FrameLayout
                        android:layout_width="@dimen/ds_icon_40"
                        android:layout_height="@dimen/ds_icon_40"
                        android:background="@drawable/bg_ds_avatar">

                        <ImageView
                            android:layout_width="@dimen/ds_icon_20"
                            android:layout_height="@dimen/ds_icon_20"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_lock"
                            app:tint="@color/ds_admin_risk" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_demo_admin"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/auth_demo_admin_desc"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_demo_open"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_admin_risk" />

                    <ImageView
                        android:layout_width="@dimen/ds_icon_20"
                        android:layout_height="@dimen/ds_icon_20"
                        android:layout_marginStart="@dimen/ds_space_4"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ds_chevron_right"
                        app:tint="@color/ds_outline" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_16"
            android:gravity="center"
            android:text="@string/auth_demo_banner"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
