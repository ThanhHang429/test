<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình EventMonitor: Giám sát sự kiện đang diễn ra và sự cố bất thường | FR-A08 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarEventMonitor"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ds_surface"
        android:layout_marginStart="@dimen/ds_content_margin"
        android:layout_marginTop="@dimen/ds_space_8"
        android:layout_marginEnd="@dimen/ds_content_margin"
        app:title="@string/hc_monitor_title"
        app:titleTextAppearance="@style/TextAppearance.EventApp.Ds.H3"
        app:subtitleTextAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_content_margin"
        android:layout_marginTop="@dimen/ds_space_8"
        android:layout_marginEnd="@dimen/ds_content_margin"
        android:orientation="vertical"
        android:layout_weight="1">

        <!-- Section: mạng mạng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewEventMonitorNet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hc_monitor_net"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                android:textColor="@color/ds_text"
                android:layout_marginBottom="@dimen/ds_space_4" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textViewEventMonitorCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_monitor_count"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_text"
                        android:layout_marginBottom="@dimen/ds_space_4" />

                    <TextView
                        android:id="@+id/textViewEventMonitorCountValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_monitor_count_value"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_text"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:layout_marginBottom="@dimen/ds_space_4" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/textViewEventMonitorType"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_monitor_type"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            android:textColor="@color/ds_text"
                            android:layout_marginRight="@dimen/ds_space_4" />

                        <TextView
                            android:id="@+id/textViewEventMonitorTypeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_monitor_type_value"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            android:textColor="@color/ds_text" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textViewEventMonitorRisk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_monitor_risk"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_text"
                        android:layout_marginBottom="@dimen/ds_space_4" />

                    <TextView
                        android:id="@+id/textViewEventMonitorRiskValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_monitor_risk_value"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_text"
                        android:layout_marginTop="@dimen/ds_space_4"
                        android:layout_marginBottom="@dimen/ds_space_4" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/ds_space_8">

                        <TextView
                            android:id="@+id/textViewEventMonitorSeverity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hc_monitor_severity"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            android:textColor="@color/ds_text"
                            android:layout_marginRight="@dimen/ds_space_4" />

                        <TextView
                            android:id="@+id/textViewEventMonitorSeverityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_monitor_severity_value"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            android:textColor="@color/ds_text" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Section: tổng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="@dimen/ds_space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewEventMonitorTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_monitor_total"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textColor="@color/ds_text"
                    android:layout_marginBottom="@dimen/ds_space_4" />

                <TextView
                    android:id="@+id/textViewEventMonitorTotalValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_monitor_total_value"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                    android:textColor="@color/ds_text"
                    android:layout_marginTop="@dimen/ds_space_4"
                    android:layout_marginBottom="@dimen/ds_space_4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textViewEventMonitorStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hc_monitor_status"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_text"
                        android:layout_marginRight="@dimen/ds_space_4" />

                    <TextView
                        android:id="@+id/textViewEventMonitorStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hc_monitor_status_value"
                        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                        android:textColor="@color/ds_text" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
