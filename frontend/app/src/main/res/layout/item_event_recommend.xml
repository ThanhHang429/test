<?xml version="1.0" encoding="utf-8"?>
<!-- U07: một thẻ gợi ý. Lý do do server trả, giá/ngày luôn từ dữ liệu chính thức. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.EventApp.Ds.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_card_gap"
    android:clickable="true"
    android:focusable="true"
    app:cardPreventCornerOverlap="true"
    app:rippleColor="@color/ds_primary_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_ds_card_soft">

            <ImageView
                android:id="@+id/ivRecCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_ds_event"
                app:tint="@color/ds_white" />

            <com.eventapp.app.ui.common.view.StatusChip
                android:id="@+id/chipRecStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/ds_space_12"
                android:visibility="gone"
                tools:text="Miễn phí"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_12">

            <com.eventapp.app.ui.common.view.AiBadge
                android:id="@+id/aiBadgeRec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvRecEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_6"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                tools:text="Hội thảo AI &amp; Tương lai 2026" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_clock"
                    app:tint="@color/ds_text_muted" />

                <TextView
                    android:id="@+id/tvRecEventTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_4"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    tools:text="05/11/2026 • 09:00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_location"
                    app:tint="@color/ds_text_muted" />

                <TextView
                    android:id="@+id/tvRecEventLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_4"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    tools:text="Trực tuyến" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.eventapp.app.ui.common.view.PriceTextView
                    android:id="@+id/tvRecEventPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Miễn phí" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecOpen"
                    style="@style/Widget.EventApp.Ds.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/hc_rec_detail" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRecReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_8"
                android:background="@drawable/bg_ds_card_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_8"
                android:paddingTop="@dimen/ds_space_6"
                android:paddingEnd="@dimen/ds_space_4"
                android:paddingBottom="@dimen/ds_space_6">

                <ImageView
                    android:layout_width="@dimen/ds_icon_16"
                    android:layout_height="@dimen/ds_icon_16"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_ai_sparkle"
                    app:tint="@color/ds_secondary" />

                <TextView
                    android:id="@+id/tvRecReason"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_6"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    tools:text="Bạn thường nghe indie và đã lưu 3 sự kiện tương tự." />

                <ImageButton
                    android:id="@+id/btnRecNotInterested"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hc_rec_not_interested"
                    android:padding="@dimen/ds_space_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ds_close"
                    app:tint="@color/ds_text_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
