<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auth_top_bar">

    <ImageButton
        android:id="@+id/btnBack"
        style="@style/Widget.EventApp.Auth.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="start|center_vertical"
        android:contentDescription="@string/auth_cd_back"
        android:src="@drawable/ic_auth_back"
        android:tint="@color/auth_text" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/auth_cd_logo"
            android:src="@drawable/ic_auth_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/auth_brand_wordmark"
            android:textAppearance="@style/TextAppearance.EventApp.Auth.Brand" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTopChip"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/bg_auth_chip"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:minWidth="44dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/auth_mint"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
