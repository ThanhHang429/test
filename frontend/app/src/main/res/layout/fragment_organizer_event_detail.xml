<?xml version="1.0" encoding="utf-8"?>
<!-- FR-O04 + FR-O27: chi tiết sự kiện phía Organizer; O27 nằm ở tab "Phân tích". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_space_16">

        <ImageButton
            android:id="@+id/btnOedBack"
            android:layout_width="@dimen/ds_touch_target"
            android:layout_height="@dimen/ds_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hc_oed_back"
            android:padding="@dimen/ds_space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ds_back"
            app:tint="@color/ds_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                tools:text="Đêm nhạc Indie Sài Gòn 2026" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_oed_title"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabsOed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_content_margin"
        android:layout_marginTop="@dimen/ds_space_8"
        android:layout_marginEnd="@dimen/ds_content_margin"
        android:background="@color/ds_surface"
        app:tabGravity="fill"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabMode="fixed"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="@color/ds_text_muted" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollOedOverview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/ds_space_24">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOedSummary"
                    style="@style/Widget.EventApp.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:layout_marginEnd="@dimen/ds_content_margin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_16">

                        <TextView
                            android:id="@+id/tvOedCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                            tools:text="Mã sự kiện #1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:orientation="horizontal">

                            <com.eventapp.app.ui.common.view.StatusChip
                                android:id="@+id/chipOedReview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Đã duyệt" />

                            <com.eventapp.app.ui.common.view.StatusChip
                                android:id="@+id/chipOedLifecycle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_8"
                                tools:text="Đang mở bán" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_16"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hc_oed_revenue"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                                <TextView
                                    android:id="@+id/tvOedRevenue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_2"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H2"
                                    tools:text="72.000.000 đ" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_16"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hc_oed_registrations"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                                <TextView
                                    android:id="@+id/tvOedRegistrations"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ds_space_2"
                                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H2"
                                    tools:text="412" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.eventapp.app.ui.common.view.SectionHeaderView
                    android:id="@+id/headerOedManage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_20" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_content_margin"
                    android:layout_marginTop="@dimen/ds_space_8"
                    android:layout_marginEnd="@dimen/ds_content_margin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/rowOedTickets"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ds_touch_target"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ds_space_16"
                            android:paddingEnd="@dimen/ds_space_16">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_ticket"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_12"
                                android:layout_weight="1"
                                android:text="@string/hc_oed_action_tickets"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_chevron_right"
                                app:tint="@color/ds_outline" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/ds_space_16"
                            android:layout_marginEnd="@dimen/ds_space_16"
                            android:background="@color/ds_outline_variant" />

                        <LinearLayout
                            android:id="@+id/rowOedAttendees"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ds_touch_target"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ds_space_16"
                            android:paddingEnd="@dimen/ds_space_16">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_users"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_12"
                                android:layout_weight="1"
                                android:text="@string/hc_oed_action_attendees"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_chevron_right"
                                app:tint="@color/ds_outline" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/ds_space_16"
                            android:layout_marginEnd="@dimen/ds_space_16"
                            android:background="@color/ds_outline_variant" />

                        <LinearLayout
                            android:id="@+id/rowOedOrders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ds_touch_target"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ds_space_16"
                            android:paddingEnd="@dimen/ds_space_16">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_payment"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_12"
                                android:layout_weight="1"
                                android:text="@string/hc_oed_action_orders"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_chevron_right"
                                app:tint="@color/ds_outline" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/ds_space_16"
                            android:layout_marginEnd="@dimen/ds_space_16"
                            android:background="@color/ds_outline_variant" />

                        <LinearLayout
                            android:id="@+id/rowOedCheckin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ds_touch_target"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ds_space_16"
                            android:paddingEnd="@dimen/ds_space_16">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_search"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_12"
                                android:layout_weight="1"
                                android:text="@string/hc_oed_action_checkin"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_chevron_right"
                                app:tint="@color/ds_outline" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/ds_space_16"
                            android:layout_marginEnd="@dimen/ds_space_16"
                            android:background="@color/ds_outline_variant" />

                        <LinearLayout
                            android:id="@+id/rowOedReport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ds_touch_target"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ds_space_16"
                            android:paddingEnd="@dimen/ds_space_16">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_chart"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_12"
                                android:layout_weight="1"
                                android:text="@string/hc_oed_action_report"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_chevron_right"
                                app:tint="@color/ds_outline" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/ds_space_16"
                            android:layout_marginEnd="@dimen/ds_space_16"
                            android:background="@color/ds_outline_variant" />

                        <LinearLayout
                            android:id="@+id/rowOedHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ds_touch_target"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ds_space_16"
                            android:paddingEnd="@dimen/ds_space_16">

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_clock"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_12"
                                android:layout_weight="1"
                                android:text="@string/hc_oed_action_history"
                                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />

                            <ImageView
                                android:layout_width="@dimen/ds_icon_20"
                                android:layout_height="@dimen/ds_icon_20"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ds_chevron_right"
                                app:tint="@color/ds_outline" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/containerOedAnalysis"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
