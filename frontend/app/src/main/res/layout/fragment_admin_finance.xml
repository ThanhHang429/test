<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/admin_gutter"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/admin_gutter">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.14"
                android:text="PHÍ NỀN TẢNG"
                android:textColor="@color/admin_accent_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/admin_fin_title"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/admin_fin_sub"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.Body" />
        </LinearLayout>

        <!-- Phí nền tảng -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:background="@drawable/bg_admin_hero"
            android:clipToOutline="true"
            android:elevation="2dp"
            android:outlineProvider="background">

            <View
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-70dp"
                android:layout_marginEnd="-50dp"
                android:background="@drawable/bg_admin_hero_glow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFeeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.12"
                        android:text="PHÍ NỀN TẢNG TOÀN HỆ THỐNG"
                        android:textColor="#FF8FD9DC"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFeePeriodPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_admin_pill_glass"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.06"
                        android:paddingStart="9dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4dp"
                        android:text="ĐỐI SOÁT THỰC"
                        android:textColor="@color/admin_text_on_dark_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFeeValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="0 đ"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.MetricDark" />

                <TextView
                    android:id="@+id/tvFeeMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="Đang tải báo cáo tài chính..."
                    android:textColor="@color/admin_text_on_dark_muted"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/admin_hero_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="0.08"
                            android:text="@string/admin_fin_collected"
                            android:textColor="#FF8FA3BA"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCollectedValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="0 đ"
                            android:textColor="@color/admin_text_on_dark"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/admin_hero_line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="0.08"
                            android:text="@string/admin_fin_outstanding"
                            android:textColor="#FF8FA3BA"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOutstandingValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:text="0 đ"
                            android:textColor="@color/admin_text_on_dark"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Cấu hình phí -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="@dimen/admin_section_gap"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:background="@drawable/bg_admin_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_fin_fee_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

                <TextView
                    android:id="@+id/btnEditFee"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_admin_pill_neutral"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Chỉnh sửa"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/admin_fin_fee_platform"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvPlatformFeeRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="—"
                    android:textColor="@color/admin_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ds_chevron_right"
                    android:tint="@color/admin_text_faint" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/admin_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/admin_fin_fee_cycle"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvFeeCycleValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="—"
                    android:textColor="@color/admin_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/admin_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/admin_fin_fee_method"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvFeeMethodValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Khấu trừ tự động theo đơn"
                    android:textColor="@color/admin_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Doanh thu ghi nhận (chỉ đọc) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="@dimen/admin_section_gap"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:background="@drawable/bg_admin_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_fin_gmv_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_admin_pill_neutral"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="0.06"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="CHỈ ĐỌC"
                    android:textColor="@color/admin_neutral_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGmvValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="0 đ"
                android:textColor="@color/admin_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Tổng giá trị đơn hàng đã thanh toán ghi nhận trên hệ thống."
                android:textColor="@color/admin_text_dim"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/admin_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.06"
                        android:text="@string/admin_fin_gmv_events"
                        android:textColor="@color/admin_text_faint"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGmvEventsValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="0"
                        android:textColor="@color/admin_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.06"
                        android:text="@string/admin_fin_gmv_orgs"
                        android:textColor="@color/admin_text_faint"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGmvOrgsValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="0"
                        android:textColor="@color/admin_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Đối soát phí -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="@dimen/admin_section_gap"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:background="@drawable/bg_admin_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_fin_recon_title"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

            <LinearLayout
                android:id="@+id/reconContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvReconEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Chưa có dữ liệu đối soát từ nhà tổ chức."
                android:textColor="@color/admin_text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Quản lý và xử lý hoàn tiền (FR-A12) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="@dimen/admin_section_gap"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:background="@drawable/bg_admin_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xử lý hoàn tiền (FR-A12)"
                    android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

                <TextView
                    android:id="@+id/btnOpenRefunds"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_admin_pill_neutral"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:minWidth="104dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Xem yêu cầu"
                    android:textColor="@color/admin_accent_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Kiểm tra lý do, duyệt hoàn tiền vào Ví ETicket hoặc từ chối theo chính sách."
                android:textColor="@color/admin_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tra cứu hoá đơn -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_gutter"
            android:layout_marginTop="@dimen/admin_section_gap"
            android:layout_marginEnd="@dimen/admin_gutter"
            android:background="@drawable/bg_admin_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_fin_lookup_title"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_admin_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_user_search"
                    android:tint="@color/admin_text_dim" />

                <EditText
                    android:id="@+id/etFinanceLookup"
                    style="@style/Widget.EventApp.Admin.Search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:hint="@string/admin_fin_lookup_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_admin_dot" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/admin_fin_webhook"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvWebhookStatusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Đang kiểm tra..."
                    android:textColor="@color/admin_success_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnViewWebhooks"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_admin_pill_neutral"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:text="Xem nhật ký Webhook (FR-A11)"
                android:textColor="@color/admin_accent_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:lineSpacingExtra="1dp"
                android:text="Số liệu thống kê trực tiếp từ giao dịch thanh toán, hoàn tiền về Ví ETicket và nhật ký Webhook."
                android:textColor="@color/admin_text_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
