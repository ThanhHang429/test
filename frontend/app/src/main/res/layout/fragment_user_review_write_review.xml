<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_top_bar_height"
            android:background="@color/ds_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ds_space_4"
            android:paddingEnd="@dimen/ds_space_16">

            <ImageButton
                android:id="@+id/btnWriteBack"
                android:layout_width="@dimen/ds_touch_target"
                android:layout_height="@dimen/ds_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/hc_reviews_back"
                android:padding="@dimen/ds_space_12"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ds_back"
                app:tint="@color/ds_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_4"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWriteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_write_title"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                <TextView
                    android:id="@+id/tvWriteSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hc_write_subtitle"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollWrite"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_content_margin">

                <TextView
                    android:id="@+id/cardWriteEligibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_space_12"
                    android:background="@drawable/bg_ds_error_soft"
                    android:padding="@dimen/ds_space_12"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                    android:textColor="@color/ds_danger_dark"
                    android:visibility="gone"
                    tools:text="Bạn chưa check-in tại sự kiện này nên chưa thể đánh giá."
                    tools:visibility="visible" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_16">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_write_event"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.LabelSmall"
                            android:textColor="@color/ds_primary" />

                        <TextView
                            android:id="@+id/tvWriteEventTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                            tools:text="Đêm nhạc Indie Sài Gòn 2026" />

                        <TextView
                            android:id="@+id/tvWriteEventTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                            tools:text="25/10/2026 • 19:30" />

                        <com.eventapp.app.ui.common.view.StatusChip
                            android:id="@+id/chipWriteStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            tools:text="Có thể đánh giá" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_16">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_write_stars_label"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/hc_write_stars_hint"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                        <com.eventapp.app.ui.common.view.StarRatingView
                            android:id="@+id/ratingWriteStars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/ds_space_16"
                            android:layout_marginBottom="@dimen/ds_space_8" />

                        <TextView
                            android:id="@+id/tvWriteRatingLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
                            android:textColor="@color/ds_primary"
                            tools:text="5 sao • Tuyệt vời" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.Ds.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_16">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hc_write_comment_label"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilWriteComment"
                            style="@style/Widget.EventApp.Ds.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_12"
                            android:hint="@string/hc_write_comment_hint"
                            app:counterEnabled="true"
                            app:counterMaxLength="1000">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etWriteComment"
                                android:layout_width="match_parent"
                                android:layout_height="140dp"
                                android:gravity="top|start"
                                android:inputType="textCapSentences|textMultiLine"
                                android:maxLength="1000"
                                android:paddingTop="@dimen/ds_space_12"
                                android:scrollbars="vertical" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:text="@string/hc_write_anonymous_note"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

                        <TextView
                            android:id="@+id/tvWriteError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_8"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                            android:textColor="@color/ds_danger"
                            android:visibility="gone"
                            tools:text="Vui lòng chọn số sao"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvWriteEditNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:text="@string/hc_write_edit_note"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ds_bottom_bar"
            android:elevation="@dimen/ds_elevation_sheet"
            android:paddingStart="@dimen/ds_content_margin"
            android:paddingTop="@dimen/ds_space_12"
            android:paddingEnd="@dimen/ds_content_margin"
            android:paddingBottom="@dimen/ds_space_12">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWriteSubmit"
                style="@style/Widget.EventApp.Ds.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hc_write_submit" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
