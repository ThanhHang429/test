<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reviewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_admin_surface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/reviewTopBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/admin_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="@dimen/admin_gutter">

        <FrameLayout
            android:id="@+id/btnReviewBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_admin_circle_button"
            android:clickable="true"
            android:contentDescription="@string/admin_cd_back"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_auth_back"
                android:tint="@color/admin_text" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="@string/admin_review_title"
            android:textColor="@color/admin_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_pill_neutral"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.06"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:text="#RV-8842"
            android:textColor="@color/admin_text_muted"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <!-- Tóm tắt hồ sơ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_hero"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:outlineProvider="background">

                <View
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-70dp"
                    android:layout_marginEnd="-50dp"
                    android:background="@drawable/bg_admin_hero_glow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_admin_pill_glass"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.08"
                        android:paddingStart="9dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4dp"
                        android:text="@string/admin_review_priority"
                        android:textColor="#FFF0B44C"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/admin_review_event"
                        android:textColor="@color/admin_text_on_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/admin_review_org"
                        android:textColor="@color/admin_text_on_dark_muted"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_admin_glass_card"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:letterSpacing="0.08"
                                android:text="@string/admin_review_time"
                                android:textColor="#FF8FA3BA"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="@string/admin_review_time_value"
                                android:textColor="@color/admin_text_on_dark"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_admin_glass_card"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:letterSpacing="0.08"
                                android:text="@string/admin_review_place"
                                android:textColor="#FF8FA3BA"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:maxLines="1"
                                android:text="@string/admin_review_place_value"
                                android:textColor="@color/admin_text_on_dark"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_admin_glass_card"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:letterSpacing="0.08"
                                android:text="@string/admin_review_capacity"
                                android:textColor="#FF8FA3BA"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="@string/admin_review_capacity_value"
                                android:textColor="@color/admin_text_on_dark"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_admin_glass_card"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:letterSpacing="0.08"
                                android:text="@string/admin_review_price"
                                android:textColor="#FF8FA3BA"
                                android:textSize="8sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="@string/admin_review_price_value"
                                android:textColor="@color/admin_text_on_dark"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Hồ sơ pháp lý -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:text="@string/admin_review_legal"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_org_check_circle"
                        android:tint="@color/admin_success" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/admin_review_legal_1"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/admin_review_legal_1_state"
                        android:textColor="@color/admin_success_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/admin_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_org_check_circle"
                        android:tint="@color/admin_success" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/admin_review_legal_2"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/admin_review_legal_2_state"
                        android:textColor="@color/admin_success_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/admin_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_org_check_circle"
                        android:tint="@color/admin_success" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/admin_review_legal_3"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/admin_review_legal_3_state"
                        android:textColor="@color/admin_success_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/admin_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ds_warning"
                        android:tint="@color/admin_warning" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/admin_review_legal_4"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/admin_review_legal_4_state"
                        android:textColor="@color/admin_warning_text"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tín hiệu rủi ro -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:text="@string/admin_review_risk"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:background="@drawable/bg_admin_alert_box"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ds_warning"
                        android:tint="@color/admin_warning" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/admin_review_risk_1"
                        android:textColor="@color/admin_warning_text"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="1dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ds_warning"
                        android:tint="@color/admin_warning" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/admin_review_risk_2"
                        android:textColor="@color/admin_warning_text"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ghi chú -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:text="@string/admin_review_note"
                android:textAppearance="@style/TextAppearance.EventApp.Admin.CardTitle" />

            <EditText
                android:id="@+id/etReviewNote"
                style="@style/Widget.EventApp.Admin.Input"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginStart="@dimen/admin_gutter"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/admin_gutter"
                android:gravity="top|start"
                android:hint="@string/admin_review_note_hint"
                android:inputType="textMultiLine"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/reviewBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_admin_bottom_bar"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/admin_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/admin_gutter"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnReviewRejectDetail"
            android:layout_width="0dp"
            android:layout_height="@dimen/admin_control_height"
            android:layout_weight="1"
            android:background="@drawable/bg_admin_btn_danger"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:text="@string/admin_mod_reject"
            android:textColor="@color/admin_danger_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnReviewApproveDetail"
            android:layout_width="0dp"
            android:layout_height="@dimen/admin_control_height"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_admin_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:text="@string/admin_mod_approve"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
