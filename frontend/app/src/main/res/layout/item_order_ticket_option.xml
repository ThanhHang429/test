<?xml version="1.0" encoding="utf-8"?>
<!-- Một loại vé có thể chọn ở màn thanh toán. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardOrderTicket"
    style="@style/Widget.EventApp.Ds.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_card_gap"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/order_ticket_card_bg"
    app:checkedIcon="@null"
    app:rippleColor="@color/ds_primary_soft"
    app:strokeColor="@color/order_ticket_card_stroke"
    app:strokeWidth="@dimen/ds_stroke_emphasis">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:padding="@dimen/ds_space_16">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioOrderTicket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/ds_primary"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOrderTicketName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                tools:text="Vé Standard" />

            <TextView
                android:id="@+id/tvOrderTicketDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                tools:text="Quyền tham dự toàn bộ chương trình." />

            <TextView
                android:id="@+id/tvOrderTicketRemaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_6"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                android:textColor="@color/ds_warning_dark"
                tools:text="Còn 48 vé" />
        </LinearLayout>

        <com.eventapp.app.ui.common.view.PriceTextView
            android:id="@+id/tvOrderTicketPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            tools:text="350.000 đ" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
