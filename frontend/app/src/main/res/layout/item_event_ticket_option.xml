<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.EventApp.Ds.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_card_gap"
    android:clickable="true"
    android:focusable="true"
    android:checkable="true"
    app:cardCornerRadius="@dimen/ds_radius_16"
    app:checkedIcon="@null"
    app:rippleColor="@color/ds_primary_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ds_space_16">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioDetailTicket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/ds_primary"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailTicketName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                tools:text="Vé Standard" />

            <TextView
                android:id="@+id/tvDetailTicketDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                android:visibility="gone"
                tools:text="Bao gồm khu vực đứng và nước uống."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvDetailTicketSaleWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                tools:text="Bán từ 01/10 đến 20/10" />

            <TextView
                android:id="@+id/tvDetailTicketRemaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                android:textColor="@color/ds_warning_dark"
                tools:text="Còn ít vé" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailTicketPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Price"
                tools:text="350.000 đ" />

            <com.eventapp.app.ui.common.view.StatusChip
                android:id="@+id/chipDetailTicketStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_4"
                tools:text="Đang mở bán" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
