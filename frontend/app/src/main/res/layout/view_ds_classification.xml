<?xml version="1.0" encoding="utf-8"?>
<!-- O09: chọn danh mục chính/phụ và nhãn phụ trong EventForm -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/tvO09Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hc_o09_title"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

    <TextView
        android:id="@+id/tvO09Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2"
        android:text="@string/hc_o09_subtitle"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

    <!-- Primary category -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_20"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hc_o09_primary"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_6"
            android:background="@drawable/bg_ds_tag"
            android:paddingStart="@dimen/ds_space_6"
            android:paddingTop="1dp"
            android:paddingEnd="@dimen/ds_space_6"
            android:paddingBottom="1dp"
            android:text="@string/hc_o09_required"
            android:textColor="@color/ds_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/hc_o09_primary_hint"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupO09Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_8"
        app:chipSpacingHorizontal="@dimen/ds_space_8"
        app:chipSpacingVertical="@dimen/ds_space_4"
        app:selectionRequired="true"
        app:singleLine="false"
        app:singleSelection="true" />

    <TextView
        android:id="@+id/tvO09PrimaryError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_4"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
        android:textColor="@color/ds_danger"
        android:visibility="gone"
        tools:text="Vui lòng chọn danh mục chính"
        tools:visibility="visible" />

    <!-- Secondary categories -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_20"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hc_o09_secondary"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_6"
            android:layout_weight="1"
            android:text="@string/hc_o09_optional"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

        <TextView
            android:id="@+id/tvO09SecondaryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
            android:textColor="@color/ds_text_muted"
            tools:text="0/2" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_2"
        android:text="@string/hc_o09_secondary_hint"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupO09Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_8"
        app:chipSpacingHorizontal="@dimen/ds_space_8"
        app:chipSpacingVertical="@dimen/ds_space_4"
        app:singleLine="false"
        app:singleSelection="false" />

    <TextView
        android:id="@+id/tvO09SecondaryError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_4"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
        android:textColor="@color/ds_danger"
        android:visibility="gone"
        tools:text="Chỉ chọn tối đa 2 danh mục phụ"
        tools:visibility="gone" />

    <!-- Tags -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_20"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hc_o09_tags"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_6"
            android:layout_weight="1"
            android:text="@string/hc_o09_optional"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

        <TextView
            android:id="@+id/tvO09TagCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
            android:textColor="@color/ds_text_muted"
            tools:text="0/5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilO09Tag"
            style="@style/Widget.EventApp.Ds.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hc_o09_tags_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etO09Tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLength="30"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnO09AddTag"
            style="@style/Widget.EventApp.Ds.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_8"
            android:minWidth="0dp"
            android:text="@string/hc_o09_tag_add"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvO09TagsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_8"
        android:text="@string/hc_o09_tag_empty"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupO09Tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_4"
        app:chipSpacingHorizontal="@dimen/ds_space_8"
        app:chipSpacingVertical="@dimen/ds_space_4"
        app:singleLine="false"
        app:singleSelection="false" />

    <!-- Suggestions -->
    <TextView
        android:id="@+id/tvO09SuggestionsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_16"
        android:text="@string/hc_o09_tag_suggestions"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Label"
        android:textColor="@color/ds_text_muted" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupO09Suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_4"
        app:chipSpacingHorizontal="@dimen/ds_space_8"
        app:chipSpacingVertical="@dimen/ds_space_4"
        app:singleLine="false"
        app:singleSelection="false" />
</merge>
