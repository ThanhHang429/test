<?xml version="1.0" encoding="utf-8"?>
<!-- FR-O06/O09/O27: hub cho trợ lý AI + chọn sự kiện để phân tích. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_content_margin"
        android:paddingTop="@dimen/ds_space_20"
        android:paddingEnd="@dimen/ds_content_margin"
        android:paddingBottom="@dimen/ds_nav_bottom_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/org_tools_title"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.H2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_4"
            android:text="@string/org_tools_subtitle"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

        <!-- Hero AI -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EventApp.Ds.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_20"
            app:cardBackgroundColor="@color/ds_organizer_soft"
            app:cardCornerRadius="@dimen/ds_radius_20"
            app:strokeColor="@color/ds_organizer_bright">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ds_circle_primary">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_ai_sparkle"
                            app:tint="@color/ds_white" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/org_tools_ai_write_title"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:text="@string/org_tools_ai_section"
                            android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                            android:textColor="@color/ds_organizer_dark" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_12"
                    android:text="@string/org_tools_ai_write_desc"
                    android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
                    android:textColor="@color/ds_organizer_dark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolsAiDescription"
                    style="@style/Widget.EventApp.Ds.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_16"
                    android:backgroundTint="@color/ds_organizer"
                    android:text="@string/org_tools_ai_write_action"
                    app:icon="@drawable/ic_ds_ai_sparkle"
                    app:iconGravity="textStart"
                    app:iconTint="@color/ds_white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Events -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_24"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/org_tools_events_section"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:text="@string/org_tools_events_desc"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_16"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/ds_organizer"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvToolsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_16"
            android:background="@drawable/bg_ds_error_soft"
            android:padding="@dimen/ds_space_16"
            android:text="@string/org_tools_error"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
            android:textColor="@color/ds_danger_dark"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToolsRetry"
            style="@style/Widget.EventApp.Ds.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_8"
            android:text="@string/org_tools_retry"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvToolsEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_12"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_org_tool_event" />

        <TextView
            android:id="@+id/tvToolsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_16"
            android:background="@drawable/bg_ds_card_soft"
            android:gravity="center"
            android:padding="@dimen/ds_space_20"
            android:text="@string/org_tools_events_empty"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.BodyM"
            android:textColor="@color/ds_text_muted"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
