<?xml version="1.0" encoding="utf-8"?>
<!-- Sheet tài khoản dùng chung cho cả 3 host: xem phiên hiện tại và đăng xuất. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ds_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/ds_space_20"
    android:paddingTop="@dimen/ds_space_12"
    android:paddingEnd="@dimen/ds_space_20"
    android:paddingBottom="@dimen/ds_space_24">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/ds_space_20"
        android:background="@color/ds_outline_variant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/ds_avatar_lg"
            android:layout_height="@dimen/ds_avatar_lg"
            android:background="@drawable/bg_ds_avatar">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile"
                app:tint="@color/ds_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAccountName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.H3"
                tools:text="Nguyễn Văn An" />

            <TextView
                android:id="@+id/tvAccountEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_2"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption"
                tools:text="user1@eticket.local" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupAccountRoles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_12"
        app:chipSpacingHorizontal="@dimen/ds_space_6"
        app:singleLine="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/ds_space_16"
        android:layout_marginBottom="@dimen/ds_space_8"
        android:background="@color/ds_outline_variant" />

    <LinearLayout
        android:id="@+id/rowAccountMyReviews"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_space_4">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ds_star"
            app:tint="@color/ds_warning_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_12"
            android:layout_weight="1"
            android:text="@string/account_my_reviews"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Body" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ds_chevron_right"
            app:tint="@color/ds_text_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowAccountLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_4"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_space_4">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ds_logout"
            app:tint="@color/ds_danger" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_12"
            android:layout_weight="1"
            android:text="@string/account_logout"
            android:textAppearance="@style/TextAppearance.EventApp.Ds.Body"
            android:textColor="@color/ds_danger" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_12"
        android:gravity="center"
        android:text="@string/account_memory_only"
        android:textAppearance="@style/TextAppearance.EventApp.Ds.Caption" />

</LinearLayout>
