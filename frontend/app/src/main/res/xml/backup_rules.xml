<?xml version="1.0" encoding="utf-8"?>
<!-- Không backup dữ liệu phiên/token xuống cloud backup.
     Token đăng nhập và dữ liệu cache phải nằm trên thiết bị. -->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="database"
        path="." />
</full-backup-content>
