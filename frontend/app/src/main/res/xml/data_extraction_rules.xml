<?xml version="1.0" encoding="utf-8"?>
<!-- Quy tắc trích xuất dữ liệu (Android 12+): không sao chép token/cache. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="database"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="database"
            path="." />
    </device-transfer>
</data-extraction-rules>
