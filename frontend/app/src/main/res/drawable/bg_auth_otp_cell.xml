<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F2F5BFF" />
            <corners android:radius="@dimen/auth_radius_otp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/auth_stroke_focus" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/auth_glass_strong" />
            <corners android:radius="@dimen/auth_radius_otp" />
            <stroke
                android:width="1dp"
                android:color="#664F6BFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/auth_glass" />
            <corners android:radius="@dimen/auth_radius_otp" />
            <stroke
                android:width="1dp"
                android:color="@color/auth_stroke" />
        </shape>
    </item>
</selector>
