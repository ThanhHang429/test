<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/user_indigo"
                android:startColor="@color/user_primary" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/user_surface" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="@color/user_border" />
        </shape>
    </item>
</selector>
