<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/user_primary_soft" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/user_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/user_surface" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/user_border_strong" />
        </shape>
    </item>
</selector>
