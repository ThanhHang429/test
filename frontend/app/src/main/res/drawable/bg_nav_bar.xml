<?xml version="1.0" encoding="utf-8"?>
<!-- Nền thanh điều hướng nổi: trắng đục hoàn toàn, bo 28dp đều 4 góc.
     Dùng layer-list để xếp shadow phía sau + thân trắng phía trước.
     Quan trọng: solid color phải khai báo alpha FF để nội dung scroll không xuyên qua. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lớp shadow: oval mờ, offset xuống 4dp, blur mô phỏng bằng padding -->
    <item
        android:bottom="0dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="@dimen/ds_radius_28" />
        </shape>
    </item>

    <!-- Thân trắng đục: phủ lên lớp shadow, không có alpha -->
    <item
        android:bottom="4dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/ds_radius_28" />
            <stroke
                android:width="@dimen/ds_stroke"
                android:color="@color/ds_outline_variant" />
        </shape>
    </item>

</layer-list>
