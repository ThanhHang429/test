<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A2F5BFF" />
            <corners android:radius="@dimen/auth_radius_input" />
            <stroke
                android:width="1dp"
                android:color="@color/auth_stroke_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/auth_glass" />
            <corners android:radius="@dimen/auth_radius_input" />
            <stroke
                android:width="1dp"
                android:color="@color/auth_stroke" />
        </shape>
    </item>
</selector>
