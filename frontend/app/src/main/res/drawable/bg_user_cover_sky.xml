<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FF1D4ED8"
                android:startColor="#FF38BDF8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:gravity="top|right"
        android:right="10dp"
        android:top="8dp">
        <shape android:shape="oval">
            <size
                android:width="88dp"
                android:height="88dp" />
            <solid android:color="#24FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="10dp"
        android:gravity="bottom|left"
        android:left="14dp">
        <shape android:shape="oval">
            <size
                android:width="50dp"
                android:height="50dp" />
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
