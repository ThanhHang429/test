<?xml version="1.0" encoding="utf-8"?>
<!-- Lớp gradient che khe hở giữa nav bar nổi và đáy màn hình.
     Đặt sát đáy, z-order THẤP hơn nav_bar_container (elevation 0).
     Màu đáy khớp với ds_bg (#FAF8FF) của màn home. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/ds_transparent"
        android:startColor="@color/ds_bg"
        android:type="linear" />
</shape>
