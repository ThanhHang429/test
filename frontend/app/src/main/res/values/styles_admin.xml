<?xml version="1.0" encoding="utf-8"?>
<!-- Typography & widget khu Quản trị (Stitch "Authoritative Operations Console"). -->
<resources>

    <!-- ===== Typography ===== -->
    <style name="TextAppearance.EventApp.Admin.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Admin.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Admin.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Admin.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Admin.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/admin_text_muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.EventApp.Admin.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/admin_text_dim</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Admin.Micro" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/admin_text_dim</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Admin.Kicker" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/admin_accent_dark</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Admin.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Admin.Metric" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Admin.MetricDark" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/admin_text_on_dark</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== Button ===== -->
    <style name="Widget.EventApp.Admin.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/admin_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Admin.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/admin_touch</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="cornerRadius">@dimen/admin_radius_control</item>
        <item name="rippleColor">@color/admin_white_20</item>
    </style>

    <style name="Widget.EventApp.Admin.Button.Secondary" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@color/admin_primary_soft</item>
        <item name="android:textColor">@color/admin_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Admin.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/admin_touch</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">@dimen/admin_radius_control</item>
        <item name="strokeColor">@color/admin_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.EventApp.Admin.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@color/admin_danger_soft</item>
        <item name="android:textColor">@color/admin_danger_text</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Admin.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/admin_touch</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">@dimen/admin_radius_control</item>
        <item name="strokeColor">@color/admin_danger</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.EventApp.Admin.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/admin_text_muted</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Admin.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/admin_touch</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/admin_radius_control</item>
    </style>

    <!-- ===== Filter chip ===== -->
    <style name="Widget.EventApp.Admin.FilterChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_admin_chip_selector</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/admin_chip_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Input ===== -->
    <style name="Widget.EventApp.Admin.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_admin_input</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:textColorHint">@color/admin_text_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.EventApp.Admin.Search" parent="Widget.AppCompat.EditText">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:textColorHint">@color/admin_text_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
