<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Ứng dụng chỉ hỗ trợ giao diện sáng (ETicket light-only). -->
    <!-- Khu Nhà tổ chức dùng tông teal theo mockup Stitch organizer: chỉ đổi các attr màu,
         không đổi cấu trúc theme, để các component dùng ?attr/colorPrimary tự chuyển màu. -->
    <style name="ThemeOverlay.EventApp.Organizer" parent="">
        <item name="colorPrimary">@color/org_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/org_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/org_primary_deep</item>
        <item name="colorSecondary">@color/org_primary_container</item>
        <item name="colorControlActivated">@color/org_primary</item>
    </style>

    <!-- Theme riêng cho khu Nhà tổ chức: nền mint sáng, primary xanh eucalyptus. -->
    <style name="Theme.EventApp.Organizer" parent="Theme.EventApp">
        <item name="colorPrimary">@color/org_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/org_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/org_primary_deep</item>
        <item name="colorSecondary">@color/org_primary_container</item>
        <item name="colorSurface">@color/org_surface</item>
        <item name="colorOnSurface">@color/org_text</item>
        <item name="colorSurfaceContainer">@color/org_surface</item>
        <item name="colorSurfaceContainerLow">@color/org_surface_alt</item>
        <item name="colorSurfaceContainerHigh">@color/org_surface</item>
        <item name="colorSurfaceContainerHighest">@color/org_surface_mint</item>
        <item name="colorOnSurfaceVariant">@color/org_text_muted</item>
        <item name="colorOutline">@color/org_border_strong</item>
        <item name="colorControlActivated">@color/org_primary</item>
        <item name="android:windowBackground">@color/org_canvas</item>
        <item name="android:statusBarColor">@color/org_canvas</item>
        <item name="android:navigationBarColor">@color/org_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Theme riêng cho khu Quản trị: nền slate lạnh, primary navy mực. -->
    <style name="Theme.EventApp.Admin" parent="Theme.EventApp">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/admin_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/admin_primary_dark</item>
        <item name="colorSecondary">@color/admin_accent</item>
        <item name="colorSurface">@color/admin_surface</item>
        <item name="colorOnSurface">@color/admin_text</item>
        <item name="colorSurfaceContainer">@color/admin_surface</item>
        <item name="colorSurfaceContainerLow">@color/admin_surface_alt</item>
        <item name="colorSurfaceContainerHigh">@color/admin_surface</item>
        <item name="colorSurfaceContainerHighest">@color/admin_surface_slate</item>
        <item name="colorOnSurfaceVariant">@color/admin_text_muted</item>
        <item name="colorOutline">@color/admin_border_strong</item>
        <item name="colorControlActivated">@color/admin_primary</item>
        <item name="android:windowBackground">@color/admin_canvas</item>
        <item name="android:statusBarColor">@color/admin_canvas</item>
        <item name="android:navigationBarColor">@color/admin_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.EventApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_text_primary</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <!-- targetSdk 37: Android 15+ vẽ edge-to-edge, statusBarColor bị bỏ qua.
             Nền app là màu sáng nên icon status bar phải là màu tối, nếu không sẽ vô hình. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Màn hình khởi động | FR-U01 -->
    <style name="Theme.EventApp.Splash" parent="Theme.EventApp">
        <item name="android:windowBackground">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <!-- Nền splash màu đậm → icon status bar màu sáng -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Luồng xác thực: dark navy + glass. Chỉ áp cho AuthActivity, không đổi theme sáng toàn app. -->
    <style name="Theme.EventApp.Auth" parent="Theme.EventApp">
        <item name="android:windowBackground">@color/auth_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimary">@color/auth_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/auth_mint</item>
        <item name="colorSurface">@color/auth_bg</item>
        <item name="colorOnSurface">@color/auth_text</item>
        <item name="colorOutline">@color/auth_stroke_strong</item>
        <item name="colorControlActivated">@color/auth_mint</item>
    </style>

    <style name="Theme.EventApp.Dialog" parent="Theme.Material3.Light.Dialog.Alert" />

    <style name="Widget.EventApp.Toolbar" parent="Widget.Material3.Toolbar.Surface" />

</resources>
