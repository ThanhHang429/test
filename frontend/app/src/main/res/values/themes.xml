<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Ứng dụng chỉ hỗ trợ giao diện sáng (ETicket light-only). -->
    <!-- Khu Nhà tổ chức dùng tông teal theo mockup Stitch organizer: chỉ đổi các attr màu,
         không đổi cấu trúc theme, để các component dùng ?attr/colorPrimary tự chuyển màu. -->
    <style name="ThemeOverlay.EventApp.Organizer" parent="">
        <item name="colorPrimary">@color/ds_organizer</item>
        <item name="colorOnPrimary">@color/ds_white</item>
        <item name="colorPrimaryContainer">@color/ds_organizer_container</item>
        <item name="colorOnPrimaryContainer">@color/ds_white</item>
        <item name="colorSecondary">@color/ds_organizer_container</item>
    </style>

    <style name="Theme.EventApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_text_primary</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <!-- targetSdk 37: Android 15+ vẽ edge-to-edge, statusBarColor bị bỏ qua.
             Nền app là màu sáng nên icon status bar phải là màu tối, nếu không sẽ vô hình. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Màn hình khởi động | FR-U01 -->
    <style name="Theme.EventApp.Splash" parent="Theme.EventApp">
        <item name="android:windowBackground">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <!-- Nền splash màu đậm → icon status bar màu sáng -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Luồng xác thực: dark navy + glass. Chỉ áp cho AuthActivity, không đổi theme sáng toàn app. -->
    <style name="Theme.EventApp.Auth" parent="Theme.EventApp">
        <item name="android:windowBackground">@color/auth_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimary">@color/auth_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/auth_mint</item>
        <item name="colorSurface">@color/auth_bg</item>
        <item name="colorOnSurface">@color/auth_text</item>
        <item name="colorOutline">@color/auth_stroke_strong</item>
        <item name="colorControlActivated">@color/auth_mint</item>
    </style>

    <style name="Theme.EventApp.Dialog" parent="Theme.Material3.Light.Dialog.Alert" />

    <style name="Widget.EventApp.Toolbar" parent="Widget.Material3.Toolbar.Surface" />

</resources>
