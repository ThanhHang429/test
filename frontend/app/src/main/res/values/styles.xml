<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.EventApp.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.EventApp.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.EventApp.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textColor">@color/brand_text_primary</item>
    </style>

    <style name="TextAppearance.EventApp.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textColor">@color/brand_text_secondary</item>
    </style>

    <style name="TextAppearance.EventApp.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Design-system text & widget styles ===== -->
<!-- ===== Typography ===== -->
    <style name="TextAppearance.EventApp.Ds.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Ds.H1" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Ds.H2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Ds.H3" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Ds.BodyL" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.EventApp.Ds.BodyM" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.EventApp.Ds.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ds_text_muted</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.EventApp.Ds.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ds_text</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Ds.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ds_text_muted</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Ds.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ds_primary</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== Card ===== -->
    <!-- Thiết kế Stitch dùng card trắng + viền hairline, không đổ bóng màu (tránh tint tím của M3). -->
    <style name="Widget.EventApp.Ds.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ds_surface</item>
        <item name="cardCornerRadius">@dimen/ds_radius_16</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ds_outline_variant</item>
        <item name="strokeWidth">@dimen/ds_stroke</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <style name="Widget.EventApp.Ds.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ds_surface</item>
        <item name="cardCornerRadius">@dimen/ds_radius_16</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ds_outline_variant</item>
        <item name="strokeWidth">@dimen/ds_stroke</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <style name="Widget.EventApp.Ds.Card.Soft" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/ds_surface_alt</item>
        <item name="cardCornerRadius">@dimen/ds_radius_16</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <!-- ===== Button ===== -->
    <style name="Widget.EventApp.Ds.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ds_button_primary_tint</item>
        <item name="android:textColor">@color/ds_white</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Ds.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/ds_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="cornerRadius">@dimen/ds_radius_12</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.EventApp.Ds.Button.Cta" parent="Widget.EventApp.Ds.Button.Primary">
        <item name="backgroundTint">@color/ds_button_cta_tint</item>
    </style>

    <style name="Widget.EventApp.Ds.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/ds_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Ds.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/ds_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="cornerRadius">@dimen/ds_radius_12</item>
        <item name="strokeColor">@color/ds_outline_variant</item>
        <item name="strokeWidth">@dimen/ds_stroke</item>
        <item name="backgroundTint">@color/ds_surface</item>
    </style>

    <style name="Widget.EventApp.Ds.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/ds_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Ds.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/ds_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <!-- ===== Chip ===== -->
    <style name="Widget.EventApp.Ds.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/ds_chip_bg</item>
        <item name="android:textColor">@color/ds_chip_text</item>
        <item name="chipStrokeColor">@color/ds_chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/ds_stroke</item>
        <item name="chipCornerRadius">@dimen/ds_radius_pill</item>
        <item name="chipMinHeight">@dimen/ds_chip_height</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Ds.Label</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="Widget.EventApp.Ds.Chip.Preset" parent="Widget.EventApp.Ds.Chip.Filter">
        <item name="chipMinHeight">@dimen/ds_chip_height_small</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Chip lọc nhanh ở đầu trang Khám phá: pill, nền surface-container, chữ primary khi chọn. -->
    <style name="Widget.EventApp.Ds.Chip.Quick" parent="Widget.EventApp.Ds.Chip.Filter">
        <item name="chipBackgroundColor">@color/ds_quick_chip_bg</item>
        <item name="android:textColor">@color/ds_quick_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">34dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Chip danh mục: bo góc nhẹ, đảo màu đậm khi chọn theo thiết kế Stitch. -->
    <style name="Widget.EventApp.Ds.Chip.Category" parent="Widget.EventApp.Ds.Chip.Filter">
        <item name="chipBackgroundColor">@color/ds_category_chip_bg</item>
        <item name="android:textColor">@color/ds_category_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/ds_radius_12</item>
        <item name="chipMinHeight">34dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.EventApp.Ds.Chip.Tag" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/ds_primary_soft</item>
        <item name="android:textColor">@color/ds_primary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">@dimen/ds_chip_height_small</item>
        <item name="chipCornerRadius">@dimen/ds_radius_pill</item>
        <item name="closeIconVisible">true</item>
        <item name="closeIconTint">@color/ds_primary</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- ===== Text input ===== -->
    <style name="Widget.EventApp.Ds.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/ds_surface</item>
        <item name="boxStrokeColor">@color/ds_input_stroke</item>
        <item name="boxStrokeWidth">@dimen/ds_stroke</item>
        <item name="boxCornerRadiusTopStart">@dimen/ds_radius_12</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ds_radius_12</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ds_radius_12</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ds_radius_12</item>
        <item name="hintTextColor">@color/ds_text_muted</item>
        <item name="android:textColorHint">@color/ds_text_muted</item>
        <item name="errorTextColor">@color/ds_danger</item>
    </style>

    <!-- ===== Bottom navigation ===== -->
    <style name="Widget.EventApp.NavIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ds_primary</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="TextAppearance.EventApp.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/ds_outline</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.EventApp.NavLabel.Active" parent="TextAppearance.EventApp.NavLabel">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ds_primary</item>
    </style>

    <!-- ===== Toolbar ===== -->    <style name="Widget.EventApp.Ds.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">@color/ds_surface</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.EventApp.Ds.H3</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.EventApp.Ds.Caption</item>
    </style>

</resources>
