<?xml version="1.0" encoding="utf-8"?>
<!-- Typography & widget cho khu Nhà tổ chức (Stitch "Serene Operational Console"). -->
<resources>

    <!-- ===== Typography ===== -->
    <style name="TextAppearance.EventApp.Org.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textColor">@color/org_text</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Org.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/org_text</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Org.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/org_text</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Org.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/org_text</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Org.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/org_text_muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.EventApp.Org.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/org_text_dim</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Org.Micro" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/org_text_dim</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Org.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/org_text</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Org.KpiValue" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/org_text</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Org.KpiLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/org_text_dim</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.EventApp.Org.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/org_primary_dark</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== Card ===== -->
    <style name="Widget.EventApp.Org.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/org_surface</item>
        <item name="cardCornerRadius">@dimen/org_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/org_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <style name="Widget.EventApp.Org.Card.Soft" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/org_surface_alt</item>
        <item name="cardCornerRadius">@dimen/org_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <!-- ===== Button ===== -->
    <style name="Widget.EventApp.Org.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/org_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Org.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/org_touch</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="cornerRadius">@dimen/org_radius_control</item>
        <item name="rippleColor">@color/org_white_20</item>
    </style>

    <style name="Widget.EventApp.Org.Button.Secondary" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@color/org_primary_soft</item>
        <item name="android:textColor">@color/org_primary_dark</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Org.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/org_touch</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">@dimen/org_radius_control</item>
        <item name="strokeColor">@color/org_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.EventApp.Org.Button.Ghost" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/org_primary_dark</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Org.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/org_touch</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/org_radius_control</item>
    </style>

    <style name="Widget.EventApp.Org.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@color/org_danger_soft</item>
        <item name="android:textColor">@color/org_danger_text</item>
        <item name="android:textAppearance">@style/TextAppearance.EventApp.Org.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/org_touch</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/org_radius_control</item>
    </style>

    <!-- ===== Filter chip ===== -->
    <style name="Widget.EventApp.Org.FilterChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_org_chip_selector</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/org_chip_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Input ===== -->
    <style name="Widget.EventApp.Org.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_org_input</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textColor">@color/org_text</item>
        <item name="android:textColorHint">@color/org_text_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.EventApp.Org.Search" parent="Widget.AppCompat.EditText">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="android:textColor">@color/org_text</item>
        <item name="android:textColorHint">@color/org_text_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

</resources>
