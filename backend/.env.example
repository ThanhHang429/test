# Copy file này thành .env rồi điền giá trị thật.
# QUAN TRỌNG: lưu dưới dạng UTF-8 KHÔNG CÓ BOM.
#   Kiểm tra: head -c 3 .env | xxd -p   -> phải KHÔNG ra "efbbbf"
#   Xoá BOM:  sed -i '1s/^\xEF\xBB\xBF//' .env
# File này được nạp bởi spring.config.import trong application.yml (loader properties),
# nên giá trị KHÔNG bọc nháy kép và không chứa dấu # chưa escape.

DB_URL=jdbc:mysql://<DB_HOST>:<DB_PORT>/<DB_NAME>?useSSL=true&requireSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf-8
DB_USER=<DB_USERNAME>
DB_PASSWORD=<DB_PASSWORD>

JWT_SECRET=<generate: openssl rand -base64 48>
PAYMENT_WEBHOOK_SECRET=
FCM_CREDENTIALS_PATH=
AI_API_KEY=

# dev | prod
# Phải viết THƯỜNG là "spring.profiles.active".
# Viết hoa "SPRING_PROFILES_ACTIVE" sẽ KHÔNG có tác dụng trong file .env
# (chỉ biến môi trường thật của OS mới hiểu dạng viết hoa).
spring.profiles.active=dev
SERVER_PORT=8080

# Chỉ dùng cho profile test (application-test.yml). KHÔNG trỏ vào DB dùng chung.
TEST_DB_URL=
TEST_DB_USER=
TEST_DB_PASSWORD=
